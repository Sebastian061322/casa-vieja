});

/* Solo para el Apps Script independiente y la hoja sintética autorizados. */
const CV_TEST_SHEET_ID_ = '1CtK6KD995Pu2Fzc_na89Ajc0KQ0QLuGq3UFhj4UdLSA';
const CV_TEST_SCRIPT_ID_ = '1Dt2JbUp6BkGPdJLfngMR9ld-dVZUhSZykdlLCOsnLPngffKlrSuOxzfR';
const CV_TABS_ = ['DiarioV2','EfectosV2','AperturaV2','VerificacionesV2'];
function cvBook_(){
 if(ScriptApp.getScriptId()!==CV_TEST_SCRIPT_ID_)throw Error('WRONG_SCRIPT');
 const ss=SpreadsheetApp.openById(CV_TEST_SHEET_ID_);
 if(ss.getName()!=='CasaVieja_Pruebas_SINTETICA'||ss.getSheetByName('Control').getRange('B3').getValue()!=='TEST_ONLY')throw Error('WRONG_DESTINATION');
 return ss;
}
function cvOwner_(){
 const configured=PropertiesService.getScriptProperties().getProperty('SANDBOX_OWNER_EMAIL');
 const active=Session.getActiveUser().getEmail(),effective=Session.getEffectiveUser().getEmail();
 if(!configured||!active||active!==configured||effective!==configured)throw Error('OWNER_ONLY');
}
function cvLocked_(fn){const lock=LockService.getScriptLock();lock.waitLock(30000);try{return fn();}finally{lock.releaseLock();}}
function cvReadRows_(ss,name){if(CV_TABS_.indexOf(name)<0)throw Error('TAB_FORBIDDEN');const sh=ss.getSheetByName(name);if(!sh)throw Error('SETUP_REQUIRED');const n=sh.getLastRow();if(n<=1)return [];return sh.getRange(2,1,n-1,3).getValues().map(r=>JSON.parse(r[2]));}
function cvAppend_(ss,name,row){
 if(CV_TABS_.indexOf(name)<0)throw Error('TAB_FORBIDDEN');
 const raw=JSON.stringify(row);if(raw.length>40000)throw Error('RECORD_TOO_LARGE');
 ss.getSheetByName(name).appendRow([row.id||row.operationId||'opening',row.kind||'OPENING',raw]);SpreadsheetApp.flush();
}
function cvEngine_(){
 const ss=cvBook_();const rows=cvReadRows_(ss,'AperturaV2');if(rows.length!==1)throw Error('OPENING_REQUIRED');
 const store={readJournal:()=>cvReadRows_(ss,'DiarioV2'),readEffects:()=>cvReadRows_(ss,'EfectosV2'),appendJournal:r=>cvAppend_(ss,'DiarioV2',r),appendEffect:r=>cvAppend_(ss,'EfectosV2',r)};
 return new CVTransactions.Engine(store,rows[0]);
}
// Ejecutar manualmente en editor, una vez. Nunca accesible desde google.script.run.
function initializeSandbox_(){return cvLocked_(()=>{
 const active=Session.getActiveUser().getEmail(),effective=Session.getEffectiveUser().getEmail();if(!active||active!==effective)throw Error('OWNER_ONLY');
 const props=PropertiesService.getScriptProperties(),owner=props.getProperty('SANDBOX_OWNER_EMAIL');if(owner&&owner!==active)throw Error('OWNER_ONLY');
 const ss=cvBook_();
 for(const name of CV_TABS_){if(!ss.getSheetByName(name))ss.insertSheet(name).appendRow(['ID','Tipo','JSON']);}
 if(cvReadRows_(ss,'AperturaV2').length===0){
  const rows=ss.getSheetByName('RecursosDemo').getRange('A2:G3').getValues(),resources={};
  rows.forEach(r=>{resources[r[0]]={lot:r[1],family:r[2],grind:r[3],grams:r[4],qty:r[5],unitCostCents:r[6],active:true};});
  const opening={epoch:CVTransactions.EPOCH,resources};
  // Validar apertura antes de escribirla.
  new CVTransactions.Engine({readJournal:()=>[],readEffects:()=>[]},opening);
  cvAppend_(ss,'AperturaV2',opening);
 }
 props.setProperty('SANDBOX_OWNER_EMAIL',active);return {environment:'synthetic',epoch:CVTransactions.EPOCH,initialized:true};
});}
function cvReply_(fn){try{cvOwner_();return cvLocked_(fn);}catch(e){const known=/^(INVALID_|INSUFFICIENT_|PROTOCOL_|WRONG_|OWNER_|SALE_|FUTURE_|COMMAND_|FINANCIAL_|RESOURCE_|REASON_|RETURN_|IDEMPOTENCY_|CONSUMPTION_|CORRUPT_|JOURNAL_|EFFECT_CONFLICT|OPENING_|SETUP_|TAB_|RECORD_)/.test(e.message);return {error:known?e.message:'SERVER_UNAVAILABLE',retryable:!known};}}
// Sin argumentos: mantenimiento manual del laboratorio, restringido al propietario por el despliegue.
function sandboxExecute(command){if(command===undefined){initializeSandbox_();return runSandboxSmoke_();}return cvReply_(()=>cvEngine_().execute(command));}
function sandboxStatus(operationId){return cvReply_(()=>cvEngine_().status(operationId));}
function sandboxSnapshot(){return cvReply_(()=>cvEngine_().state());}
function doGet(){cvOwner_();return HtmlService.createHtmlOutput(CV_HTML_).setTitle('Casa Vieja · Pruebas de ventas');}
function doPost(){throw Error('POST_DISABLED_USE_PRIVATE_HTML_SERVICE');}
// Prueba real solo con recursos demo; conserva registros y los compensa al terminar.
function runSandboxSmoke_(){
 cvOwner_();const run='smoke-'+Utilities.getUuid();const make=(n,saleId,type,extra)=>Object.assign({operationId:run+'-'+n,deviceId:'editor-smoke',epoch:'TEST_ONLY_V2',schemaVersion:2,saleId:'future:'+run+'-'+saleId,type},extra||{});
 const before=sandboxSnapshot();if(before.error)throw Error(before.error);
 const sale=make('register','one','REGISTER_SALE',{lines:[{resourceId:'demo:molido',qty:1}],totalCents:3300,metadata:{customer:'Prueba sintética'}});
 const first=sandboxExecute(sale);if(first.error)throw Error(first.error);
 if(JSON.stringify(sandboxExecute(sale))!==JSON.stringify(first))throw Error('SMOKE_IDEMPOTENCY');
 if(sandboxStatus(sale.operationId).state!=='COMMITTED')throw Error('SMOKE_STATUS');
 const cancel=make('cancel','one','CANCEL_SALE',{expectedSaleVersion:1,reason:'Fin de prueba sintética'});if(sandboxExecute(cancel).error)throw Error('SMOKE_CANCEL');sandboxExecute(cancel);
 const combo=make('combo','two','REGISTER_SALE',{lines:[{resourceId:'demo:molido',qty:1},{resourceId:'demo:grano',qty:1}],totalCents:6600});if(sandboxExecute(combo).error)throw Error('SMOKE_COMBO');
 const saved=sandboxSnapshot().sales[combo.saleId];
 const edit=make('edit','two','EDIT_SALE',{expectedSaleVersion:1,metadata:{customer:'Combo demo editado'}});if(sandboxExecute(edit).error)throw Error('SMOKE_EDIT');
 const edited=sandboxSnapshot().sales[combo.saleId];if(saved.profitCents!==edited.profitCents)throw Error('SMOKE_PROFIT');
 const cancelCombo=make('cancel-combo','two','CANCEL_SALE',{expectedSaleVersion:2,reason:'Fin de prueba combo'});if(sandboxExecute(cancelCombo).error)throw Error('SMOKE_CANCEL_COMBO');
 const after=sandboxSnapshot();if(JSON.stringify(before.resources)!==JSON.stringify(after.resources))throw Error('SMOKE_STOCK');
 const result={run,passed:true,revisionBefore:before.revision,revisionAfter:after.revision,stockRestored:true};console.log(JSON.stringify(result));return result;
}
// Mantenimiento del laboratorio: el despliegue se restringe al propietario.
function sandboxInitialize(){const result=initializeSandbox_();console.log(JSON.stringify(result));return result;}
function sandboxSmoke(){return runSandboxSmoke_();}
function sandboxRecovery(){return cvReply_(()=>{
 const cases=[];const engine=cvEngine_();const before=engine.state();
 for(const stage of ['afterPrepare','afterEffect','afterCommit']){
  const base='recovery-'+Utilities.getUuid(),command={operationId:base,deviceId:'recovery-test',epoch:'TEST_ONLY_V2',schemaVersion:2,type:'REGISTER_SALE',saleId:'future:'+base,lines:[{resourceId:'demo:molido',qty:1}],totalCents:3300};let fired=false;
  const failing=new CVTransactions.Engine(engine.store,engine.opening,point=>{if(point===stage&&!fired){fired=true;throw Error('INJECTED_TEST_FAILURE');}});
  try{failing.execute(command);throw Error('FAILURE_NOT_INJECTED');}catch(e){if(e.message!=='INJECTED_TEST_FAILURE')throw e;}
  const partial=engine.status(base);const result=engine.execute(command);if(result.state!=='COMMITTED')throw Error('RECOVERY_TEST_FAILED');
  engine.execute({operationId:base+'-cancel',deviceId:'recovery-test',epoch:'TEST_ONLY_V2',schemaVersion:2,type:'CANCEL_SALE',saleId:command.saleId,expectedSaleVersion:1,reason:'Fin de prueba de recuperación'});
  cases.push({stage,observed:partial.state,recovered:result.state});
 }
 const after=engine.state();if(JSON.stringify(before.resources)!==JSON.stringify(after.resources))throw Error('RECOVERY_STOCK_MISMATCH');return {passed:true,cases};
});}

function sandboxSaveReport(report){return cvReply_(()=>{
 if(!report||typeof report.run!=='string'||!report.run.startsWith('browser-')||typeof report.passed!=='boolean'||!Array.isArray(report.results)||JSON.stringify(report).length>12000)throw Error('INVALID_REPORT');
 const ss=cvBook_();if(!ss.getSheetByName('VerificacionesV2'))ss.insertSheet('VerificacionesV2').appendRow(['ID','Tipo','JSON']);
 cvAppend_(ss,'VerificacionesV2',{id:report.run,kind:'BROWSER_REPORT',environment:'synthetic',report});return {saved:true,run:report.run};
});}

const CV_HTML_ = "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<base target=\"_top\">\n<meta charset=\"UTF-8\">\n<!-- CONFIGURACIÓN DE PWA Y VISTA MÓVIL (IPHONE / PC) -->\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\">\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n<meta name=\"apple-mobile-web-app-title\" content=\"Casa Vieja\">\n\n<title>Casa Vieja · Control de Operaciones</title>\n\n<style>\n  :root{\n    --bg:#1C1410;\n    --surface:#241B15;\n    --surface-2:#2E241C;\n    --surface-3:#382B20;\n    --border:#3D2F24;\n    --text:#F2E9DC;\n    --text-muted:#A8998A;\n    --accent-red:#C1432E;\n    --accent-gold:#D4A34A;\n    --accent-green:#6B8F5C;\n    --accent-blue:#5C7F8F;\n    --radius:10px;\n    --font-display:'Iowan Old Style','Palatino Linotype',Georgia,serif;\n    --font-body:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;\n  }\n  *{box-sizing:border-box;}\n  html,body{margin:0;padding:0;}\n  body{\n    background:var(--bg);\n    color:var(--text);\n    font-family:var(--font-body);\n    min-height:100vh;\n    padding-bottom:env(safe-area-inset-bottom);\n  }\n  #app{display:flex;min-height:100vh;}\n  \n  /* Sidebar */\n  .sidebar{\n    width:220px;flex-shrink:0;background:var(--surface);\n    border-right:1px solid var(--border);\n    display:flex;flex-direction:column;padding:20px 0;\n  }\n  .brand{padding:0 20px 18px 20px;border-bottom:1px solid var(--border);margin-bottom:10px;}\n  .brand h1{font-family:var(--font-display);font-size:20px;margin:0 0 2px 0;font-weight:600;letter-spacing:.3px;}\n  .brand span{font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:1px;}\n  nav.navlist{\n    display:flex;flex-direction:column;gap:2px;padding:0 10px;\n    -webkit-overflow-scrolling:touch;\n  }\n  .nav-btn{\n    display:flex;align-items:center;gap:10px;\n    background:none;border:none;color:var(--text-muted);\n    padding:10px 12px;border-radius:8px;cursor:pointer;\n    font-size:14px;text-align:left;font-family:var(--font-body);\n    transition:background .15s, color .15s;\n  }\n  .nav-btn svg{flex-shrink:0;opacity:.8;}\n  .nav-btn:hover{background:var(--surface-2);color:var(--text);}\n  .nav-btn.active{background:var(--surface-3);color:var(--text);font-weight:600;}\n  .nav-btn.active svg{opacity:1;}\n  .sidebar-footer{margin-top:auto;padding:14px 20px 0 20px;border-top:1px solid var(--border);}\n  .sidebar-footer p{font-size:11px;color:var(--text-muted);line-height:1.5;margin:10px 0 0 0;}\n  #connStatus.online{color:var(--accent-green);}\n  #connStatus.offline{color:var(--text-muted);}\n  \n  /* Main */\n  .main{flex:1;min-width:0;padding:26px 34px 60px 34px;}\n  .topbar{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:22px;flex-wrap:wrap;gap:8px;}\n  .topbar h2{font-family:var(--font-display);font-size:26px;margin:0;font-weight:600;}\n  .topbar .today{font-size:13px;color:var(--text-muted);}\n  .view{display:none;}\n  .view.active{display:block;animation:fadein .2s ease;}\n  @keyframes fadein{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:translateY(0);}}\n  \n  /* Cards / grid */\n  .grid{display:grid;gap:14px;}\n  .grid-kpi{grid-template-columns:repeat(auto-fit,minmax(180px,1fr));margin-bottom:22px;}\n  .grid-charts{grid-template-columns:repeat(auto-fit,minmax(320px,1fr));}\n  .card{\n    background:var(--surface);border:1px solid var(--border);\n    border-radius:var(--radius);padding:16px 18px;\n  }\n  .kpi-label{font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:var(--text-muted);margin:0 0 8px 0;}\n  .kpi-value{font-family:var(--font-display);font-size:26px;font-weight:600;font-variant-numeric:tabular-nums;margin:0;}\n  .kpi-value.red{color:var(--accent-red);}\n  .kpi-value.gold{color:var(--accent-gold);}\n  .kpi-value.green{color:var(--accent-green);}\n  .kpi-sub{font-size:11px;color:var(--text-muted);margin-top:6px;}\n  .card h3{font-size:14px;margin:0 0 14px 0;font-weight:600;color:var(--text);}\n  .card h3 small{display:block;font-size:11px;color:var(--text-muted);font-weight:400;margin-top:2px;}\n  \n  /* Chart bits */\n  .chart-svg{width:100%;height:auto;display:block;}\n  .legend{display:flex;flex-direction:column;gap:6px;margin-top:12px;font-size:12px;}\n  .legend-row{display:flex;align-items:center;gap:8px;justify-content:space-between;}\n  .legend-left{display:flex;align-items:center;gap:8px;color:var(--text-muted);}\n  .dot{width:9px;height:9px;border-radius:50%;flex-shrink:0;}\n  .donut-wrap{display:flex;gap:20px;align-items:center;flex-wrap:wrap;}\n  .donut{width:120px;height:120px;border-radius:50%;position:relative;flex-shrink:0;}\n  .donut::after{content:'';position:absolute;inset:22px;background:var(--surface);border-radius:50%;}\n  .donut-center{position:absolute;inset:22px;display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--text-muted);text-align:center;z-index:2;}\n  \n  /* Ripeness stock scale */\n  .stock-row{margin-bottom:14px;}\n  .stock-row-head{display:flex;justify-content:space-between;font-size:12.5px;margin-bottom:5px;}\n  .stock-row-head b{font-weight:600;}\n  .stock-row-head span.low{color:var(--accent-red);font-weight:600;}\n  .ripeness-track{position:relative;height:10px;border-radius:6px;overflow:hidden;\n    background:linear-gradient(90deg,var(--accent-red) 0%,var(--accent-gold) 45%,var(--accent-green) 100%);}\n  .ripeness-mask{position:absolute;top:0;right:0;height:100%;background:var(--surface-2);}\n  .ripeness-min{position:absolute;top:-2px;width:2px;height:14px;background:var(--text);opacity:.8;}\n  \n  /* Forms */\n  .form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:14px;}\n  label{display:block;font-size:11px;color:var(--text-muted);margin-bottom:5px;text-transform:uppercase;letter-spacing:.4px;}\n  input,select{\n    width:100%;background:var(--surface-2);border:1px solid var(--border);color:var(--text);\n    padding:9px 10px;border-radius:7px;font-size:13.5px;font-family:var(--font-body);\n  }\n  input:focus,select:focus{outline:2px solid var(--accent-gold);outline-offset:1px;}\n  .btn{\n    background:var(--accent-gold);color:#231A12;border:none;padding:10px 16px;\n    border-radius:7px;font-size:13.5px;font-weight:600;cursor:pointer;font-family:var(--font-body);\n  }\n  .btn:hover{filter:brightness(1.08);}\n  .btn.secondary{background:var(--surface-3);color:var(--text);border:1px solid var(--border);}\n  .btn.danger{background:var(--accent-red);color:#fff;}\n  .btn.small{padding:5px 10px;font-size:12px;}\n  .btn:focus-visible, .nav-btn:focus-visible, select:focus-visible, input:focus-visible{outline:2px solid var(--accent-gold);outline-offset:2px;}\n  \n  /* Table */\n  .table-wrap{\n    overflow-x:auto;\n    -webkit-overflow-scrolling:touch;\n  }\n  table{width:100%;border-collapse:collapse;font-size:13px;}\n  th{text-align:left;color:var(--text-muted);font-size:11px;text-transform:uppercase;letter-spacing:.4px;padding:8px 10px;border-bottom:1px solid var(--border);white-space:nowrap;}\n  td{padding:9px 10px;border-bottom:1px solid var(--border);white-space:nowrap;}\n  tr:last-child td{border-bottom:none;}\n  .pill{display:inline-block;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:600;}\n  .pill.green{background:rgba(107,143,92,.18);color:var(--accent-green);}\n  .pill.gold{background:rgba(212,163,74,.18);color:var(--accent-gold);}\n  .pill.red{background:rgba(193,67,46,.18);color:var(--accent-red);}\n  .empty{color:var(--text-muted);font-size:13px;padding:24px 4px;text-align:center;border:1px dashed var(--border);border-radius:var(--radius);}\n  .section-title{font-family:var(--font-display);font-size:18px;font-weight:600;margin:26px 0 12px 0;}\n  .section-title:first-child{margin-top:0;}\n  .row-actions{display:flex;gap:6px;}\n  .hint{font-size:11.5px;color:var(--text-muted);margin-top:-4px;margin-bottom:14px;}\n  .toolbar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px;}\n  .flexend{display:flex;justify-content:flex-end;gap:10px;flex-wrap:wrap;}\n\n  /* Acordeón (tarjetas desplegables para historiales) */\n  .acc-list{display:flex;flex-direction:column;gap:8px;}\n  .acc-item{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;}\n  .acc-head{display:flex;align-items:center;gap:10px;padding:12px 14px;cursor:pointer;user-select:none;}\n  .acc-head:hover{background:var(--surface-2);}\n  .acc-num{flex:0 0 auto;min-width:26px;color:var(--text-muted);font-size:12px;font-weight:600;}\n  .acc-summary{flex:1 1 auto;min-width:0;display:flex;flex-wrap:wrap;align-items:center;gap:6px 12px;}\n  .acc-summary .acc-main{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}\n  .acc-summary .acc-sub{color:var(--text-muted);font-size:12px;white-space:nowrap;}\n  .acc-summary .acc-amt{margin-left:auto;font-weight:700;white-space:nowrap;}\n  .acc-caret{flex:0 0 auto;color:var(--text-muted);transition:transform .15s;font-size:12px;}\n  .acc-item.open .acc-caret{transform:rotate(180deg);}\n  .acc-body{display:none;padding:4px 14px 14px 14px;border-top:1px solid var(--border);}\n  .acc-item.open .acc-body{display:block;}\n  .acc-fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px 16px;margin:10px 0;}\n  .acc-field label{margin-bottom:2px;}\n  .acc-field div{font-size:13.5px;}\n  .acc-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;}\n  .wf-row{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:9px 0;border-bottom:1px solid var(--border);font-size:14px;}\n  .wf-row small{display:block;color:var(--text-muted);font-size:11px;font-weight:400;}\n  .wf-row b{white-space:nowrap;font-variant-numeric:tabular-nums;}\n  .wf-row.neg b{color:var(--accent-red);}\n  .wf-row.total{border-bottom:none;border-top:2px solid var(--border);margin-top:4px;padding-top:12px;font-size:16px;font-weight:600;}\n  .wf-row.total b{font-family:var(--font-display);font-size:24px;}\n  .split-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px;margin-top:14px;}\n  .split-box{background:var(--surface-2);border:1px solid var(--border);border-radius:8px;padding:12px 14px;}\n  .split-box .nm{font-weight:600;margin-bottom:6px;}\n  .split-box .ln{display:flex;justify-content:space-between;font-size:12.5px;color:var(--text-muted);padding:2px 0;}\n  .split-box .tt{display:flex;justify-content:space-between;font-weight:700;padding-top:6px;margin-top:4px;border-top:1px solid var(--border);}\n  .acc-item.static .acc-head{cursor:default;}\n  .acc-item.static .acc-head:hover{background:none;}\n  .acc-field input,.acc-field select{width:100%;}\n  .pill.blue{background:rgba(92,127,143,.18);color:var(--accent-blue);}\n  .acc-list + .acc-list{margin-top:8px;}\n  @media (max-width:880px){\n    .acc-summary .acc-main{max-width:140px;}\n  }\n\n  /* Botón hamburguesa (solo visible en móvil) */\n  .hamburger-btn{\n    display:none;background:var(--surface-2);border:1px solid var(--border);color:var(--text);\n    width:40px;height:40px;border-radius:8px;cursor:pointer;flex-shrink:0;\n    align-items:center;justify-content:center;\n  }\n\n  /* ADAPTACIÓN MÓVIL (IPHONE / SMARTPHONES) */\n  @media (max-width:880px){\n    #app{flex-direction:column;}\n    .sidebar{\n      width:100%;flex-direction:column;align-items:stretch;position:relative;z-index:500;\n      padding: max(12px, env(safe-area-inset-top)) 14px 12px 14px;\n    }\n    .brand{border:none;padding:0;margin:0;display:flex;align-items:center;justify-content:space-between;}\n    .hamburger-btn{display:flex;}\n    nav.navlist{\n      flex-direction:column;padding:0;margin-top:0;max-height:0;overflow:hidden;\n      transition:max-height .2s ease, margin-top .2s ease;\n    }\n    nav.navlist.open{max-height:480px;margin-top:12px;}\n    .sidebar-footer{display:none;}\n    .main{padding:16px 16px 50px 16px;}\n    \n    input, select, textarea {\n      font-size: 16px !important;\n    }\n    \n    .btn, .nav-btn {\n      min-height: 44px;\n      display: inline-flex;\n      align-items: center;\n    }\n    .btn{justify-content:center;}\n    .nav-btn{justify-content:flex-start;}\n  }\n</style>\n</head>\n<body>\n<div id=\"app\">\n  <aside class=\"sidebar\">\n    <div class=\"brand\">\n      <div>\n        <h1>Casa Vieja</h1>\n        <span>Control de operaciones</span>\n      </div>\n      <button class=\"hamburger-btn\" id=\"hamburgerBtn\" onclick=\"toggleMobileNav()\" aria-label=\"Abrir menú\">\n        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><line x1=\"4\" y1=\"6\" x2=\"20\" y2=\"6\"/><line x1=\"4\" y1=\"12\" x2=\"20\" y2=\"12\"/><line x1=\"4\" y1=\"18\" x2=\"20\" y2=\"18\"/></svg>\n      </button>\n    </div>\n    <nav class=\"navlist\" id=\"navlist\">\n      <button class=\"nav-btn\" data-view=\"dashboard\" onclick=\"switchView('dashboard')\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><rect x=\"3\" y=\"12\" width=\"4\" height=\"9\"/><rect x=\"10\" y=\"6\" width=\"4\" height=\"15\"/><rect x=\"17\" y=\"3\" width=\"4\" height=\"18\"/></svg>\n        Dashboard\n      </button>\n      <button class=\"nav-btn\" data-view=\"ventas\" onclick=\"switchView('ventas')\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><circle cx=\"9\" cy=\"20\" r=\"1.4\"/><circle cx=\"17\" cy=\"20\" r=\"1.4\"/><path d=\"M2 3h2l2.6 12.6a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.6L21 7H5.2\"/></svg>\n        Ventas\n      </button>\n      <button class=\"nav-btn\" data-view=\"stock\" onclick=\"switchView('stock')\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M21 8l-9-5-9 5 9 5 9-5z\"/><path d=\"M3 8v8l9 5 9-5V8\"/><path d=\"M12 13v8\"/></svg>\n        Stock\n      </button>\n      <button class=\"nav-btn\" data-view=\"ads\" onclick=\"switchView('ads')\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M3 11v2a1 1 0 0 0 1 1h3l5 4V6L7 10H4a1 1 0 0 0-1 1z\"/><path d=\"M16 8a4 4 0 0 1 0 8\"/></svg>\n        Ads\n      </button>\n      <button class=\"nav-btn\" data-view=\"egresos\" onclick=\"switchView('egresos')\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M3 7h18v13H3z\"/><path d=\"M3 7l4-4h10l4 4\"/><path d=\"M8 12h8\"/></svg>\n        Egresos\n      </button>\n      <button class=\"nav-btn\" data-view=\"delivery\" onclick=\"switchView('delivery')\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><rect x=\"1\" y=\"7\" width=\"13\" height=\"9\"/><path d=\"M14 10h4l3 3v3h-7z\"/><circle cx=\"5.5\" cy=\"18\" r=\"1.6\"/><circle cx=\"16.5\" cy=\"18\" r=\"1.6\"/></svg>\n        Delivery\n      </button>\n      <button class=\"nav-btn\" data-view=\"clientes\" onclick=\"switchView('clientes')\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><circle cx=\"9\" cy=\"8\" r=\"3.2\"/><path d=\"M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6\"/><circle cx=\"17.5\" cy=\"9\" r=\"2.4\"/><path d=\"M15.5 14.2c2.6.3 4.5 2.5 4.5 5.3\"/></svg>\n        Clientes\n      </button>\n      <button class=\"nav-btn\" data-view=\"inventario\" onclick=\"switchView('inventario')\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M3 7l9-4 9 4-9 4-9-4z\"/><path d=\"M3 7v10l9 4 9-4V7\"/><path d=\"M12 11v10\"/></svg>\n        Inventario\n      </button>\n      <button class=\"nav-btn\" data-view=\"fondo\" onclick=\"switchView('fondo')\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><ellipse cx=\"12\" cy=\"6\" rx=\"8\" ry=\"3\"/><path d=\"M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6\"/><path d=\"M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6\"/></svg>\n        Fondo\n      </button>\n      <button class=\"nav-btn\" data-view=\"config\" onclick=\"switchView('config')\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-1.8-.3 1.6 1.6 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.6 1.6 0 0 0-1-1.5 1.6 1.6 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.6 1.6 0 0 0 .3-1.8 1.6 1.6 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.6 1.6 0 0 0 1.5-1 1.6 1.6 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.6 1.6 0 0 0 1.8.3H9a1.6 1.6 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.6 1.6 0 0 0 1 1.5 1.6 1.6 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0-.3 1.8V9a1.6 1.6 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.6 1.6 0 0 0-1.5 1z\"/></svg>\n        Configuración\n      </button>\n    </nav>\n    <div class=\"sidebar-footer\">\n      <p id=\"connStatus\">Entorno de pruebas</p>\n      <p>Solo datos ficticios. Producción sin conexión.</p>\n    </div>\n  </aside>\n\n  <main class=\"main\">\n    <div class=\"topbar\">\n      <h2 id=\"pageTitle\">Ventas de pruebas</h2>\n      <div class=\"today\" id=\"todayLabel\"></div>\n    </div>\n    <section class=\"view\" id=\"view-dashboard\"></section>\n    <section class=\"view active\" id=\"view-ventas\">\n<div class=\"card\"><b>ENTORNO SINTÉTICO · FASE 2</b><p id=\"sync-notice\" role=\"status\" aria-live=\"polite\">Conectando con la hoja de pruebas…</p><p id=\"stock\"></p></div>\n<div class=\"section-title\">Registrar nueva venta</div>\n<div class=\"card\">\n<label><input type=\"checkbox\" id=\"sf-combo-toggle\"> Venta combinada — mezcla Grano/Molido</label>\n<div class=\"form-grid\">\n<div><label>Fecha</label><input type=\"date\" id=\"sf-date\"></div>\n<div><label>Producto</label><select id=\"sf-product\"><option value=\"demo:molido\">Gourmet Molido 500 g · DEMO</option><option value=\"demo:grano\">Gourmet Grano 500 g · DEMO</option></select></div>\n<div><label>Presentación</label><select id=\"sf-pack\"><option value=\"1\">Bolsa</option><option value=\"3\">Tripack — 3 bolsas</option></select></div>\n<div><label>Cantidad de presentaciones</label><input type=\"number\" min=\"1\" step=\"1\" id=\"sf-qty\" value=\"1\"></div>\n<div><label>Total de venta (S/)</label><input type=\"number\" min=\"0\" step=\"0.01\" id=\"sf-price\" value=\"0\"></div>\n<div><label>Cliente (opcional)</label><input id=\"sf-customer\" maxlength=\"500\" placeholder=\"Cliente ficticio\"></div>\n<div><label>Teléfono (opcional)</label><input id=\"sf-phone\" maxlength=\"500\"></div>\n<div><label>Costo real de envío (S/)</label><input type=\"number\" min=\"0\" step=\"0.01\" id=\"sf-delcost\" value=\"0\"></div>\n<div><label>Cobrado por envío (S/)</label><input type=\"number\" min=\"0\" step=\"0.01\" id=\"sf-delcharged\" value=\"0\"></div>\n<div><label>Zona / dirección</label><input id=\"sf-zone\" maxlength=\"500\"></div>\n</div>\n<div id=\"sf-combo-block\" class=\"form-grid\" style=\"display:none;margin-top:14px\">\n<div><label>Bolsas molido</label><input type=\"number\" min=\"0\" step=\"1\" id=\"combo-molido\" value=\"1\"></div>\n<div><label>Bolsas grano</label><input type=\"number\" min=\"0\" step=\"1\" id=\"combo-grano\" value=\"1\"></div>\n</div>\n<button class=\"btn\" id=\"register\" style=\"margin-top:14px\">+ Registrar venta</button>\n</div>\n<div class=\"section-title\">Sincronización · pendientes: <span id=\"pending-count\">0</span></div><div class=\"card\"><button class=\"btn secondary\" id=\"retry\">Reintentar y descargar</button><div id=\"queue\" style=\"overflow-wrap:anywhere\"></div></div>\n<div class=\"section-title\">Ventas confirmadas de pruebas</div><div id=\"history\"></div><details class=\"card\"><summary>Verificaciones del laboratorio</summary><p>Ejecuta operaciones ficticias y sus compensaciones. Puede tardar varios minutos.</p><button class=\"btn secondary\" id=\"verify\">Verificar sincronización y concurrencia</button><pre id=\"verification-results\" style=\"white-space:pre-wrap;overflow-wrap:anywhere\"></pre></details></section>\n    <section class=\"view\" id=\"view-stock\"></section>\n    <section class=\"view\" id=\"view-ads\"></section>\n    <section class=\"view\" id=\"view-egresos\"></section>\n    <section class=\"view\" id=\"view-delivery\"></section>\n    <section class=\"view\" id=\"view-clientes\"></section>\n    <section class=\"view\" id=\"view-inventario\"></section>\n    <section class=\"view\" id=\"view-fondo\"></section>\n    <section class=\"view\" id=\"view-config\"></section>\n  </main>\n</div>\n\n\n<script>\n/* Cola transaccional. Un documento IndexedDB por dispositivo/cuenta/destino. */\n(function(root,factory){const api=factory();if(typeof module==='object'&&module.exports)module.exports=api;else root.CVClient=api;})(typeof globalThis==='object'?globalThis:this,function(){\n'use strict';\nconst copy=x=>JSON.parse(JSON.stringify(x));\nconst empty=()=>({generation:0,queue:[],archived:[],receipts:{},snapshot:null,deviceId:null});\nclass Client{\n constructor(store,transport,destination,uuid){this.store=store;this.transport=transport;this.destination=destination;this.uuid=uuid;this.running=null;}\n async enqueue(payload){let saved;await this.store.transact(s=>{s.deviceId=s.deviceId||this.uuid();const command=Object.assign({},copy(payload),{operationId:this.uuid(),deviceId:s.deviceId,epoch:this.destination,schemaVersion:2});saved=copy(command);s.queue.push({command,state:'PENDING',lastError:''});s.generation++;});return {queued:true,confirmed:false,command:saved};}\n async view(){return this.store.read();}\n async archiveRejected(operationId){\n  const entry=(await this.store.read()).queue.find(x=>x.command.operationId===operationId);if(!entry||entry.state!=='REJECTED')throw Error('REJECTED_REQUIRED');\n  const result=await this.transport.status(operationId);if(!result||result.epoch!==this.destination||result.operationId!==operationId||result.state!=='REJECTED')throw Error('UNRESOLVED_SERVER_STATE');\n  await this.store.transact(s=>{const item=s.queue.find(x=>x.command.operationId===operationId);if(!item||item.state!=='REJECTED')throw Error('QUEUE_CHANGED');s.archived=s.archived||[];s.archived.push({...item,serverRejection:copy(result),resolution:'SERVER_REJECTED_NO_SALE_EFFECT'});s.queue=s.queue.filter(x=>x!==item);s.generation++;});\n }\n validAck(r,c){return r&&r.epoch===this.destination&&r.operationId===c.operationId&&r.saleId===c.saleId&&r.state==='COMMITTED'&&Number.isSafeInteger(r.revision)&&r.revision>0&&Number.isSafeInteger(r.saleVersion);}\n async ack(r,c){if(!this.validAck(r,c))throw Error('INVALID_ACK');await this.store.transact(s=>{s.receipts[c.operationId]=copy(r);s.queue=s.queue.filter(x=>x.command.operationId!==c.operationId);s.generation++;});}\n flush(){if(!this.running)this.running=this.drain().finally(()=>this.running=null);return this.running;}\n async drain(){\n  while(true){const s=await this.store.read(),item=s.queue[0];if(!item||item.state==='REJECTED')return;\n   const c=item.command;\n   try{\n    let r=await this.transport.status(c.operationId);\n    if(!r||r.epoch!==this.destination||r.operationId!==c.operationId)throw Error('INVALID_STATUS');\n    if(r.state==='UNKNOWN'||r.state==='PREPARED')r=await this.transport.execute(c);\n    if(r&&r.error){const error=Error(r.error);error.permanent=r.retryable===false;throw error;}\n    await this.ack(r,c);\n   }catch(e){await this.store.transact(state=>{const entry=state.queue.find(x=>x.command.operationId===c.operationId);if(entry){entry.lastError=e.message;entry.state=e.permanent?'REJECTED':'PENDING';}state.generation++;});return;}\n  }\n }\n async refresh(){const start=await this.store.read();if(start.queue.length)return false;const snap=await this.transport.snapshot();if(!snap||snap.epoch!==this.destination||!Number.isSafeInteger(snap.revision))return false;let applied=false;await this.store.transact(s=>{const minRevision=Math.max(s.snapshot?s.snapshot.revision:0,...Object.values(s.receipts).map(x=>x.revision));if(!s.queue.length&&s.generation===start.generation&&snap.revision>=minRevision){s.snapshot=copy(snap);s.generation++;applied=true;}});return applied;}\n}\nclass IndexedStore{\n constructor(name){this.name=name;this.dbPromise=null;}\n db(){if(!this.dbPromise)this.dbPromise=new Promise((resolve,reject)=>{const r=indexedDB.open(this.name,1);r.onupgradeneeded=()=>r.result.createObjectStore('state');r.onsuccess=()=>resolve(r.result);r.onerror=()=>reject(r.error);r.onblocked=()=>reject(Error('STORAGE_BLOCKED'));});return this.dbPromise;}\n async read(){const db=await this.db();return new Promise((resolve,reject)=>{const tx=db.transaction('state','readonly');const req=tx.objectStore('state').get('current');let value;req.onsuccess=()=>value=copy(req.result||empty());tx.oncomplete=()=>resolve(value);tx.onerror=tx.onabort=()=>reject(tx.error||Error('STORAGE_FAILED'));});}\n async transact(fn){const db=await this.db();return new Promise((resolve,reject)=>{const tx=db.transaction('state','readwrite'),store=tx.objectStore('state');let failure;const req=store.get('current');req.onsuccess=()=>{try{const s=copy(req.result||empty());fn(s);store.put(s,'current');}catch(e){failure=e;tx.abort();}};tx.oncomplete=()=>resolve();tx.onerror=tx.onabort=()=>reject(failure||tx.error||Error('STORAGE_FAILED'));});}\n}\nreturn {Client,IndexedStore,empty};\n});\n\n'use strict';\nconst epoch='TEST_ONLY_V2';\nconst uuid=()=>crypto.randomUUID();\nconst rpc=(name,arg)=>new Promise((resolve,reject)=>{\n const timer=setTimeout(()=>reject(Error('CONNECTION_TIMEOUT')),name==='recovery'?120000:25000);\n const runner=google.script.run.withSuccessHandler(r=>{clearTimeout(timer);resolve(r);}).withFailureHandler(()=>{clearTimeout(timer);reject(Error('CONNECTION_FAILED'));});\n if(name==='report')runner.sandboxSaveReport(arg);else if(name==='recovery')runner.sandboxRecovery();else if(name==='snapshot')runner.sandboxSnapshot();else if(name==='status')runner.sandboxStatus(arg);else runner.sandboxExecute(arg);\n});\nconst client=new CVClient.Client(new CVClient.IndexedStore('cv-sales-sandbox-v2-owner'),{execute:c=>rpc('execute',c),status:id=>rpc('status',id),snapshot:()=>rpc('snapshot')},epoch,uuid);\nconst $=id=>document.getElementById(id);\nconst esc=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst money=n=>'S/ '+(n/100).toFixed(2);\nlet snapshot=null,busy=false,lastCommand=null;\nfunction notice(t){$('sync-notice').textContent=t;}\nfunction toggleMobileNav(){document.querySelector('.sidebar').classList.toggle('mobile-open');}\nfunction switchView(name){notice(name==='ventas'?'Ventas de pruebas. Usa únicamente datos ficticios.':'Este módulo queda fuera de la Fase 2.');}\nfunction cents(id){const raw=$(id).value;if(!/^\\d+(\\.\\d{1,2})?$/.test(raw))throw Error('Revisa los importes: máximo dos decimales.');const [whole,dec='']=raw.split('.');return Number(whole)*100+Number(dec.padEnd(2,'0'));}\nfunction lines(){const combo=$('sf-combo-toggle').checked;const qty=Number($('sf-qty').value);if(!Number.isSafeInteger(qty)||qty<1)throw Error('Cantidad inválida');if(combo)return [{resourceId:'demo:molido',qty:Number($('combo-molido').value)},{resourceId:'demo:grano',qty:Number($('combo-grano').value)}].filter(l=>l.qty>0);return [{resourceId:$('sf-product').value,qty:qty*Number($('sf-pack').value)}];}\nasync function render(){\n const local=await client.view();snapshot=local.snapshot;\n $('pending-count').textContent=String(local.queue.length);\n $('queue').innerHTML=local.queue.map(q=>`<p>${esc(q.command.operationId)} · ${esc(q.state)} ${esc(q.lastError)} ${q.state==='REJECTED'?`<button class=\"btn small secondary\" data-archive=\"${esc(q.command.operationId)}\">Archivar rechazo sin borrar su registro</button>`:''}</p>`).join('')||'<p>Sin operaciones pendientes.</p>';\n $('queue').querySelectorAll('[data-archive]').forEach(b=>b.onclick=async()=>{try{await client.archiveRejected(b.dataset.archive);notice('Rechazo conservado en el archivo local. Puedes registrar una operación nueva.');await synchronize();}catch(e){notice(e.message);}});\n const sales=snapshot?Object.values(snapshot.sales):[];\n $('history').innerHTML=sales.map(s=>`<details class=\"card\"><summary>${esc(s.metadata.customer||'Sin cliente')} · ${money(s.totalCents)} · ${esc(s.status)}</summary><p>${s.lines.map(l=>`${esc(l.grind)} × ${l.qty} (${esc(l.lot)})`).join(' + ')}</p><p>Costo: ${money(s.costCents)} · Ganancia: ${money(s.profitCents)}</p><button class=\"btn small\" data-edit=\"${esc(s.id)}\">Editar contacto</button> <button class=\"btn small danger\" data-cancel=\"${esc(s.id)}\" ${s.status!=='REGISTERED'?'disabled':''}>Cancelar venta</button></details>`).join('')||'<p class=\"hint\">Sin ventas confirmadas en la descarga actual.</p>';\n const resources=snapshot?snapshot.resources:{};$('stock').textContent=Object.entries(resources).map(([k,r])=>`${k}: ${r.qty} bolsas`).join(' · ')||'Stock pendiente de descargar';\n $('history').querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>edit(b.dataset.edit));\n $('history').querySelectorAll('[data-cancel]').forEach(b=>b.onclick=()=>cancel(b.dataset.cancel));\n $('connStatus').textContent=local.queue.length?`${local.queue.length} operación(es) pendiente(s)`:'Entorno de pruebas';\n}\nasync function synchronize(){\n if(busy)return;busy=true;\n try{await client.flush();const refreshed=await client.refresh();await render();if(refreshed&&!(await client.view()).queue.length)notice('Conectado al entorno de pruebas.');}catch(e){notice(e.message);}finally{busy=false;}\n}\nasync function send(payload){\n try{const queued=await client.enqueue(payload);lastCommand=queued.command;notice('Guardada en este dispositivo. Pendiente de confirmación del servidor.');await render();await synchronize();const local=await client.view();notice(local.receipts[queued.command.operationId]?'Venta u operación confirmada por el servidor.':'Operación pendiente o rechazada. Revisa la cola.');return queued.command;}catch(e){notice('No confirmada: '+e.message);throw e;}\n}\nasync function register(){\n $('register').disabled=true;try{\n const saleLines=lines();if(!saleLines.length||saleLines.some(l=>!Number.isSafeInteger(l.qty)||l.qty<=0))throw Error('Revisa las cantidades del combo.');\n await send({type:'REGISTER_SALE',saleId:'future:'+uuid(),lines:saleLines,totalCents:cents('sf-price'),deliveryCostCents:cents('sf-delcost'),deliveryChargedCents:cents('sf-delcharged'),metadata:{customer:$('sf-customer').value,phone:$('sf-phone').value,zone:$('sf-zone').value,date:$('sf-date').value}});\n }catch(e){notice('No confirmada: '+e.message);}finally{$('register').disabled=false;}\n}\nasync function edit(id){const s=snapshot.sales[id],customer=prompt('Nombre del cliente (solo datos ficticios)',s.metadata.customer||'');if(customer===null)return;await send({type:'EDIT_SALE',saleId:id,expectedSaleVersion:s.version,metadata:{customer}});}\nasync function cancel(id){const s=snapshot.sales[id],reason=prompt('Motivo de cancelación. Se registrará la compensación de stock.');if(!reason)return;await send({type:'CANCEL_SALE',saleId:id,expectedSaleVersion:s.version,reason});}\n$('sf-combo-toggle').onchange=()=>{$('sf-combo-block').style.display=$('sf-combo-toggle').checked?'block':'none';};\n$('register').onclick=register;$('retry').onclick=synchronize;\nwindow.addEventListener('online',synchronize);window.addEventListener('focus',synchronize);\nsetInterval(synchronize,15000);\n$('sf-date').value=new Intl.DateTimeFormat('en-CA',{timeZone:'America/Lima',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());\nrender().then(synchronize).catch(e=>notice('No se pudo abrir el almacenamiento local: '+e.message));\n\n// Verificaciones explícitas del laboratorio privado. Solo datos demo.\nasync function runBrowserChecks(){\n const button=$('verify');button.disabled=true;const results=[];const run='browser-'+uuid();\n const record=(name,ok,detail='')=>{results.push({name,passed:!!ok,detail});$('verification-results').textContent=JSON.stringify(results,null,2);if(!ok)throw Error(name+' '+detail);};\n const make=(suffix,qty=1)=>({type:'REGISTER_SALE',saleId:'future:'+run+'-'+suffix,lines:[{resourceId:'demo:molido',qty}],totalCents:3300*qty,metadata:{customer:'Demo '+suffix}});\n const freshClient=suffix=>new CVClient.Client(new CVClient.IndexedStore('cv-check-'+run+'-'+suffix),{execute:c=>rpc('execute',c),status:id=>rpc('status',id),snapshot:()=>rpc('snapshot')},epoch,uuid);\n const cleanup=async c=>{const state=await rpc('snapshot');const s=state.sales[c.saleId];if(s&&s.status==='REGISTERED'){const r=await rpc('execute',{operationId:uuid(),deviceId:'browser-cleanup',epoch,schemaVersion:2,type:'CANCEL_SALE',saleId:c.saleId,expectedSaleVersion:s.version,reason:'Fin de verificación sintética'});if(r.error)throw Error(r.error);}};\n const created=[];\n try{\n  const before=await rpc('snapshot');record('Conexión real a Apps Script y Sheets',before.epoch===epoch);\n  const offline=freshClient('offline'),payload=make('offline');const queued=await offline.enqueue(payload);created.push(queued.command);\n  const realTransport=offline.transport;offline.transport={status:async()=>{throw Error('OFFLINE_SIMULATED');}};await offline.flush();record('Interrupción simulada conserva cola en IndexedDB',(await offline.view()).queue.length===1);\n  offline.transport=realTransport;await offline.flush();record('Reconexión confirma una sola venta',(await offline.view()).receipts[queued.command.operationId]?.state==='COMMITTED');await cleanup(queued.command);\n  const lost=freshClient('lost'),lostQueued=await lost.enqueue(make('lost'));created.push(lostQueued.command);const execute=lost.transport.execute;lost.transport.execute=async c=>{await execute(c);throw Error('RESPONSE_LOST_SIMULATED');};await lost.flush();record('Respuesta perdida mantiene operación pendiente',(await lost.view()).queue.length===1);\n  await lost.flush();record('Consulta recupera confirmación original',(await lost.view()).receipts[lostQueued.command.operationId]?.state==='COMMITTED');await cleanup(lostQueued.command);\n  const a=freshClient('device-A'),b=freshClient('device-B');const qa=await a.enqueue(make('concurrent-A',3)),qb=await b.enqueue(make('concurrent-B',2));created.push(qa.command,qb.command);const stock=(await rpc('snapshot')).resources['demo:molido'].qty;\n  await Promise.all([a.flush(),b.flush()]);const after=await rpc('snapshot');record('Dos dispositivos lógicos envían en paralelo',qa.command.deviceId!==qb.command.deviceId&&(await a.view()).queue.length===0&&(await b.view()).queue.length===0);record('Stock concurrente disminuye exactamente 3 + 2',after.resources['demo:molido'].qty===stock-5);await cleanup(qa.command);await cleanup(qb.command);\n  const recovery=await rpc('recovery');record('Recuperación real después de fallos parciales',recovery.passed===true,JSON.stringify(recovery));\n  const rejected=freshClient('rejected');const qr=await rejected.enqueue(make('rejected',999));await rejected.flush();record('Stock insuficiente queda rechazado de forma durable',(await rpc('status',qr.command.operationId)).state==='REJECTED');await rejected.archiveRejected(qr.command.operationId);record('Rechazo se archiva sin perder comando ni evidencia',(await rejected.view()).archived.length===1&&(await rejected.view()).queue.length===0);\n  const end=await rpc('snapshot');record('Verificaciones dejan el stock como estaba',JSON.stringify(before.resources)===JSON.stringify(end.resources));\n  window.lastVerification={run,results,passed:true};notice('Verificaciones del laboratorio completadas.');\n }catch(e){results.push({name:'Error de verificación',passed:false,detail:e.message});window.lastVerification={run,results,passed:false};notice('Verificación interrumpida: '+e.message);\n }finally{for(const c of created){try{await cleanup(c);}catch(e){results.push({name:'Compensación pendiente',passed:false,detail:c.operationId});}}try{await rpc('report',window.lastVerification);}catch(e){results.push({name:'Informe remoto pendiente',passed:false,detail:e.message});} $('verification-results').textContent=run+'\\n'+(window.lastVerification.passed?'APROBADO':'REVISAR')+'\\n'+results.map(r=>(r.passed?'PASS ':'FAIL ')+r.name+(r.detail?' · '+r.detail:'')).join('\\n');await synchronize();button.disabled=false;}\n}\n$('verify').onclick=runBrowserChecks;\n\n</script>\n</body></html>\n";
