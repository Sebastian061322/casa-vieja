tn{justify-content:flex-start;}\n  }\n</style></head><body><div id=\"app\"><aside class=\"sidebar\"><div class=\"brand\"><div><h1>Casa Vieja</h1><span>Control de operaciones</span></div><button class=\"hamburger-btn\" onclick=\"document.getElementById('navlist').classList.toggle('open')\" aria-label=\"Abrir menú\">☰</button></div><nav class=\"navlist\" id=\"navlist\"><button class=\"nav-btn\" onclick=\"showSection('sales')\">Ventas</button><button class=\"nav-btn\" onclick=\"showSection('inventory')\">Inventario</button><button class=\"nav-btn\" onclick=\"showSection('operations')\">Preparación y lotes</button></nav></aside><main class=\"main\"><h2>Inventario unificado · Pruebas</h2><p class=\"hint\">ENTORNO SINTÉTICO · FASE 3</p><p id=\"notice\" role=\"status\">Conectando al laboratorio</p><button class=\"btn secondary\" id=\"sync\">Sincronizar</button><section id=\"inventory\" class=\"card\"><h3>Existencias por lote y presentación</h3><div style=\"overflow:auto\"><table><thead><tr><th>Producto / lote</th><th>Físico</th><th>Reservado</th><th>Disponible</th><th>Unidad</th><th>Valor S/</th></tr></thead><tbody id=\"balances\"></tbody></table></div><h3>Movimientos recientes</h3><div id=\"movements\"></div></section><section id=\"sales\" class=\"card\"><h3>Reservar venta</h3><p>La reserva reduce disponibilidad. El despacho descuenta existencias físicas.</p><label>Producto <select id=\"product\"></select></label><label>Cantidad <input id=\"qty\" type=\"number\" min=\"1\" value=\"1\"></label><label>Presentación <select id=\"pack\"><option value=\"1\">Bolsa</option><option value=\"3\">Tripack</option></select></label><label>Total S/ <input id=\"total\" type=\"number\" min=\"0\" step=\"0.01\" value=\"99\"></label><label>Responsable <input id=\"responsible\" value=\"Responsable ficticio\"></label><button class=\"btn\" id=\"reserve\">Reservar venta</button><div id=\"sales-list\"></div></section><section id=\"operations\" class=\"card\"><h3>Lotes y preparación</h3><p>Utiliza únicamente recursos y datos ficticios. Todas las cantidades de café se registran en gramos.</p><label>Operación <select id=\"operation-type\"><option>RECEIVE_LOT</option><option>RECEIVE_SUPPLY</option><option>ROAST</option><option>PREPARE_BAGS</option><option>WASTE</option></select></label><button class=\"btn secondary\" id=\"example\">Cargar ejemplo ficticio</button><p id=\"operation-help\"></p><div id=\"operation-fields\"></div><button class=\"btn\" id=\"apply\">Registrar operación de pruebas</button></section><section class=\"card\"><h3>Cola de operaciones</h3><div id=\"queue\"></div></section><details class=\"card\"><summary>Verificaciones del laboratorio</summary><p>Crea lotes y movimientos ficticios nuevos, sin borrar las pruebas anteriores.</p><button class=\"btn\" id=\"verify\">Verificar inventario con Google</button><pre id=\"results\" style=\"white-space:pre-wrap\"></pre></details></main></div>\n<script>\n/* Cola transaccional. Un documento IndexedDB por dispositivo/cuenta/destino. */\n(function(root,factory){const api=factory();if(typeof module==='object'&&module.exports)module.exports=api;else root.CVClient=api;})(typeof globalThis==='object'?globalThis:this,function(){\n'use strict';\nconst copy=x=>JSON.parse(JSON.stringify(x));\nconst empty=()=>({generation:0,queue:[],archived:[],receipts:{},snapshot:null,deviceId:null});\nclass Client{\n constructor(store,transport,destination,uuid){this.store=store;this.transport=transport;this.destination=destination;this.uuid=uuid;this.running=null;}\n async enqueue(payload){let saved;await this.store.transact(s=>{s.deviceId=s.deviceId||this.uuid();const command=Object.assign({},copy(payload),{operationId:this.uuid(),deviceId:s.deviceId,epoch:this.destination,schemaVersion:2});saved=copy(command);s.queue.push({command,state:'PENDING',lastError:''});s.generation++;});return {queued:true,confirmed:false,command:saved};}\n async view(){return this.store.read();}\n async archiveRejected(operationId){\n  const entry=(awa