function commercialEngine_(){const inventory=invEngine_();return new CVCommercial.Engine(inventory.store,inventory.opening,undefined,{role:'owner',now:()=>new Date().toISOString()});}
function commercialReply_(fn){try{cvOwner_();return cvLocked_(fn);}catch(e){const known=/^[A-Z][A-Z_]+$/.test(e.message);return {error:known?e.message:'SERVER_UNAVAILABLE',retryable:!known};}}
function commercialInitialize(){return commercialReply_(()=>{const ss=cvBook_();for(const name of INV_TABS_)if(!ss.getSheetByName(name))throw Error('AUTHORIZED_LAB_SETUP_REQUIRED');return {initialized:true,epoch:CVInventory.EPOCH,commercialVersion:4};});}
function commercialExecute(c){return commercialReply_(()=>commercialEngine_().execute(c));}
function commercialStatus(id){return commercialReply_(()=>commercialEngine_().status(id));}
function commercialSnapshot(){return commercialReply_(()=>{const e=commercialEngine_(),s=e.state();s.reports=e.reports(s);for(const sale of Object.values(s.sales))if(sale.commercial)sale.financial=e.financial(s,sale.id);return s;});}
function commercialReports(period){return commercialReply_(()=>{if(!period||!/^\d{4}-\d{2}-\d{2}$/.test(period.from)||!/^\d{4}-\d{2}-\d{2}$/.test(period.to)||period.from>period.to)throw Error('INVALID_PERIOD');const e=commercialEngine_();return e.reports(e.state(),period.from,period.to);});}
function commercialSaveReport(report){return commercialReply_(()=>{if(!report||!/^commercial-browser-[a-zA-Z0-9-]+$/.test(report.run)||typeof report.passed!=='boolean'||!Array.isArray(report.results)||JSON.stringify(report).length>20000)throw Error('INVALID_REPORT');invAppend_(cvBook_(),INV_TABS_[2],{id:report.run,kind:'COMMERCIAL_REPORT',report});return {saved:true};});}
function doGet(event){cvOwner_();if(event?.parameter?.lab==='v2')return doGetPhase2_();if(event?.parameter?.lab==='v3')return doGetPhase3_(event);return HtmlService.createHtmlOutput(COMMERCIAL_HTML_).setTitle('Casa Vieja · Laboratorio comercial');}
function commercialScenario(){return commercialReply_(()=>{
 const e=commercialEngine_(),now=new Date().toISOString(),run='c4-'+Utilities.getUuid(),commands=CVCommercialScenario.commands(run,now),results=[],before=e.reports(e.state());
 const record=(name,passed)=>{results.push({name,passed:!!passed});if(!passed)throw Error('COMMERCIAL_SCENARIO_FAILED');};
 try{
  for(const command of commands){const result=e.execute(command);record(command.type+' · '+command.operationId,result.state==='COMMITTED');if(CVInventory.canonical(e.execute(command))!==CVInventory.canonical(result))throw Error('IDEMPOTENCY_TEST_FAILED');}
  const s=e.state(),after=e.reports(s);record('Ingreso neto conserva envío tras retorno de productos',after.revenueCents-before.revenueCents===700);record('Cobros y reembolsos conservan caja real',after.netCollectionsCents-before.netCollectionsCents===700);record('Costo vendido se compensa al recibir todo el producto',after.cogsCents-before.cogsCents===0);record('Compras no duplican gasto operativo',after.operatingExpenseCents-before.operatingExpenseCents===500&&after.purchasePaymentsCents-before.purchasePaymentsCents===5000);record('Resultado estimado separa distribución y publicidad',after.estimatedProfitCents-before.estimatedProfitCents===-300);
  const key=n=>'demo:'+run+'-'+n,rs=Object.values(s.resources).filter(r=>r.id.startsWith('demo:'+run+'-')),moves=s.effects.filter(m=>m.resourceId.startsWith('demo:'+run+'-'));record('Reconstrucción conserva 11000 gramos sintéticos',rs.filter(r=>r.stage!=='SUPPLY').reduce((n,r)=>n+r.physical*(r.unit==='g'?1:r.grams),0)+moves.reduce((n,m)=>n+(m.wasteGrams||0),0)===11000);record('Pedidos de ensayo no dejan reservas abiertas',rs.every(r=>r.reserved===0));
  const original=s.commerce.offers[key('single')],partial={...commands[8],operationId:run+'-partial',expectedOfferVersion:1,offer:original};let fired=false;const failing=new CVCommercial.Engine(e.store,e.opening,stage=>{if(stage==='afterPrepare'&&!fired){fired=true;throw Error('INJECTED');}},{role:'owner',now:()=>now});try{failing.execute(partial);}catch(err){if(err.message!=='INJECTED')throw err;}record('Plan comercial interrumpido conserva PREPARED',e.status(partial.operationId).state==='PREPARED');e.execute(partial);record('Reintento confirma una única versión comercial',e.state().commerce.offers[key('single')].version===2);
  return {run,passed:true,results,offerId:key('single'),offerVersion:2,resourceId:key('last-bag')};
 }catch(err){results.push({name:err.message,passed:false});return {run,passed:false,results,error:err.message};}
});}

// Las colas V3 previas continúan; una venta comercial nueva exige su protocolo financiero.
function inventoryExecute(c){return commercialReply_(()=>{const base=invEngine_();class Compatible extends CVInventory.Engine{plan(s,input){if(s.sales[input.saleId]&&s.sales[input.saleId].commercial)throw Error('COMMERCIAL_FLOW_REQUIRED');return super.plan(s,input);}}return new Compatible(base.store,base.opening).execute(c);});}
function inventorySnapshot(){return commercialReply_(()=>{const s=invEngine_().state();s.sales=Object.fromEntries(Object.entries(s.sales).filter(([id,sale])=>!sale.commercial));return s;});}
