hild(n+3) span{font-size:10px}.sale-aside .cv-summary article:nth-child(n+3) strong{font-size:16px}.sale-progress{margin:8px 0}.sale-aside .cv-help{font-size:11px}.sale-aside #draft-state{font-size:12px;line-height:1.4}}\n.customer-lookup-panel{margin-bottom:12px;background:#f1ecdf;border:1px solid #d7cebd;border-radius:8px}.customer-lookup-panel>summary{cursor:pointer;padding:10px 12px;font-size:12px;color:#526748;min-height:40px}.customer-lookup-panel .quick-customer{margin-bottom:0;padding-top:0}.customer-lookup-panel [data-apply-customer]{display:none}\n.mobile-new-order{display:none!important}@media(max-width:880px){.mobile-new-order{display:inline-flex!important}.mobile-tabs button{line-height:1.3}.mobile-tabs .nav-icon{width:19px;height:19px;display:block;margin:0 auto 2px}.mobile-tabs button span{height:22px}}\n.metric-card.loss-metric strong{color:#a33729}\n.cv-badge[data-tone=warning]{background:#f7ebcf;border-color:#b49a60;color:#80530d}.cv-badge[data-tone=error]{background:#f7e8e2;border-color:#c68f7b;color:#a33729}input,select,textarea{border-color:#8a7c66}\n@media(max-width:880px){.home-filters .btn,.chart-tabs button,#sales .sale-mode button,#sales .page-actions .btn,.customer-lookup-panel>summary,.optional-product-filters>summary{min-height:44px}.optional-product-filters>summary{line-height:44px}.home-filters .btn{padding:9px 10px}.chart-tabs button{font-size:11px}.customer-lookup-panel>summary{line-height:1.5;padding-top:12px;padding-bottom:12px}}\n</style></head><body><a class=\"skip-link btn\" href=\"#main-content\">Ir al contenido</a><div id=\"app\"><aside class=\"sidebar\"><div class=\"brand\"><div><h1>Casa Vieja</h1><span>Control de operaciones</span></div><button class=\"hamburger-btn\" id=\"menu\" aria-label=\"Abrir menú\">☰</button></div><nav class=\"navlist\" id=\"nav\"></nav><div class=\"sidebar-footer\"><p>Laboratorio privado. Solo datos ficticios.</p><p>El historial comercial original permanece separado.</p></div></aside><main class=\"main\" id=\"main-content\" tabindex=\"-1\"><div class=\"topbar\"><h2 id=\"title\">Resumen comercial</h2><span class=\"cv-badge\" id=\"connection\">Conectando</span></div><p id=\"notice\" role=\"status\" aria-live=\"polite\">Preparando el laboratorio…</p><div class=\"cv-toolbar\"><button class=\"btn secondary\" id=\"sync\">Sincronizar</button><span id=\"pending\"></span></div><section id=\"dashboard\" class=\"cv-section active\"></section><section id=\"sales\" class=\"cv-section\"></section><section id=\"orders\" class=\"cv-section\"></section><section id=\"inventory\" class=\"cv-section\"></section><section id=\"lots\" class=\"cv-section\"></section><section id=\"purchases\" class=\"cv-section\"></section><section id=\"expenses\" class=\"cv-section\"></section><section id=\"customers\" class=\"cv-section\"></section><section id=\"reports\" class=\"cv-section\"></section><section id=\"ads\" class=\"cv-section\"></section><section id=\"config\" class=\"cv-section\"></section><section class=\"card\" style=\"margin-top:20px\"><h3>Operaciones pendientes</h3><div id=\"queue\"></div></section><details class=\"card\" style=\"margin-top:14px\"><summary>Verificaciones del laboratorio</summary><p>Ensayo con datos ficticios. No habilita operaciones comerciales.</p><button class=\"btn secondary\" id=\"verify\">Verificar integración comercial</button><pre id=\"results\" style=\"white-space:pre-wrap;overflow-wrap:anywhere\"></pre></details></main></div><dialog id=\"dialog\" aria-labelledby=\"dialog-title\"><h3 id=\"dialog-title\"></h3><form id=\"dialog-form\"><div id=\"dialog-body\"></div><p id=\"dialog-error\" role=\"alert\"></p><div class=\"cv-toolbar\"><button class=\"btn\" type=\"submit\">Confirmar operación de pruebas</button><button class=\"btn secondary\" type=\"button\" id=\"dialog-cancel\">Cerrar</button></div></form></dialog><nav class=\"mobile-tabs\" aria-label=\"Accesos rápidos\"><button data-view=\"dashboard\"><span aria-hidden=\"true\">⌂</span>Inicio</button><button data-view=\"sales\"><span aria-hidden=\"true\">＋</span>Ventas</button><button data-view=\"orders\"><span aria-hidden=\"true\">▤</span>Pedidos</button><button data-view=\"inventory\"><span aria-hidden=\"true\">▦</span>Inventario</button><button id=\"more-mobile\"><span aria-hidden=\"true\">☰</span>Más</button></nav><dialog id=\"sale-dialog\" aria-labelledby=\"sale-dialog-title\"><div class=\"sale-modal-head\"><h3 id=\"sale-dialog-title\">Registrar venta</h3><button class=\"btn secondary\" id=\"close-sale-modal\" type=\"button\">Cerrar</button></div><div id=\"sale-modal-body\"></div></dialog><script>/* Cola transaccional. Un documento IndexedDB por dispositivo/cuenta/destino. */\n(function(root,factory){const api=factory();if(typeof module==='object'&&module.exports)module.exports=api;else root.CVClient=api;})(typeof globalThis==='object'?globalThis:this,function(){\n'use strict';\nconst copy=x=>JSON.parse(JSON.stringify(x));\nconst empty=()=>({generation:0,queue:[],archived:[],receipts:{},snapshot:null,deviceId:null});\nclass Client{\n constructor(store,transport,destination,uuid){this.store=store;this.transport=transport;this.destination=destination;this.uuid=uuid;this.running=null;}\n async enqueue(payload){let saved;await this.store.transact(s=>{s.deviceId=s.deviceId||this.uuid();const command=Object.assign({},copy(payload),{operationId:this.uuid(),deviceId:s.deviceId,epoch:this.destination,schemaVersion:2});saved=copy(command);s.queue.push({command,state:'PENDING',lastError:''});s.generation++;});return {queued:true,confirmed:false,command:saved};}\n async view(){return this.store.read();}\n async archiveRejected(operationId){\n  const entry=(await this.store.read()).queue.find(x=>x.command.operationId===operationId);if(!entry||entry.state!=='REJECTED')throw Error('REJECTED_REQUIRED');\n  const result=await this.transport.status(operationId);if(!result||result.epoch!==this.destination||result.operationId!==operationId||result.state!=='REJECTED')throw Error('UNRESOLVED_SERVER_STATE');\n  await this.store.transact(s=>{const item=s.queue.find(x=>x.command.operationId===operationId);if(!item||item.state!=='REJECTED')throw Error('QUEUE_CHANGED');s.archived=s.archived||[];s.archived.push({...item,serverRejection:copy(result),resolution:'SERVER_REJECTED_NO_SALE_EFFECT'});s.queue=s.queue.filter(x=>x!==item);s.generation++;});\n }\n validAck(r,c){return r&&r.epoch===this.destination&&r.operationId===c.operationId&&r.saleId===c.saleId&&r.state==='COMMITTED'&&Number.isSafeInteger(r.revision)&&r.revision>0&&Number.isSafeInteger(r.saleVersion);}\n async ack(r,c){if(!this.validAck(r,c))throw Error('INVALID_ACK');await this.store.transact(s=>{s.receipts[c.operationId]=copy(r);s.queue=s.queue.filter(x=>x.command.operationId!==c.operationId);s.generation++;});}\n flush(){if(!this.running)this.running=this.drain().finally(()=>this.running=null);return this.running;}\n async drain(){\n  while(true){const s=await this.store.read(),item=s.queue[0];if(!item||item.state==='REJECTED')return;\n   const c=item.command;\n   try{\n    let r=await this.transport.status(c.operationId);\n    if(!r||r.epoch!==this.destination||r.operationId!==c.operationId)throw Error('INVALID_STATUS');\n    if(r.state==='UNKNOWN'||r.state==='PREPARED')r=await this.transport.execute(c);\n    if(r&&r.error){const error=Error(r.error);error.permanent=r.retryable===false;throw error;}\n    await this.ack(r,c);\n   }catch(e){await this.store.transact(state=>{const entry=state.queue.find(x=>x.command.operationId===c.operationId);if(entry){entry.lastError=e.message;entry.state=e.permanent?'REJECTED':'PENDING';}state.generation++;});return;}\n  }\n }\n async refresh(){const start=await this.store.read();if(start.queue.length)return false;const snap=await this.transport.snapshot();if(!snap||snap.epoch!==this.destination||!Number.isSafeInteger(snap.revision))return false;let applied=false;await this.store.transact(s=>{const minRevision=Math.max(s.snapshot?s.snapshot.revision:0,...Object.values(s.receipts).map(x=>x.revision));if(!s.queue.length&&s.generation===start.generation&&snap.revision>=minRevision){s.snapshot=copy(snap);s.generation++;applied=true;}});return applied;}\n}\nclass IndexedStore{\n constructor(name){this.name=name;this.dbPromise=null;}\n db(){if(!this.dbPromise)this.dbPromise=new Promise((resolve,reject)=>{const r=indexedDB.open(this.name,1);r.onupgradeneeded=()=>r.result.createObjectStore('state');r.onsuccess=()=>resolve(r.result);r.onerror=()=>reject(r.error);r.onblocked=()=>reject(Error('STORAGE_BLOCKED'));});return this.dbPromise;}\n async read(){const db=await this.db();return new Promise((resolve,reject)=>{const tx=db.transaction('state','readonly');const req=tx.objectStore('state').get('current');let value;req.onsuccess=()=>value=copy(req.result||empty());tx.oncomplete=()=>resolve(value);tx.onerror=tx.onabort=()=>reject(tx.error||Error('STORAGE_FAILED'));});}\n async transact(fn){const db=await this.db();return new Promise((resolve,reject)=>{const tx=db.transaction('state','readwrite'),store=tx.objectStore('state');let failure;const req=store.get('current');req.onsuccess=()=>{try{const s=copy(req.result||empty());fn(s);store.put(s,'current');}catch(e){failure=e;tx.abort();}};tx.oncomplete=()=>resolve();tx.onerror=tx.onabort=()=>reject(failure||tx.error||Error('STORAGE_FAILED'));});}\n}\nreturn {Client,IndexedStore,empty};\n});\n\n/* Inspección de solo lectura del origen actual. No crea, borra ni transforma bases antiguas. */\n(function(root,factory){const api=factory();if(typeof module==='object'&&module.exports)module.exports=api;else root.CVContinuity=api;})(typeof globalThis==='object'?globalThis:this,function(){\n'use strict';\nconst versions=Object.freeze([\n {name:'cv-sales-sandbox-v2-owner',engine:'V2',epoch:'TEST_ONLY_V2'},\n {name:'cv-inventory-sandbox-v3-owner',engine:'V3',epoch:'TEST_ONLY_V3'},\n {name:'cv-commercial-sandbox-v4-owner',engine:'V4',epoch:'TEST_ONLY_V3'},\n {name:'cv-commercial-sandbox-v5a-owner',engine:'V4',epoch:'TEST_ONLY_V3'}\n]);\nconst clone=x=>JSON.parse(JSON.stringify(x));\nfunction describe(version,data,origin){\n if(!data)return {...version,origin,status:'EMPTY',pending:[],receiptCount:0};\n if(!Array.isArray(data.queue)||!data.receipts||typeof data.receipts!=='object')return {...version,origin,status:'UNREADABLE',pending:[],receiptCount:0};\n const pending=data.queue.map(q=>({operationId:q.command?.operationId,saleId:q.command?.saleId,epoch:q.command?.epoch,schemaVersion:q.command?.schemaVersion,commercialVersion:q.command?.commercialVersion,state:q.state,deviceId:q.command?.deviceId,engine:version.engine}));\n const invalid=pending.some(p=>typeof p.operationId!=='string'||p.epoch!==version.epoch||p.schemaVersion!==2||(version.engine==='V4'&&p.commercialVersion!==4)||!['PENDING','REJECTED'].includes(p.state));\n return {...version,origin,status:invalid?'INCOMPATIBLE':pending.length?'UNRESOLVED':'CLEAR',pending,receiptCount:Object.keys(data.receipts).length};\n}\nasync function scan({list,read,origin,otherOriginsConfirmed=false}){\n let databases;try{databases=await list();}catch(e){return {origin,blocked:true,reason:'ENUMERATION_UNAVAILABLE',databases:[],otherOriginsConfirmed:false};}\n const names=new Set(databases.map(x=>typeof x==='string'?x:x.name)),results=[];\n for(const v of versions){if(!names.has(v.name)){results.push({...v,origin,status:'ABSENT',pending:[],receiptCount:0});continue;}try{results.push(describe(v,await read(v.name),origin));}catch(e){results.push({...v,origin,status:'UNREADABLE',pending:[],receiptCount:0});}}\n // Bases de ensayos y futuras versiones también pueden contener una cola: no ocultarlas.\n for(const name of names)if(name&&!versions.some(v=>v.name===name)&&/^cv-|^(inventory|commercial)-browser-/.test(name)){try{const data=await read(name);if(data?.queue?.length)results.push({name,origin,status:'UNKNOWN_QUEUE',pending:data.queue.map(q=>({operationId:q.command?.operationId,state:q.state})),receiptCount:Object.keys(data.receipts||{}).length});}catch(e){results.push({name,origin,status:'UNREADABLE',pending:[],receiptCount:0});}}\n const unresolved=results.some(d=>!['CLEAR','EMPTY','ABSENT'].includes(d.status));\n return {origin,blocked:unresolved||!otherOriginsConfirmed,reason:unresolved?'UNRESOLVED_QUEUES':otherOriginsConfirmed?'CLEAR_THIS_ORIGIN':'OTHER_ORIGINS_NOT_ATTESTED',otherOriginsConfirmed,databases:results};\n}\nfunction browserAdapter(indexedDB,origin){return {origin,list:()=>{if(typeof indexedDB.databases!=='function')throw Error('ENUMERATION_UNAVAILABLE');return indexedDB.databases();},read:name=>new Promise((resolve,reject)=>{const r=indexedDB.open(name);let absent=false;r.onupgradeneeded=()=>{absent=true;r.transaction.abort();};r.onerror=()=>absent?resolve(null):reject(Error('STORAGE_UNREADABLE'));r.onblocked=()=>reject(Error('STORAGE_BLOCKED'));r.onsuccess=()=>{const db=r.result;if(db.version!==1||!db.objectStoreNames.contains('state')){db.close();reject(Error('STORAGE_VERSION_UNSUPPORTED'));return;}const tx=db.transaction('state','readonly'),req=tx.objectStore('state').get('current');let value;req.onsuccess=()=>value=req.result;tx.oncomplete=()=>{db.close();resolve(value||null)};tx.onerror=tx.onabort=()=>{db.close();reject(Error('STORAGE_UNREADABLE'))};};})};}\nasync function recoverConfirmation({entry,version,transport,client}){\n if(entry.command.epoch!==version.epoch||entry.command.schemaVersion!==2||(version.engine==='V4'&&entry.command.commercialVersion!==4))throw Error('INCOMPATIBLE_ENGINE');\n const original=JSON.stringify(entry.command),r=await transport.status(entry.command.operationId);\n if(!r||r.epoch!==entry.command.epoch||r.operationId!==entry.command.operationId)throw Error('UNVERIFIED_STATUS');\n if(r.state==='COMMITTED'){if(r.saleId!==entry.command.saleId)throw Error('UNVERIFIED_STATUS');await client.ack(r,clone(entry.command));return {confirmed:true,receipt:r};}\n // UNKNOWN/PREPARED no prueba ausencia de venta. Reintentar solamente en su mo