es=function(){previousEnhanceSales();const box=$('sale-form')?.querySelector('.quick-customer');if(box&&!$('customer-lookup')){box.insertAdjacentHTML('afterbegin','<label>Buscar cliente<input id=\"customer-lookup\" type=\"search\" placeholder=\"Nombre o teléfono ficticio\" autocomplete=\"off\"></label>');}};\ndocument.addEventListener('input',e=>{if(e.target.id==='customer-lookup')filterExistingCustomers(e.target.value);});\nconst lookupEnhance=enhanceSales;enhanceSales=function(){lookupEnhance();const box=$('sale-form')?.querySelector('.quick-customer');if(box&&!box.closest('.customer-lookup-panel')){const detail=document.createElement('details');detail.className='customer-lookup-panel';detail.innerHTML='<summary>Recuperar datos de un cliente existente</summary>';box.before(detail);detail.append(box);}};\ndocument.addEventListener('change',e=>{if(e.target.id==='existing-customer'&&e.target.value)document.querySelector('[data-apply-customer]')?.click();});\ndocument.addEventListener('keydown',e=>{if(e.target.id==='customer-lookup'&&e.key==='Enter'){e.preventDefault();const select=$('existing-customer');if(select.options.length===2){select.value=select.options[1].value;document.querySelector('[data-apply-customer]')?.click();}}});\nconst mobileNewOrderEnhance=enhanceSales;enhanceSales=function(){mobileNewOrderEnhance();const actions=$('sales')?.querySelector('.page-actions');if(actions&&!actions.querySelector('.mobile-new-order'))actions.insertAdjacentHTML('beforeend','<button type=\"button\" class=\"btn secondary mobile-new-order\" data-new-order>Nuevo pedido</button>');};\nfunction connectionTone(){const el=$('connection'),text=el.textContent||'';el.dataset.tone=/Pendiente|Última copia|Conectando/.test(text)?'warning':/Sin confirmación/.test(text)?'error':'positive';}new MutationObserver(connectionTone).observe($('connection'),{childList:true,characterData:true,subtree:true});connectionTone();\nlet draftStatusObserver=null;const statusEnhance=enhanceSales;enhanceSales=function(){statusEnhance();if(draftStatusObserver)draftStatusObserver.disconnect();if($('draft-state')){draftStatusObserver=new MutationObserver(updateMobileStatus);draftStatusObserver.observe($('draft-state'),{childList:true,characterData:true,subtree:true});updateMobileStatus();}};\nconst contextualChangeView=changeView;changeView=async function(name){await contextualChangeView(name);notice(/^\\d+/.test($('pending').textContent||'')?'Hay operaciones pendientes de confirmación. Se conservan en la cola.':'Laboratorio local · datos ficticios. Consulta el estado de cada pedido.');};\ndocument.addEventListener('click',e=>{if(e.target.closest('[data-new-order]'))notice(/^\\d+/.test($('pending').textContent||'')?'Nuevo borrador. Las operaciones anteriores pendientes siguen en la cola.':'Nuevo borrador · todavía no enviado al servidor.');});\n","sha256":"84d129e8c16b9b316d7ee2466fdc21621af82426cf96c27076136c45e0840d41"},{"path":"fase5b/apps-script/Benchmark.gs","content":"// Solo editor de laboratorio: no invocable mediante google.script.run.\nfunction phase5bBenchmark_(){\n cvOwner_();return cvLocked_(()=>{\n const start=Date.now(),e=commercialEngine_(),loaded=Date.now(),s=e.state(),replayed=Date.now(),report=e.reports(s),reported=Date.now();\n const result={id:'phase5b-'+Utilities.getUuid(),kind:'PERFORMANCE_5B',environment:'TEST_ONLY',measuredAt:new Date().toISOString(),journalRows:e.store.readJournal().length,effectRows:e.store.readEffects().length,revision:s.revision,loadMs:loaded-start,replayMs:replayed-loaded,reportsMs:reported-replayed,totalMs:reported-start,passed:Number.isSafeInteger(s.revision),productionAccess:false};\n invAppend_(cvBook_(),'VerificacionesInventarioV3',result);console.log(JSON.stringify(result));return result;\n });\n}\nfunction phase5bRestoreTest_(){\n cvOwner_();return cvLocked_(()=>{\n const source=cvBook_(),props=PropertiesService.getScriptProperties(),key='PHASE5B_RESTORE_SHEET_ID';let destination=props.getProperty(key),ss;\n if(!destination){ss=SpreadsheetApp.create('CasaVieja_RECUPERACION_TEST_ONLY_5B');destination=ss.getId();props.setProperty(key,destination);ss.getSheets()[0].setName('Control');ss.getSheetByName('Control').getRange(1,1,3,2).setValues([['Campo','Valor'],['Entorno','SINTETICO'],['Identificador','TEST_ONLY']]);}else ss=SpreadsheetApp.openById(destination);\n if(destination===source.getId()||ss.getName()!=='CasaVieja_RECUPERACION_TEST_ONLY_5B'||ss.getSheetByName('Control').getRange('B3').getValue()!=='TEST_ONLY')throw Error('RESTORE_DESTINATION');\n const j=invRead_(source,INV_TABS_[0]),effects=invRead_(source,INV_TABS_[1]);\n const hash=x=>Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,CVInventory.canonical(x),Utilities.Charset.UTF_8));\n // Copia de filas, nunca ejecución de comandos: no genera nuevos consumos.\n for(const [index,rows]of [[0,j],[1,effects]]){\n  const name=INV_TABS_[index];let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);\n  if(sh.getLastRow()===0)sh.appendRow(['ID','Tipo','JSON']);\n  const existing=invRead_(ss,name);if(existing.length>rows.length||existing.some((r,i)=>CVInventory.canonical(r)!==CVInventory.canonical(rows[i])))throw Error('RESTORE_NONEMPTY_CONFLICT');\n  if(existing.length<rows.length)sh.getRange(existing.length+2,1,rows.length-existing.length,3).setValues(rows.slice(existing.length).map(r=>[r.id,r.kind,JSON.stringify(r)]));\n }\n SpreadsheetApp.flush();const restoredJ=invRead_(ss,INV_TABS_[0]),restoredE=invRead_(ss,INV_TABS_[1]);\n if(hash([j,effects])!==hash([restoredJ,restoredE]))throw Error('RESTORE_READBACK');\n const memory=(journal,movements)=>new CVCommercial.Engine({readJournal:()=>journal,readEffects:()=>movements});\n const before=memory(j,effects).state(),after=memory(restoredJ,restoredE).state();if(CVInventory.canonical(before)!==CVInventory.canonical(after))throw Error('RESTORE_STATE_MISMATCH');\n if(hash([j,effects])!==hash([invRead_(source,INV_TABS_[0]),invRead_(source,INV_TABS_[1])]))throw Error('SOURCE_CHANGED');\n const result={id:'restore5b-'+Utilities.getUuid(),kind:'RESTORE_5B',environment:'TEST_ONLY',destinationId:destination,revision:after.revision,journalRows:j.length,effectRows:effects.length,sha256Base64:hash([j,effects]),passed:true,sourceUnchanged:true,measuredAt:new Date().toISOString()};\n invAppend_(source,INV_TABS_[2],result);console.log(JSON.stringify(result));return result;\n });\n}\n// Entrada ya existente del laboratorio para el selector bloqueado del editor.\n// No se incluye en Candidate.gs y no se publica una nueva versión web.\nfunction sandboxExecute(command){if(command!==undefined)return sandboxExecuteBefore5B_(command);phase5bBenchmark_();phase5bWriteTest_();phase5bRestoreTest_();return phase5bBenchmark_();}\nfunction phase5bWriteTest_(){\n cvOwner_();return cvLocked_(()=>{\n const engine=commercialEngine_(),journal=engine.store.readJournal(),effects=engine.store.readEffects(),id='safe5b-'+Utilities.getUuid(),now=new Date().toISOString();\n const command={epoch:'TEST_ONLY_V3',schemaVersion:2,commercialVersion:4,operationId:id,deviceId:'lab-editor-5b',saleId:'future:'+id,type:'RECEIVE_SUPPLY',date:now,responsible:'Ensayo sintético Fase 5B',resourceId:'demo:'+id,lotId:'demo:lot-'+id,supplyKind:'LABEL',qty:2,totalCostCents:0};\n const start=Date.now(),result=engine.execute(command),confirmed=Date.now(),retry=engine.execute(command),retried=Date.now(),state=engine.state();\n const prefix=(a,b)=>CVInventory.canonical(a)===CVInventory.canonical(b.slice(0,a.length));\n if(result.state!=='COMMITTED'||CVInventory.canonical(result)!==CVInventory.canonical(retry)||state.resources[command.resourceId].physical!==2||!prefix(journal,engine.store.readJournal())||!prefix(effects,engine.store.readEffects()))throw Error('WRITE_5B_FAILED');\n const report={id,kind:'WRITE_5B',environment:'TEST_ONLY',passed:true,executeMs:confirmed-start,retryMs:retried-confirmed,revision:state.revision,originalPrefixPreserved:true,effectsAdded:engine.store.readEffects().length-effects.length,operationId:id,measuredAt:now};invAppend_(cvBook_(),INV_TABS_[2],report);console.log(JSON.stringify(report));return report;\n });\n}\n","sha256":"a239a317a0e59767a71b120558c8598db63ccdcf8bf3ecfa950d45e267111740"},{"path":"fase5b/apps-script/ReadApi.gs","content":"// Página coherente con una revisión. No sustituye aún el snapshot de la interfaz.\nfunction commercialPage(request){return commercialReply_(()=>{\n if(!request||!['sales','effects','events'].includes(request.collection)||!Number.isSafeInteger(request.offset)||request.offset<0||!Number.isSafeInteger(request.limit)||request.limit<1||request.limit>100)throw Error('INVALID_PAGE');\n const s=commercialEngine_().state();if(request.revision!==undefined&&request.revision!==s.revision)throw Error('REVISION_CHANGED');\n const rows=request.collection==='sales'?Object.values(s.sales):request.collection==='effects'?s.effects:s.commerce.events;\n return {epoch:s.epoch,revision:s.revision,total:rows.length,offset:request.offset,next:request.offset+request.limit<rows.length?request.offset+request.limit:null,rows:rows.slice(request.offset,request.offset+request.limit)};\n});}\n","sha256":"58db6eb9b7ee079ef23ceefb25c3182ecd140ecfb9c745098030a164086a1851"},{"path":"fase5b/backup.cjs","content":"'use strict';\n// Archivo local de laboratorio: no contiene conectores ni destinos de producción.\nconst crypto=require('node:crypto'),{Engine}=require('../fase4/commercial.js'),{canonical,clone,EPOCH}=require('../fase3/journal.js');\nconst digest=x=>crypto.createHash('sha256').update(canonical(x)).digest('hex');\nfunction inspect(payload){\n if(payload.format!=='CV_BACKUP_1'||payload.epoch!==EPOCH||payload.environment!=='TEST_ONLY')throw Error('BACKUP_PROTOCOL');\n const store={readJournal:()=>clone(payload.journal),readEffects:()=>clone(payload.effects)};\n const engine=new Engine(store);const state=engine.state();\n const prepared=new Map(engine.records().filter(r=>r.kind==='PREPARED').map(r=>[r.id,r]));\n for(const effect of engine.effects()){const p=prepared.get(effect.operationId);if(!p||!p.plan.effects.some(e=>canonical(e)===canonical(effect)))throw Error('ORPHAN_EFFECT');}\n for(const p of prepared.values())if(p.fingerprint!==canonical(p.command))throw Error('FINGERPRINT_MISMATCH');\n return {revision:state.revision,pending:[...prepared.keys()].filter(id=>engine.status(id).state==='PREPARED'),state};\n}\nfunction backup(store){const payload={format:'CV_BACKUP_1',environment:'TEST_ONLY',epoch:EPOCH,journal:clone(store.readJournal()),effects:clone(store.readEffects())};inspect(payload);return {payload,sha256:digest(payload)};}\nfunction verify(archive){if(!archive||digest(archive.payload)!==archive.sha256)throw Error('BACKUP_CHECKSUM');return inspect(archive.payload);}\nfunction restore(archive,target){\n verify(archive);\n if(target.environment!=='TEST_ONLY'||target.sourceId===target.destinationId||!target.destinationId)throw Error('RESTORE_DESTINATION');\n // La repetición solo valida una restauración idéntica; nunca fusiona ni sobrescribe.\n const j=target.readJournal(),e=target.readEffects();\n if(j.length||e.length){if(canonical(j)===canonical(archive.payload.journal)&&canonical(e)===canonical(archive.payload.effects))return {alreadyRestored:true,...verify(archive)};throw Error('RESTORE_REQUIRES_EMPTY_DESTINATION');}\n target.writeEmpty(clone(archive.payload.journal),clone(archive.payload.effects));\n if(canonical(target.readJournal())!==canonical(archive.payload.journal)||canonical(target.readEffects())!==canonical(archive.payload.effects))throw Error('RESTORE_READBACK');\n return {alreadyRestored:false,...verify(archive)};\n}\nmodule.exports={backup,verify,restore,digest};\n","sha256":"958383971770f4800811ef7f08136c9463993aaede6c7cb0136036d8ff031d66"},{"path":"fase5b/build.cjs","content":"'use strict';\nconst fs=require('node:fs'),path=require('node:path');const root=__dirname,read=p=>fs.readFileSync(path.join(root,p),'utf8');\nconst guard=read('../fase2/apps-script/Server.gs').split('function cvReadRows_')[0];\nconst inventory=read('../fase3/apps-script/Server.gs').split('function invReply_')[0];\nlet routes=read('../fase4/apps-script/Server.gs').split('function commercialSaveReport')[0];\nconst html=read('../fase5a/apps-script/Index.html');\nconst code=[guard,read('../fase3/journal.js'),read('../fase3/inventory.js'),read('../fase4/commercial.js'),inventory,routes,read('apps-script/ReadApi.gs'),\"function doGet(){cvOwner_();return HtmlService.createHtmlOutput(COMMERCIAL_HTML_).setTitle('Casa Vieja · Candidato restringido de laboratorio');}\",'const COMMERCIAL_HTML_='+JSON.stringify(html)+';'].join('\\n');\nconst allowed=['commercialInitialize','commercialExecute','commercialStatus','commercialSnapshot','commercialReports','commercialPage','doGet'];\nconst vm=require('node:vm'),scope=vm.createContext({});vm.runInContext(code,scope);const exposed=Object.keys(scope).filter(n=>typeof scope[n]==='function'&&!n.endsWith('_'));\nif(exposed.some(n=>!allowed.includes(n)))throw Error('UNEXPECTED_RPC:'+exposed);\nfs.writeFileSync(path.join(root,'apps-script/Candidate.gs'),code);\nfs.writeFileSync(path.join(root,'apps-script/rpc-manifest.json'),JSON.stringify({environment:'TEST_ONLY',deployableToProduction:false,ownerOnly:true,exposed,maintenanceIncluded:false,legacyRPCIncluded:false},null,2)+'\\n');\n// Proyecto de prueba: conserva escenarios; no se cambia el despliegue privado.\nfs.writeFileSync(path.join(root,'apps-script/Laboratory.gs'),read('../fase5a/apps-script/Code.gs').replace('function sandboxExecute(command){','function sandboxExecuteBefore5B_(command){')+'\\n'+read('apps-script/ReadApi.gs')+'\\n'+read('apps-script/Benchmark.gs'));\nconsole.log(JSON.stringify({exposed,productionEnabled:false}));\n","sha256":"08a48bfa3db4c04f1b4adb41882fb974e0423712a97d53ca900cac5184ec3135"},{"path":"fase5c/access.js","content":"/* Autorización en servidor. Los perfiles nunca se obtienen del comando del navegador. */\n(function(root,factory){const api=factory(typeof module==='object'&&module.exports?require('../fase4/commercial.js'):root.CVCommercial,typeof module==='object'&&module.exports?require('../fase3/journal.js'):root.CVInventoryBase);if(typeof module==='object'&&module.exports)module.exports=api;else root.CVAccess=api;})(typeof globalThis==='object'?globalThis:this,function(C,B){\n'use strict';const {clone,canonical}=B,fail=code=>{throw Error(code)},check=(ok,code)=>{if(!ok)fail(code)};\nconst roles=Object.freeze({administrator:['*'],sales:['REGISTER_SALE','RESERVE_SALE','EDIT_SALE','CANCEL_SALE'],inventory:['PREPARE_BAGS']});\nconst forbidden=['role','roles','permissions','actor','actorId','subject','audit','authenticatedUser'];\nfunction principal(subject,bindings){check(typeof subject==='string'&&subject.length>0&&subject.length<=160,'IDENTITY_REQUIRED');const binding=Object.hasOwn(bindings,subject)?bindings[subject]:null;check(binding&&binding.active===true&&Object.hasOwn(roles,binding.role),'ACCESS_DENIED');return Object.freeze({subject,role:binding.role});}\nfunction own(engine,actor,operationId){const records=engine.records(),p=records.find(x=>x.id===operationId&&['PREPARED','REJECTED'].includes(x.kind));if(p&&actor.role!=='administrator')check((p.plan?.audit||p.audit)?.subject===actor.subject,'ACCESS_DENIED');return p;}\nfunction saleOwned(engine,actor,sale){if(actor.role==='administrator')return;check(sale,'ACCESS_DENIED');const p=engine.records().find(p=>p.kind==='PREPARED'&&p.id===sale.originOperationId);check(p?.plan?.audit?.subject===actor.subject,'ACCESS_DENIED');}\nclass Engine extends C.Engine{\n constructor(store,opening,hook,context){check(context&&context.actor&&context.now,'IDENTITY_REQUIRED');const trustedStore={readJournal:()=>store.readJournal(),readEffects:()=>store.readEffects(),appendEffect:r=>store.appendEffect(r),appendJournal:r=>store.appendJournal(r.kind==='REJECTED'?{...r,audit:{subject:context.actor.subject,role:context.actor.role,serverAt:context.now()}}:r)};super(trustedStore,opening,hook,{role:'owner',now:context.now});this.actor=context.actor;this.policy=context.policy||{};this.financialIndexes=new WeakMap();}\n execute(c){check(c&&typeof c==='object','INVALID_COMMAND');check(!forbidden.some(k=>Object.hasOwn(c,k)),'IDENTITY_SPOOFING');own(this,this.actor,c.operationId);return super.execute(c);}\n plan(s,input){const actor=this.actor,allowed=roles[actor.role];check(allowed&&(allowed.includes('*')||allowed.includes(input.type)),'PERMISSION_DENIED');\n  const c=clone(input),serverAt=this.context.now();c.responsible=actor.subject;c.date=serverAt;\n  if(actor.role==='sales'){\n   check(!['totalCents','costCents','profitCents','deliveryCostCents','deliveryChargedCents','discountCents','authorizationId','lines'].some(k=>Object.hasOwn(c,k)),'FINANCIAL_FIELDS_FORBIDDEN');\n   if(['REGISTER_SALE','RESERVE_SALE'].includes(c.type)){const shipping=this.policy.shippingByZone?.[c.customer?.zone||''];check(shipping&&Number.isSafeInteger(shipping.costCents)&&shipping.costCents>=0&&Number.isSafeInteger(shipping.chargedCents)&&shipping.chargedCents>=0,'SHIPPING_POLICY_REQUIRED');c.deliveryCostCents=shipping.costCents;c.deliveryChargedCents=shipping.chargedCents;}\n   else saleOwned(this,actor,s.sales[c.saleId]);\n  }\n  if(actor.role==='inventory'){\n   check(!['processingCents','acquisitionCents','totalCostCents','freightCents'].some(k=>Object.hasOwn(c,k)),'FINANCIAL_FIELDS_FORBIDDEN');\n   const recipe=this.policy.preparationByGrams?.[c.bagGrams];check(recipe&&Number.isSafeInteger(recipe.processingPerBagCents)&&recipe.processingPerBagCents>=0,'RECIPE_POLICY_REQUIRED');c.processingCents=B.uint(recipe.processingPerBagCents*c.bags);c.documentRef='PREP:'+c.operationId;\n  }\n  const plan=super.plan(s,c);plan.audit={subject:actor.subject,role:actor.role,serverAt,submittedAt:input.date,operationId:input.operationId,type:input.type};for(const event of plan.commerceEvents||[])event.actorRole=actor.role;return plan;\n }\n status(id){own(this,this.actor,id);return super.status(id);}\n // Recuperación interna de planes ya autorizados, sin exponer confirmaciones ajenas.\n finish(p){const actor=this.actor;this.actor={subject:actor.subject,role:'administrator'};try{return super.finish(p)}finally{this.actor=actor}}\n financial(s,saleId){let index=this.financialIndexes.get(s);if(!index){index=new Map();for(const e of s.commerce.events){if(!index.has(e.saleId))index.set(e.saleId,[]);index.get(e.saleId).push(e)}this.financialIndexes.set(s,index)}const sale=s.sales[saleId],events=index.get(saleId)||[],sum=k=>events.filter(e=>e.kind===k).reduce((n,e)=>n+e.amountCents,0),credit=sum('RETURN_CREDIT'),due=sale?.status==='CANCELLED'?0:(sale?.totalCents||0)+(sale?.deliveryChargedCents||0)-credit,paid=sum('PAYMENT'),refunded=sum('REFUND');return {dueCents:due,paidCents:paid,refundedCents:refunded,cashCents:paid-refunded,outstandingCents:Math.max(0,due-paid+refunded),refundableCents:Math.max(0,paid-refunded-due)};}\n}\nfunction snapshot(engine,{offset=0,limit=50,revision}={}){check(Number.isSafeInteger(offset)&&offset>=0&&Number.isSafeInteger(limit)&&limit>0&&limit<=100,'INVALID_PAGE');const s=engine.state(),actor=engine.actor;check(revision===undefined||revision===s.revision,'REVISION_CHANGED');\n if(actor.role==='administrator'){s.reports=engine.reports(s);for(const sale of Object.values(s.sales))if(sale.commercial)sale.financial=engine.financial(s,sale.id);return s;}\n const resources=Object.values(s.resources).filter(r=>actor.role==='inventory'||r.stage==='PACKAGED').map(r=>Object.fromEntries(['id','product','lot','stage','family','grind','grams','unit','physical','reserved','qty','supplyKind'].filter(k=>r[k]!==undefined).map(k=>[k,r[k]])));\n const sales=actor.role==='sales'?Object.values(s.sales).filter(sale=>{try{saleOwned(engine,actor,sale);return true}catch(e){return false}}).map(sale=>({id:sale.id,version:sale.version,status:sale.status,totalCents:sale.totalCents,deliveryChargedCents:sale.deliveryChargedCents,metadata:clone(sale.metadata),lines:sale.lines.map(l=>Object.fromEntries(['resourceId','qty','lot','family','grind','grams','returned'].map(k=>[k,l[k]])))})):[];\n const offers=actor.role==='sales'?Object.values(s.commerce.offers).filter(o=>o.active).map(o=>Object.fromEntries(['id','name','family','grind','grams','bags','priceCents','validFrom','validUntil','version'].map(k=>[k,o[k]]))):[];\n return {epoch:s.epoch,revision:s.revision,profile:actor.role,resources:resources.slice(offset,offset+limit),sales:sales.slice(offset,offset+limit),offers:offers.slice(offset,offset+limit),next:Math.max(resources.length,sales.length,offers.length)>offset+limit?offset+limit:null};\n}\nreturn {roles,principal,Engine,snapshot,canonical};\n});\n","sha256":"76dd5684b0bd9c5024bce9f9e442153458e9bc4cc4dd1a2b7005ed58dedb6cf2"},{"path":"fase5c/apps-script/Gateway.gs","content":"// Todo el acceso nuevo exige identidad nativa del propietario o prueba firmada del proxy.\n// El modo externo permanece apagado. No hay RPC de administración de usuarios.\nfunction cv5cProof_(envelope,configuration){\n const c=configuration||{enabled:PropertiesService.getScriptProperties().getProperty('PHASE5C_AUTH_MODE')==='SIGNED_GATEWAY',secret:PropertiesService.getScriptProperties().getProperty('PHASE5C_GATEWAY_SECRET'),now:Date.now()};\n if(!c.enabled||!c.secret||c.secret.length<32||!envelope?.request||typeof envelope.mac!=='string'||JSON.stringify(envelope).length>32000)throw Error('IDENTITY_REQUIRED');\n const r=envelope.request,expected=Utilities.base64Encode(Utilities.computeHmacSha256Signature(CVInventoryBase.canonical(r),c.secret,Utilities.Charset.UTF_8));\n let different=expected.length^envelope.mac.length;for(let i=0;i<expected.length;i++)different|=expected.charCodeAt(i)^(envelope.mac.charCodeAt(i)||0);if(different)throw Error('IDENTITY_REQUIRED');\n if(r.version!==1||r.destination!=='TEST_ONLY_V3'||!Number.isSafeInteger(r.issuedAt)||!Number.isSafeInteger(r.expiresAt)||r.issuedAt>c.now+30000||r.expiresAt<=c.now||r.expiresAt-r.issuedAt>60000||typeof r.subject!=='string'||!/^google:[0-9]{5,64}$/.test(r.subject)||typeof r.requestId!=='string'||r.requestId.length>120)throw Error('IDENTITY_REQUIRED');\n return r;\n}\nfunction cv5cBindings_(){const raw=PropertiesService.getScriptProperties().getProperty('PHASE5C_ROLE_BINDINGS');if(!raw)throw Error('ACCESS_DENIED');return JSON.parse(raw);}\nfunction cv5cEngine_(actor,policy){const base=invEngine_();return new CVAccess.Engine(base.store,base.opening,undefined,{actor,policy:policy||{},now:()=>new Date().toISOString()});}\nfunction cv5cPolicy_(){return JSON.parse(PropertiesService.getScriptProperties().getProperty('PHASE5C_APPROVED_POLICY')||'{}');}\nfunction cv5cDispatch_(request,actor,policy){\n if(request.action==='bootstrap')return {subject:actor.subject,profile:actor.role,capabilities:CVAccess.roles[actor.role],epoch:'TEST_ONLY_V3',commercialVersion:4,release:CV5C_RELEASE_};\n const e=cv5cEngine_(actor,policy);\n if(request.action==='execute')return e.execute(request.payload);\n if(request.action==='status')return e.status(request.payload);\n if(request.action==='snapshot')return CVAccess.snapshot(e,request.payload||{});\n if(request.action==='dashboard'){if(actor.role!=='administrator')throw Error('PERMISSION_DENIED');const p=request.payload;if(!p||!/^\\d{4}-\\d{2}-\\d{2}$/.test(p.from)||!/^\\d{4}-\\d{2}-\\d{2}$/.test(p.to)||p.from>p.to||!/^\\d{4}-\\d{2}-\\d{2}$/.test(p.today)||!Array.isArray(p.days)||p.days.length>7||!p.days.every(d=>/^\\d{4}-\\d{2}-\\d{2}$/.test(d)&&d>=p.from&&d<=p.to))throw Error('INVALID_PERIOD');const state=e.state();if(p.revision!==state.revision)throw Error('REVISION_CHANGED');return {revision:state.revision,range:e.reports(state,p.from,p.to),today:e.reports(state,p.today,p.today),month:e.reports(state,p.today.slice(0,7)+'-01',p.today),daily:p.days.map(day=>({day,report:e.reports(state,day,day)}))};}\n if(request.action==='reports'){if(actor.role!=='administrator')throw Error('PERMISSION_DENIED');const p=request.payload;if(!p||!/^\\d{4}-\\d{2}-\\d{2}$/.test(p.from)||!/^\\d{4}-\\d{2}-\\d{2}$/.test(p.to)||p.from>p.to)throw Error('INVALID_PERIOD');return e.reports(e.state(),p.from,p.to);}\n throw Error('PERMISSION_DENIED');\n}\nfunction cv5cError_(e){return {error:/^[A-Z][A-Z_]+$/.test(e.message)?e.message:'SERVER_UNAVAILABLE',retryable:true};}\nfunction secureRequest(envelope){try{const r=cv5cProof_(envelope),actor=CVAccess.principal(r.subject,cv5cBindings_());return cvLocked_(()=>cv5cDispatch_(r,actor,cv5cPolicy_()));}catch(e){return cv5cError_(e);}}\nfunction ownerRequest(request){try{cvOwner_();return cvLocked_(()=>cv5cDispatch_(request,{subject:'native:sandbox-owner',role:'administrator'},cv5cPolicy_()));}catch(e){return cv5cError_(e);}}\n","sha256":"3fb5a83c3a9169b1e7cef9c7a1075eecddeee44e0696022182f5afff1df37ed1"},{"path":"fase5c/apps-script/Laboratory.gs","content":"/* Ensayos privados del editor. No hay identidades reales ni se habilita el proxy. */\nfunction cv5cLabRun_(){\n cvOwner_();return cvLocked_(()=>{\n const base=invEngine_(),beforeJ=base.store.readJournal(),beforeE=base.store.readEffects(),props=PropertiesService.getScriptProperties();if(props.getProperty('PHASE5C_RACE_FIXTURE'))return {done:true,alreadyComplete:true};let checkpoint=JSON.parse(props.getProperty('PHASE5C_ACTIVE_RUN')||'null');if(!checkpoint){const started=beforeJ.filter(r=>r.kind==='PREPARED'&&r.command.operationId.startsWith('risk5c-')&&r.command.operationId.endsWith('-inventory-0')).slice(-1)[0];checkpoint=started?{run:started.command.operationId.slice(0,-12),now:started.command.date}:{run:'risk5c-'+Utilities.getUuid(),now:new Date().toISOString()};props.setProperty('PHASE5C_ACTIVE_RUN',JSON.stringify(checkpoint));}const now=checkpoint.now,run=checkpoint.run,invocationStarted=Date.now();let newCommands=0;const apply=(engine,c)=>{const old=engine.status(c.operationId),result=engine.execute(c);if(old.state!=='COMMITTED'){newCommands++;console.log(JSON.stringify({kind:'COMMAND_PROGRESS_5C',operationId:c.operationId,state:result.state,elapsedMs:Date.now()-invocationStarted}));if(newCommands>=2||Date.now()-invocationStarted>20000)throw Error('LAB_CONTINUE');}return result;};\n const bindings={'google:111111':{role:'administrator',active:true},'google:222222':{role:'sales',active:true},'google:333333':{role:'sales',active:true},'google:444444':{role:'inventory',active:true}};\n const policy={shippingByZone:{'Zona ficticia':{costCents:0,chargedCents:0}},preparationByGrams:{500:{processingPerBagCents:100}}};\n const engine=(subject,hook)=>new CVAccess.Engine(base.store,base.opening,hook,{actor:CVAccess.principal(subject,bindings),policy,now:()=>now});\n const admin=engine('google:111111'),sales=engine('google:222222'),other=engine('google:333333'),inventory=engine('google:444444'),checks=[];\n const check=(name,passed)=>{checks.push({name,passed:!!passed});if(!passed)throw Error('PHASE5C_FAILED')};\n const seed=CVCommercialScenario.commands(run,now).slice(0,11);for(const c of seed)apply(admin,c);\n const key=n=>'demo:'+run+'-'+n,command=(id,type,data={})=>({epoch:'TEST_ONLY_V3',schemaVersion:2,commercialVersion:4,operationId:run+'-'+id,deviceId:'lab-editor',saleId:'future:'+run+'-'+id,date:now,responsible:'Identidad declarada no confiable',type,...data});\n const prep=command('preparation','PREPARE_BAGS',{resourceId:key('bulk'),outputResourceId:key('one'),bagGrams:500,grind:'molido',bags:1,wasteGrams:0,materials:[{resourceId:key('bag500')},{resourceId:key('label')}]});apply(inventory,prep);check('Inventario prepara con receta sintética de servidor',inventory.state().resources[key('one')].physical===1);\n const sale=command('sale','REGISTER_SALE',{channel:'Otro',customer:{name:'DEMO 5C',zone:'Zona ficticia'},items:[{offerId:key('single'),offerVersion:1,resourceId:key('one'),quantity:1}]});const ack=apply(sales,sale);check('Vendedor registra con precio y costo de servidor',ack.state==='COMMITTED');check('Reintento devuelve confirmación original',CVInventory.canonical(sales.execute(sale))===CVInventory.canonical(ack));\n try{other.execute({...sale,operationId:run+'-other',saleId:'future:'+run+'-other'});check('Última bolsa rechaza segunda reserva',false)}catch(e){check('Última bolsa rechaza segunda reserva',e.message==='INSUFFICIENT_STOCK')}\n try{other.status(sale.operationId);check('No consultar operación ajena',false)}catch(e){check('No consultar operación ajena',e.message==='ACCESS_DENIED')}\n const dto=CVAccess.snapshot(sales);check('Respuesta de vendedor no incluye costos/diario/utilidades',!/(\"costCents\"|\"valueCents\"|\"profitCents\"|\"commerce\"|\"totalCostCents\")/.test(JSON.stringify(dto)));check('Inventario no recibe contactos',CVAccess.snapshot(inventory).sales.length===0);\n try{sales.execute(command('forbidden','CONFIGURE_OFFER'));check('Vendedor no configura precios',false)}catch(e){check('Vendedor no configura precios',e.message==='PERMISSION_DENIED')}\n try{sales.execute({...sale,operationId:run+'-spoof',role:'administrator'});check('No elevar perfil desde navegador',false)}catch(e){check('No elevar perfil desde navegador',e.message==='IDENTITY_SPOOFING')}\n apply(sales,command('cancel','CANCEL_SALE',{saleId:sale.saleId,expectedSaleVersion:1,reason:'Fin de ensayo ficticio'}));\n const retry=command('partial','REGISTER_SALE',{...sale,operationId:run+'-partial',saleId:'future:'+run+'-partial'});let injected=false;if(sales.status(retry.operationId).state==='UNKNOWN'){try{engine('google:222222',point=>{if(point==='afterEffect'&&!injected){injected=true;throw Error('INJECTED')}}).execute(retry)}catch(e){if(e.message!=='INJECTED')throw e}}\n check('Fallo parcial conserva plan recuperable', ['PREPARED','COMMITTED'].includes(sales.status(retry.operationId).state));apply(sales,retry);sales.execute(retry);check('Recuperación no duplica reserva',sales.state().resources[key('one')].reserved===(sales.status(run+'-cancel-partial').state==='COMMITTED'?0:1));\n const p=base.store.readJournal().find(r=>r.id===retry.operationId&&r.kind==='PREPARED');check('Actor y hora de servidor persistidos',p.plan.audit.subject==='google:222222'&&p.plan.audit.serverAt===now&&p.plan.effects.every(e=>e.responsible==='google:222222'));\n sales.execute(command('cancel-partial','CANCEL_SALE',{saleId:retry.saleId,expectedSaleVersion:1,reason:'Cierre de ensayo ficticio'}));\n const prefix=(a,b)=>CVInventory.canonical(a)===CVInventory.canonical(b.slice(0,a.length));check('Diarios anteriores intactos',prefix(beforeJ,base.store.readJournal())&&prefix(beforeE,base.store.readEffects()));\n PropertiesService.getScriptProperties().setProperty('PHASE5C_RACE_FIXTURE',JSON.stringify({run,resourceId:key('one'),offerId:key('single'),date:now}));\n const report={id:run,kind:'ACCESS_5C',passed:true,checks,revision:admin.state().revision,identityProvider:'SYNTHETIC_ONLY',realGoogleSignInTested:false};invAppend_(cvBook_(),'VerificacionesInventarioV3',report);console.log(JSON.stringify(report));return report;\n });\n}\nfunction cv5cPerformance_(){cvOwner_();return cvLocked_(()=>{\n const samples=[];for(let i=0;i<20;i++){const start=Date.now(),e=cv5cEngine_({subject:'native:sandbox-owner',role:'administrator'}),loaded=Date.now(),s=e.state(),replayed=Date.now();e.reports(s);const reported=Date.now();samples.push({loadMs:loaded-start,replayMs:replayed-loaded,reportsMs:reported-replayed,totalMs:reported-start,revision:s.revision});}\n const total=samples.map(x=>x.totalMs).sort((a,b)=>a-b);const r={id:'perf5c-'+Utilities.getUuid(),kind:'PERFORMANCE_5C',environment:'TEST_ONLY',passed:true,n:samples.length,meanMs:samples.reduce((n,x)=>n+x.totalMs,0)/samples.length,p50Ms:total[9],p95Ms:total[18],maxMs:total[19],samples,includesNetwork:false,includesLockWait:false};invAppend_(cvBook_(),'VerificacionesInventarioV3',r);console.log(JSON.stringify(r));return r;\n });}\nfunction cv5cCompleteBackup_(){cvOwner_();return cvLocked_(()=>{\n const started=Date.now(),source=cvBook_(),targetId=PropertiesService.getScriptProperties().getProperty('PHASE5B_RESTORE_SHEET_ID');if(targetId!=='1zB8s5MZN-LGMpnHL3RkOvA802WVfPOPEkRgXmygNk0o')throw Error('RESTORE_DESTINATION');\n const target=SpreadsheetApp.openById(targetId);if(target.getName()!=='CasaVieja_RECUPERACION_TEST_ONLY_5B'||target.getSheetByName('Control').getRange('B3').getValue()!=='TEST_ONLY'||targetId===source.getId())throw Error('RESTORE_DESTINATION');\n const names=['Control','RecursosDemo','AperturaV2','DiarioV2','EfectosV2','VerificacionesV2','DiarioInventarioV3','MovimientosInventarioV3','VerificacionesInventarioV3','Operaciones'],tables={};for(const name of names){const sh=source.getSheetByName(name);if(!sh)throw Error('MISSING_BACKUP_TAB');const n=sh.getLastRow(),cols=sh.getLastColumn();if(n>20000||cols>64)throw Error('BACKUP_LIMIT_REQUIRES_PAGING');tables[name]=n?sh.getRange(1,1,n,cols).getValues():[];}\n const hash=s=>Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,s,Utilities.Charset.UTF_8).map(b=>(b<0?b+256:b).toString(16).padStart(2,'0')).join('');\n const files=CV5C_ARTIFACTS_,payload={format:'CV_COMPLETE_5C',environment:'TEST_ONLY',createdAt:new Date().toISOString(),tables,config:{environment:'TEST_ONLY',sheetId:source.getId(),scriptId:ScriptApp.getScriptId(),authMode:PropertiesService.getScriptProperties().getProperty('PHASE5C_AUTH_MODE')||'DISABLED',roleBindings:JSON.parse(PropertiesService.getScriptProperties().getProperty('PHASE5C_ROLE_BINDINGS')||'{}'),approvedPolicy:cv5cPolicy_(),rolePolicy:CVAccess.roles,secretsExcluded:true},clients:CV5C_CLIENT_EXPORTS_,release:{files,sha256:hash(CVInventory.canonical(files.map(({path,sha256})=>({path,sha256}))))}};\n const archive={payload,sha256:hash(CVInventory.canonical(payload))},raw=JSON.stringify(archive),encoded=Utilities.base64Encode(Utilities.gzip(Utilities.newBlob(raw,'application/json','backup5c.json')).getBytes()),chunks=[];for(let start=0;start<encoded.length;start+=30000)chunks.push(encoded.slice(start,start+30000));\n const restorationStarted=Date.now();\n const id='complete5c-'+Utilities.getUuid(),sh=target.getSheetByName('Control'),row=sh.getLastRow()+1,records=chunks.map((data,index)=>[id+':'+index,'COMPLETE_BACKUP_5C',JSON.stringify({archiveId:id,index,total:chunks.length,data})]);sh.getRange(row,4,records.length,3).setValues(records);SpreadsheetApp.flush();\n const read=sh.getRange(row,4,records.length,3).getValues().map(r=>JSON.parse(r[2])).sort((a,b)=>a.index-b.index).map(r=>r.data).join('');const restored=JSON.parse(Utilities.ungzip(Utilities.newBlob(Utilities.base64Decode(read),'application/gzip','backup5c.json.gz')).getDataAsString('UTF-8'));if(hash(CVInventory.canonical(restored.payload))!==archive.sha256)throw Error('RESTORE_READBACK');\n const state=(j,e)=>new CVCommercial.Engine({readJournal:()=>j,readEffects:()=>e}).state(),parse=name=>tables[name].slice(1).map(r=>JSON.parse(r[2])),current=state(parse('DiarioInventarioV3'),parse('MovimientosInventarioV3')),restoredParse=name=>restored.payload.tables[name].slice(1).map(r=>JSON.parse(r[2])),recovered=state(restoredParse('DiarioInventarioV3'),restoredParse('MovimientosInventarioV3'));\n if(CVInventory.canonical(current)!==CVInventory.canonical(recovered))throw Error('RESTORE_STATE_MISMATCH');\n for(const name of ['DiarioInventarioV3','MovimientosInventarioV3']){const from=parse(name),dest=target.getSheetByName(name),old=invRead_(target,name);if(old.length>from.length||old.some((r,i)=>CVInventory.canonical(r)!==CVInventory.canonical(from[i])))throw Error('RESTORE_NONEMPTY_CONFLICT');if(old.length<from.length)dest.getRange(old.length+2,1,from.length-old.length,3).setValues(from.slice(old.length).map(r=>[r.id,r.kind,JSON.stringify(r)]));}\n SpreadsheetApp.flush();if(CVInventory.canonical(current)!==CVInventory.canonical(state(invRead_(target,'DiarioInventarioV3'),invRead_(target,'MovimientosInventarioV3'))))throw Error('RESTORE_STATE_MISMATCH');\n for(const name of ['AperturaV2','DiarioV2','EfectosV2','DiarioInventarioV3','MovimientosInventarioV3']){const sheet=source.getSheetByName(name),fresh=sheet.getLastRow()?sheet.getRange(1,1,sheet.getLastRow(),sheet.getLastColumn()).getValues():[];if(CVInventory.canonical(fresh)!==CVInventory.canonical(tables[name]))throw Error('SOURCE_CHANGED');}\n const report={id,kind:'COMPLETE_RESTORE_5C',passed:true,targetId,range:'Control!D'+row+':F'+(row+records.length-1),sha256:archive.sha256,release:payload.release.sha256,revision:recovered.revision,tableNames:names,compressedBytes:encoded.length,uncompressedChars:raw.length,elapsedMs:Date.now()-started,backupMs:restorationStarted-started,restoreVerificationMs:Date.now()-restorationStarted,sourceUnchanged:true,deviceQueuesIncluded:payload.clients.states.length>0,deviceScope:payload.clients.scope,secretsIncluded:false,commercialActivation:false};invAppend_(source,'VerificacionesInventarioV3',report);console.log(JSON.stringify(report));return report;\n });}\nfunction sandboxExecute(command){if(command!==undefined)return sandboxExecutePhase5B_(command);try{if(!PropertiesService.getScriptProperties().getProperty('PHASE5C_RACE_FIXTURE'))cv5cLabRun_();}catch(e){if(e.message==='LAB_CONTINUE'){const progress={kind:'LAB_PROGRESS_5C',done:false,checkpointSaved:true};console.log(JSON.stringify(progress));return progress;}throw e;}cv5cPerformance_();return cv5cCompleteBackup_();}\n","sha256":"52f5a3ee0f06785572b73c68ee3f60aea05e1efbdafdcadb354fea2a56c55dbe"},{"path":"fase5c/apps-script/Race.gs","content":"// Exclusivamente el /dev privado de laboratorio. Identidades fijas ficticias, no cuentas activadas.\nfunction cv5cRaceEngine_(subject){const base=invEngine_();return new CVAccess.Engine(base.store,base.opening,undefined,{actor:{subject,role:'sales'},policy:{shippingByZone:{'Zona ficticia':{costCents:0,chargedCents:0}}},now:()=>new Date().toISOString()});}\nfunction lab5cRace(slot){const started=Date.now();try{cvOwner_();if(![1,2,3].includes(slot))throw Error('INVALID_SLOT');return cvLocked_(()=>{const entered=Date.no