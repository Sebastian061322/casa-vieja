   for(const [resourceId,qty]of Object.entries(aggregate))effects.push({id:c.operationId+':'+effects.length,operationId:c.operationId,saleId:c.saleId,resourceId,qtyDelta:-qty,kind:'SALE_CONSUMPTION'});
