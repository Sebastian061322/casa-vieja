const INV_HTML_="<!doctype html><html lang=\"es\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Casa Vieja · Inventario de pruebas</title><style>\n  :root{\n    --bg:#1C1410;\n    --surface:#241B15;\n    --surface-2:#2E241C;\n    --surface-3:#382B20;\n    --border:#3D2F24;\n    --text:#F2E9DC;\n    --text-muted:#A8998A;\n    --accent-red:#C1432E;\n    --accent-gold:#D4A34A;\n    --accent-green:#6B8F5C;\n    --accent-blue:#5C7F8F;\n    --radius:10px;\n    --font-display:'Iowan Old Style','Palatino Linotype',Georgia,serif;\n    --font-body:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;\n  }\n  *{box-sizing:border-box;}\n  html,body{margin:0;padding:0;}\n  body{\n    background:var(--bg);\n    color:var(--text);\n    font-family:var(--font-body);\n    min-height:100vh;\n    padding-bottom:env(safe-area-inset-bottom);\n  }\n  #app{display:flex;min-height:100vh;}\n  \n  /* Sidebar */\n  .sidebar{\n    width:220px;flex-shrink:0;background:var(--surface);\n    border-right:1px solid var(--border);\n    display:flex;flex-direction:column;padding:20px 0;\n  }\n  .brand{padding:0 20px 18px 20px;border-bottom:1px solid var(--border);margin-bottom:10px;}\n  .brand h1{font-family:var(--font-display);font-size:20px;margin:0 0 2px 0;font-weight:600;letter-spacing:.3px;}\n  .brand span{font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:1px;}\n  nav.navlist{\n    display:flex;flex-direction:column;gap:2px;padding:0 10px;\n    -webkit-overflow-scrolling:touch;\n  }\n  .nav-btn{\n    display:flex;align-items:center;gap:10px;\n    background:none;border:none;color:var(--text-muted);\n    padding:10px 12px;border-radius:8px;cursor:pointer;\n    font-size:14px;text-align:left;font-family:var(--font-body);\n    transition:background .15s, color .15s;\n  }\n  .nav-btn svg{flex-shrink:0;opacity:.8;}\n  .nav-btn:hover{background:var(--surface-2);color:var(--text);}\n  .nav-btn.active{background:var(--surface-3);color:var(--text);font-weight:600;}\n  .nav-btn.active svg{opacity:1;}\n  .sidebar-footer{margin-top:auto;padding:14px 20px 0 20px;border-top:1px solid var(--border);}\n  .sidebar-footer p{font-size:11px;color:var(--text-muted);line-height:1.5;margin:10px 0 0 0;}\n  #connStatus.online{color:var(--accent-green);}\n  #connStatus.offline{color:var(--text-muted);}\n  \n  /* Main */\n  .main{flex:1;min-width:0;padding:26px 34px 60px 34px;}\n  .topbar{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:22px;flex-wrap:wrap;gap:8px;}\n  .topbar h2{font-family:var(--font-display);font-size:26px;margin:0;font-weight:600;}\n  .topbar .today{font-size:13px;color:var(--text-muted);}\n  .view{display:none;}\n  .view.active{display:block;animation:fadein .2s ease;}\n  @keyframes fadein{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:translateY(0);}}\n  \n  /* Cards / grid */\n  .grid{display:grid;gap:14px;}\n  .grid-kpi{grid-template-columns:repeat(auto-fit,minmax(180px,1fr));margin-bottom:22px;}\n  .grid-charts{grid-template-columns:repeat(auto-fit,minmax(320px,1fr));}\n  .card{\n    background:var(--surface);border:1px solid var(--border);\n    border-radius:var(--radius);padding:16px 18px;\n  }\n  .kpi-label{font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:var(--text-muted);margin:0 0 8px 0;}\n  .kpi-value{font-family:var(--font-display);font-size:26px;font-weight:600;font-variant-numeric:tabular-nums;margin:0;}\n  .kpi-value.red{color:var(--accent-red);}\n  .kpi-value.gold{color:var(--accent-gold);}\n  .kpi-value.green{color:var(--accent-green);}\n  .kpi-sub{font-size:11px;color:var(--text-muted);margin-top:6px;}\n  .card h3{font-size:14px;margin:0 0 14px 0;font-weight:600;color:var(--text);}\n  .card h3 small{display:block;font-size:11px;color:var(--text-muted);font-weight:400;margin-top:2px;}\n  \n  /* Chart bits */\n  .chart-svg{width:100%;height:auto;display:block;}\n  .legend{display:flex;flex-direction:column;gap:6px;margin-top:12px;font-size:12px;}\n  .legend-row{display:flex;align-items:center;gap:8px;justify-content:space-between;}\n  .legend-left{display:flex;align-items:center;gap:8px;color:var(--text-muted);}\n  .dot{width:9px;height:9px;border-radius:50%;flex-shrink:0;}\n  .donut-wrap{display:flex;gap:20px;align-items:center;flex-wrap:wrap;}\n  .donut{width:120px;height:120px;border-radius:50%;position:relative;flex-shrink:0;}\n  .donut::after{content:'';position:absolute;inset:22px;background:var(--surface);border-radius:50%;}\n  .donut-center{position:absolute;inset:22px;display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--text-muted);text-align:center;z-index:2;}\n  \n  /* Ripeness stock scale */\n  .stock-row{margin-bottom:14px;}\n  .stock-row-head{display:flex;justify-content:space-between;font-size:12.5px;margin-bottom:5px;}\n  .stock-row-head b{font-weight:600;}\n  .stock-row-head span.low{color:var(--accent-red);font-weight:600;}\n  .ripeness-track{position:relative;height:10px;border-radius:6px;overflow:hidden;\n    background:linear-gradient(90deg,var(--accent-red) 0%,var(--accent-gold) 45%,var(--accent-green) 100%);}\n  .ripeness-mask{position:absolute;top:0;right:0;height:100%;background:var(--surface-2);}\n  .ripeness-min{position:absolute;top:-2px;width:2px;height:14px;background:var(--text);opacity:.8;}\n  \n  /* Forms */\n  .form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:14px;}\n  label{display:block;font-size:11px;color:var(--text-muted);margin-bottom:5px;text-transform:uppercase;letter-spacing:.4px;}\n  input,select{\n    width:100%;background:var(--surface-2);border:1px solid var(--border);color:var(--text);\n    padding:9px 10px;border-radius:7px;font-size:13.5px;font-family:var(--font-body);\n  }\n  input:focus,select:focus{outline:2px solid var(--accent-gold);outline-offset:1px;}\n  .btn{\n    background:var(--accent-gold);color:#231A12;border:none;padding:10px 16px;\n    border-radius:7px;font-size:13.5px;font-weight:600;cursor:pointer;font-family:var(--font-body);\n  }\n  .btn:hover{filter:brightness(1.08);}\n  .btn.secondary{background:var(--surface-3);color:var(--text);border:1px solid var(--border);}\n  .btn.danger{background:var(--accent-red);color:#fff;}\n  .btn.small{padding:5px 10px;font-size:12px;}\n  .btn:focus-visible, .nav-btn:focus-visible, select:focus-visible, input:focus-visible{outline:2px solid var(--accent-gold);outline-offset:2px;}\n  \n  /* Table */\n  .table-wrap{\n    overflow-x:auto;\n    -webkit-overflow-scrolling:touch;\n  }\n  table{width:100%;border-collapse:collapse;font-size:13px;}\n  th{text-align:left;color:var(--text-muted);font-size:11px;text-transform:uppercase;letter-spacing:.4px;padding:8px 10px;border-bottom:1px solid var(--border);white-space:nowrap;}\n  td{padding:9px 10px;border-bottom:1px solid var(--border);white-space:nowrap;}\n  tr:last-child td{border-bottom:none;}\n  .pill{display:inline-block;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:600;}\n  .pill.green{background:rgba(107,143,92,.18);color:var(--accent-green);}\n  .pill.gold{background:rgba(212,163,74,.18);color:var(--accent-gold);}\n  .pill.red{background:rgba(193,67,46,.18);color:var(--accent-red);}\n  .empty{color:var(--text-muted);font-size:13px;padding:24px 4px;text-align:center;border:1px dashed var(--border);border-radius:var(--radius);}\n  .section-title{font-family:var(--font-display);font-size:18px;font-weight:600;margin:26px 0 12px 0;}\n  .section-title:first-child{margin-top:0;}\n  .row-actions{display:flex;gap:6px;}\n  .hint{font-size:11.5px;color:var(--text-muted);margin-top:-4px;margin-bottom:14px;}\n  .toolbar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px;}\n  .flexend{display:flex;justify-content:flex-end;gap:10px;flex-wrap:wrap;}\n\n  /* Acordeón (tarjetas desplegables para historiales) */\n  .acc-list{display:flex;flex-direction:column;gap:8px;}\n  .acc-item{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;}\n  .acc-head{display:flex;align-items:center;gap:10px;padding:12px 14px;cursor:pointer;user-select:none;}\n  .acc-head:hover{background:var(--surface-2);}\n  .acc-num{flex:0 0 auto;min-width:26px;color:var(--text-muted);font-size:12px;font-weight:600;}\n  .acc-summary{flex:1 1 auto;min-width:0;display:flex;flex-wrap:wrap;align-items:center;gap:6px 12px;}\n  .acc-summary .acc-main{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}\n  .acc-summary .acc-sub{color:var(--text-muted);font-size:12px;white-space:nowrap;}\n  .acc-summary .acc-amt{margin-left:auto;font-weight:700;white-space:nowrap;}\n  .acc-caret{flex:0 0 auto;color:var(--text-muted);transition:transform .15s;font-size:12px;}\n  .acc-item.open .acc-caret{transform:rotate(180deg);}\n  .acc-body{display:none;padding:4px 14px 14px 14px;border-top:1px solid var(--border);}\n  .acc-item.open .acc-body{display:block;}\n  .acc-fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px 16px;margin:10px 0;}\n  .acc-field label{margin-bottom:2px;}\n  .acc-field div{font-size:13.5px;}\n  .acc-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;}\n  .wf-row{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:9px 0;border-bottom:1px solid var(--border);font-size:14px;}\n  .wf-row small{display:block;color:var(--text-muted);font-size:11px;font-weight:400;}\n  .wf-row b{white-space:nowrap;font-variant-numeric:tabular-nums;}\n  .wf-row.neg b{color:var(--accent-red);}\n  .wf-row.total{border-bottom:none;border-top:2px solid var(--border);margin-top:4px;padding-top:12px;font-size:16px;font-weight:600;}\n  .wf-row.total b{font-family:var(--font-display);font-size:24px;}\n  .split-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px;margin-top:14px;}\n  .split-box{background:var(--surface-2);border:1px