height:44px}.optional-product-filters>summary{line-height:44px}.home-filters .btn{padding:9px 10px}.chart-tabs button{font-size:11px}.customer-lookup-panel>summary{line-height:1.5;padding-top:12px;padding-bottom:12px}}\n","sha256":"0cbbdc7131e9617df0fb125e99c2879cefd8981a32e73965c96746693ccd7c82"},{"path":"fase5a/refinamiento-5a2/refinement.js","content":"/* Presentation refinement only. Uses unchanged Phase 4 RPC reports and projections. */\nlet homeRange={from:today().slice(0,7)+'-01',to:today()},homeData=null,homeError='',homeBusy=false,homeMetric='revenueCents',homeSelected=6,homeRequest=0,homeReloadRequested=false,homeRetryCount=0;\nconst homeReports=new Map();\nfunction decorateNavIcons(){document.querySelectorAll('#nav [data-view]').forEach(b=>{if(!b.querySelector('svg'))b.insertAdjacentHTML('afterbegin',CVVisual.icon(b.dataset.view));});document.querySelectorAll('.mobile-tabs [data-view] span').forEach(el=>el.innerHTML=CVVisual.icon(el.parentElement.dataset.view));}\ndecorateNavIcons();\nasync function cachedHomeReport(revision,from,to){const key=CVVisual.reportKey(revision,from,to);if(!homeReports.has(key)){const promise=rpc('reports',{from,to}).then(r=>{if(r.error)throw Error(r.error);return r;}).catch(e=>{homeReports.delete(key);throw e;});homeReports.set(key,promise);}if(homeReports.size>60){const first=homeReports.keys().next().value;homeReports.delete(first);}return homeReports.get(key);}\nasync function loadHome(force=false){if(!snapshot)return;if(homeBusy){if(force)homeReloadRequested=true;return;}const revision=snapshot.revision,range={...homeRange};if(!force&&homeData?.revision===revision&&homeData.from===range.from&&homeData.to===range.to&&!homeError)return;homeBusy=true;homeError='';const request=++homeRequest;drawHome();try{\n const dates=CVVisual.lastDays(range.from,range.to),jobs=[['range',range.from,range.to],['today',today(),today()],['month',today().slice(0,7)+'-01',today()],...dates.map(d=>[d,d,d])];const output={};let next=0;\n async function worker(){while(next<jobs.length){const [key,from,to]=jobs[next++];output[key]=await cachedHomeReport(revision,from,to);}}\n await Promise.all([worker(),worker()]);const current=await rpc('snapshot');if(current.error)throw Error(current.error);if(current.revision!==revision){if(homeRetryCount<1){homeRetryCount++;await client.refresh();snapshot=(await client.view()).snapshot;homeReloadRequested=true;}throw Error('REPORT_REVISION_CHANGED');}if(request!==homeRequest||homeRange.from!==range.from||homeRange.to!==range.to)return;\n homeData={revision,from:range.from,to:range.to,loadedAt:new Date().toISOString(),range:output.range,today:output.today,month:output.month,daily:dates.map(d=>({day:d,report:output[d]}))};homeSelected=Math.max(0,homeData.daily.length-1);homeRetryCount=0;await store.transact(s=>s.uxHome5a2=homeData);\n }catch(e){homeError=e.message==='REPORT_REVISION_CHANGED'?'El diario cambió durante la consulta. Actualiza el panel para obtener un conjunto consistente.':explain(e);}finally{homeBusy=false;if(view==='dashboard'){drawHome();if(homeReloadRequested){homeReloadRequested=false;loadHome(true);}}}}\nfunction metricCard(label,value,detail,iconName,target,emphasis=false){return `<button class=\"metric-card${emphasis?' emphasis':''}${label==='Resultado estimado'&&homeData?.range.estimatedProfitCents<0?' loss-metric':''}\" data-home-view=\"${target}\"><span class=\"metric-head\">${esc(label)}<span class=\"metric-icon\">${CVVisual.icon(iconName)}</span></span><strong>${esc(value)}</strong><small>${esc(detail)}</small></button>`;}\nfunction homeFilter(){return `<form id=\"home-filter\" class=\"home-filters\"><button class=\"btn secondary period-choice\" type=\"button\" data-home-period=\"day\">Hoy</button><button class=\"btn secondary period-choice\" type=\"button\" data-home-period=\"week\">7 días</button><button class=\"btn secondary period-choice\" type=\"button\" data-home-period=\"month\">Este mes</button>${label('from','Desde','date',homeRange.from)}${label('to','Hasta','date',homeRange.to)}<button class=\"btn secondary\">Aplicar</button><button class=\"btn secondary\" type=\"button\" data-home-refresh ${homeBusy?'disabled':''}>${homeBusy?'Consultando…':'Actualizar panel'}</button></form>`;}\nfunction financialPanel(r){const rows=[['Ingresos por despachos',r.revenueCents,'Netos de créditos por devolución',''],['Costo de productos vendidos',r.cogsCents,'Costo histórico neto de devoluciones',''],['Margen bruto',r.grossMarginCents,'Importe confirmado por el backend','subtotal'],['Distribución de pedidos',r.distributionCents,'Costo del envío al despachar',''],['Gastos operativos',r.operatingExpenseCents,'Publicidad manual y otros gastos incluidos aquí',''],['Merma extraordinaria',r.stockLossCents,'No vuelve a descontar mermas capitalizadas','']];return `<article class=\"card\"><div class=\"panel-head\"><div><h3>Así se forma tu resultado</h3><p>Del ${esc(homeData.from)} al ${esc(homeData.to)} · soles</p></div><span class=\"tag\">Datos confirmados</span></div><dl class=\"waterfall\">${rows.map(([name,value,detail,cls])=>`<div class=\"waterfall-row ${cls}\"><dt>${name}<small>${detail}</small></dt><dd>${money(value)}</dd></div>`).join('')}</dl><div class=\"waterfall-result${r.estimatedProfitCents<0?' loss':''}\"><span>Resultado estimado<small style=\"display:block;font-weight:400;font-size:11px\">Sin reparto automático entre socios</small></span><strong>${money(r.estimatedProfitCents)}</strong></div><p class=\"cv-help\">Los pagos de compras no se descuentan otra vez como gasto. Cobrar una venta no representa un ingreso adicional por despacho.</p><div class=\"fund-placeholder\"><div><b>Fondo del negocio</b><p>Ubicación preparada. Reglas, aportes y reparto pendientes de aprobación.</p></div><span class=\"tag warn\">Sin implementar</span></div></article>`;}\nconst chartMetricNames={revenueCents:'Ingresos por despachos',registeredCents:'Importe de pedidos',registeredOrders:'Pedidos registrados'};\nfunction chartValue(value,