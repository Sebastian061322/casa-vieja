o','Hasta','date',report?.to||today())}<button class=\"btn\">Consultar período</button><button class=\"btn secondary\" type=\"button\" data-period=\"day\">Hoy</button><button class=\"btn secondary\" type=\"button\" data-period=\"week\">Últimos 7 días</button><button class=\"btn secondary\" type=\"button\" data-period=\"month\">Este mes</button></form><div id=\"report-body\">${summary(report||r)}</div><p class=\"cv-help\">Resultados estimados por fecha de operación en Lima. Las cuentas por cobrar son el saldo actual, aunque filtres un período. Las compras de inventario no se restan otra vez del margen. No incluye impuestos, depreciación, Fondo ni integración automática de publicidad.</p><div class=\"card\"><h3>Productos despachados</h3>${Object.entries((report||r).topProducts).map(([p,n])=>`<p>${esc(p)} · ${n} bolsa(s) despachadas</p>`).join('')}</div>`;\n if(view==='config')$('config').innerHTML=`<button class=\"btn\" data-operation=\"CONFIGURE_OFFER\">Configurar oferta ficticia</button><p class=\"cv-help\">Los precios son exclusivamente de pruebas. Cambiar una oferta no recalcula pedidos confirmados. Las vigencias se validan con la fecha del servidor.</p>${Object.values(snapshot.commerce.offers).map(o=>`<div class=\"card cv-card-gap\"><h3>${esc(o.name)} · ${money(o.priceCents)}</h3><p>${esc(o.family)} · ${esc(o.grind)} · ${o.grams} g · ${o.bags} bolsa(s) por presentación</p><p>${esc(o.validFrom)} a ${esc(o.validUntil)} · versión ${o.version} · ${o.active?'Activa':'Inactiva'}</p><button class=\"btn secondary\" data-offer-edit=\"${esc(o.id)}\">Nueva versión de precio / vigencia</button></div>`).join('')}<div class=\"card\"><h3>Funciones originales conservadas como pendientes</h3><p>Fondo, conteos físicos autorizados, insumos adicionales y restauración de respaldos siguen fuera de esta integración. No se eliminó ni sustituyó la aplicación original.</p></div>`;\n for(const [id,value]of Object.entries(filterValues))if($(id))$(id).value=value;if(view==='orders'&&$('order-list'))$('order-list').innerHTML=orderTable();if(view==='customers'&&$('customer-list'))renderCustomers();if(view==='inventory'&&inventoryValues){for(const [key,value]of Object.entries(inventoryValues))$('inventory-filter').elements[key].value=value;$('inventory-rows').innerHTML=inventoryRows();}\n document.querySelectorAll('[data-preserve-key]').forEach(el=>el.open=openKeys.has(el.dataset.preserveKey));\n}\nfunction renderCustomers(){const q=($('customer-search')?.value||'').toLowerCase();$('customer-list').innerHTML=snapshot.reports.customers.filter(c=>`${c.name} ${c.phone}`.toLowerCase().includes(q)).map(c=>`<details class=\"card cv-card-gap\" data-preserve-key=\"customer-${esc(c.id)}\"><summary>${esc(c.name)} · ${c.purchaseCount>1?'Recurrente':'Sin repetición de compra despachada'} · ${c.orders.length} pedido(s)</summary><p>${reveal?esc(c.phone||'Sin teléfono'):c.phone?'•••••'+esc(c.phone.slice(-3)):'Sin teléfono'}</p><p>Importe neto de pedidos: ${money(c.totalCents)}. No equivale a dinero cobrado.</p>${c.orders.map(id=>{const s=snapshot.sales[id];return `<p>${esc(s.metadata.date)} · ${esc(statusName[s.status])} · ${money(s.totalCents+s.deliveryChargedCents)} · ${esc(s.metadata.note)}</p>`;}).join('')}</details>`).join('');}\nfunction openDialog(title,html,submit){$('dialog-title').textContent=title;$('dialog-body').innerHTML='<div class=\"form-grid\">'+html+'</div>';$('dialog-error').textContent='';modalSubmit=submit;$('dialog').showModal();}\nfunction operation(type,offerId){const unique=uuid(),saleId='future:'+unique,document=label('documentRef','Comprobante único de prueba','text','DEMO-'+unique.slice(0,8),'required');let html='';let submit;\n if(type==='CONFIGURE_OFFER'){const old=snapshot.commerce.offers[offerId];html=label('name','Nombre comercial','text',old?.name||'Oferta ficticia','required')+select('family','Familia',option(old?.family||'Gourmet',old?.family||'Gourmet')+option('Especialidad','Especialidad')+option('Gourmet','Gourmet'))+select('grind','Molienda',option(old?.grind||'molido',old?.grind==='grano'?'En grano':'Molido')+option('grano','En grano')+option('molido','Molido'))+select('grams','Gramaje',option(old?.grams||500,(old?.grams||500)+' g')+option(250,'250 g')+option(500,'500 g'))+label('bags','Bolsas por presentación','number',old?.bags||1,'min=\"1\" max=\"8\" required')+label('price','Precio de prueba S/','number',old?(old.priceCents/100).toFixed(2):'0','min=\"0\" step=\"0.01\" required')+label('from','Vigente desde','date',old?.validFrom||today(),'required')+label('until','Vigente hasta','date',old?.validUntil||'2026-12-31','required')+select('active','Estado',option('true','Activa')+option('false','Inactiva'));submit=f=>send({type,saleId,expectedOfferVersion:old?.version||0,offer:{id:old?.id||'demo:offer-'+unique,name:f.name,family:f.family,grind:f.grind,grams:numInput(f.grams),bags:numInput(f.bags,1),priceCents:cents(f.price),validFrom:f.from,validUntil:f.until,active:f.active==='true'}});}\n if(type==='RECEIVE_LOT'){html=label('name','Nombre del lote ficticio')+label('origin','Origen ficticio','text','Origen de pruebas','required')+label('producer','Productor ficticio')+label('coffeeType','Variedad','text','Typica de pruebas','required')+select('family','Familia',option('Gourmet','Gourmet')+option('Especialidad','Especialidad'))+label('grams','Pergamino recibido (g)','number','10000','min=\"1\" required')+label('acquisition','Costo de adquisición S/','number','200','min=\"0\" step=\"0.01\" required')+label('freight','Flete de adquisición S/','number','0','min=\"0\" step=\"0.01\" required')+label('processing','Procesamiento inicial S/','number','0','min=\"0\" step=\"0.01\" required')+document;submit=f=>send({type,saleId,lotId:'demo:lot-'+unique,resourceId:'demo:parchment-'+unique,lotName:f.name||'Lote ficticio',origin:f.origin,producer:f.producer,coffeeType:f.coffeeType,family:f.family,grams:numInput(f.grams,1),acquisitionCents:cents(f.acquisition),freightCents:cents(f.freight),processingCents:cents(f.processing),documentRef:f.documentRef});}\n if(type==='RECEIVE_SUPPLY'){html=select('kind','Material',option('BAG250','Empaque 250 g')+option('BAG500','Empaque 500 g')+option('LABEL','Etiqueta'))+label('qty','Unidades recibidas','number','30','min=\"1\" required')+label('amount','Costo total S/','number','30','min=\"0\" step=\"0.01\" required')+document;submit=f=>send({type,saleId,lotId:'demo:supply-lot-'+unique,resourceId:'demo:supply-'+unique,supplyKind:f.kind,qty:numInput(f.qty,1),totalCostCents:cents(f.amount),documentRef:f.documentRef});}\n if(type==='ROAST'){html=select('resourceId','Pergamino disponible',resourceOptions(r=>r.stage==='PARCHMENT'&&r.qty>0))+label('grams','Tostado obtenido (g)','number','8000','min=\"1\" required')+label('waste','Merma del proceso (g)','number','2000','min=\"0\" required')+label('processing','Costo del proceso S/','number','30','min=\"0\" step=\"0.01\" required')+document;submit=f=>send({type,saleId,resourceId:f.resourceId,outputResourceId:'demo:bulk-'+unique,outputGrams:numInput(f.grams,1),wasteGrams:numInput(f.waste),processingCents:cents(f.processing),documentRef:f.documentRef});}\n if(type==='PREPARE_BAGS'){html=select('resourceId','Café tostado del lote',resourceOptions(r=>r.stage==='BULK'&&r.qty>0))+select('grams','Gramaje',option(500,'500 g')+option(250,'250 g'))+select('grind','Molienda',option('molido','Molido')+option('grano','En grano'))+label('bags','Bolsas a preparar','number','6','min=\"1\" required')+label('waste','Merma explícita (g)','number','0','min=\"0\" required')+select('bagId','Partida de empaques',resourceOptions(r=>r.stage==='SUPPLY'&&r.supplyKind!=='LABEL'))+select('labelId','Partida de etiquetas',resourceOptions(r=>r.supplyKind==='LABEL'))+label('processing','Costo de preparación S/','number','0','min=\"0\" step=\"0.01\" required')+document;submit=f=>send({type,saleId,resourceId:f.resourceId,outputResourceId:'demo:packaged-'+unique,bagGrams:numInput(f.grams),grind:f.grind,bags:numInput(f.bags,1),wasteGrams:numInput(f.waste),processingCents:cents(f.processing),materials:[{resourceId:f.bagId},{resourceId:f.labelId}],documentRef:f.documentRef});}\n if(type==='WASTE'){html=select('resourceId','Existencia disponible',resourceOptions(r=>r.qty>0))+label('qty','Cantidad: gramos para café suelto; unidades para bolsas / insumos','number','1','min=\"1\" required')+label('reason','Motivo obligatorio','text','','required');submit=f=>send({type,saleId,resourceId:f.resourceId,qty:numInput(f.qty,1),reason:f.reason});}\n if(type==='RECORD_EXPENSE'){html=select('category','Categoría',option('PUBLICIDAD','Publicidad manual')+option('ADMINISTRACION','Administración')+option('TRANSPORTE','Transporte general, sin envío duplicado')+option('OTROS','Otro gasto operativo'))+label('description','Descripción','text','','required')+label('provider','Proveedor ficticio')+label('amount','Importe S/','number','0','min=\"0.01\" step=\"0.01\" required')+select('paid','Estado de pago',option('false','Pago no registrado')+option('true','Pagado'))+label('campaign','Campaña ficticia, si corresponde')+label('messages','Mensajes declarados, no ventas','number','0','min=\"0\"')+document;submit=f=>send({type,saleId,category:f.category,description:f.description,provider:f.provider||'Proveedor ficticio',amountCents:cents(f.amount),paid:f.paid==='true',campaign:f.campaign,messages:numInput(f.messages),documentRef:f.documentRef});}\n openDialog(({CONFIGURE_OFFER:'Oferta comercial de prueba',RECEIVE_LOT:'Compra y recepción de café',RECEIVE_SUPPLY:'Compra de insumos',ROAST:'Tostado de un lote',PREPARE_BAGS:'Preparación de bolsas',WASTE:'Merma trazable',RECORD_EXPENSE:'Gasto operativo'})[type],html,submit);\n}\nfunction orderAction(type,id){const s=snapshot.sales[id],common={type,saleId:id,expectedSaleVersion:s.version};let html='',submit;\n if(type==='EDIT_SALE'){html=label('customer','Cliente ficticio','text',s.metadata.customer)+label('phone','Teléfono ficticio','tel',s.metadata.phone)+label('zone','Información de entrega','text',s.metadata.zone)+label('note','Observaciones','text',s.metadata.note);submit=f=>send({...common,metadata:{customer:f.customer,phone:f.phone,zone:f.zone,note:f.note}});}\n if(['DISPATCH_SALE','DELIVER_SALE'].includes(type)){html=`<p>${type==='DISPATCH_SALE'?'El despacho descontará el físico y liberará la reserva.':'La entrega no descontará inventario otra vez.'}</p>`;submit=()=>send(common);}\n if(type==='CANCEL_SALE'){html=label('reason','Motivo obligatorio','text','','required')+'<p>Se liberará la reserva. Un anticipo cobrado queda pendiente de reembolso hasta registrarlo.</p>';submit=f=>send({...common,reason:f.reason});}\n if(['RECORD_PAYMENT','RECORD_REFUND'].includes(type)){const amount=type==='RECORD_PAYMENT'?s.financial.outstandingCents:s.financial.refundableCents;html=label('amount',type==='RECORD_PAYMENT'?'Cobro recibido S/':'Reembolso realizado S/','number',(amount/100).toFixed(2),'min=\"0.01\" step=\"0.01\" required')+label('documentRef','Referencia única del movimiento','text','DEMO-'+uuid().slice(0,8),'required')+select('method','Medio',option('Yape ficticio','Yape ficticio')+option('Transferencia ficticia','Transferencia ficticia')+option('Efectivo ficticio','Efectivo ficticio'))+(type==='RECORD_REFUND'?label('reason','Motivo','text','','required'):'');submit=f=>send({...common,amountCents:cents(f.amount),documentRef:f.documentRef,method:f.method,...(type==='RECORD_REFUND'?{reason:f.reason}:{})});}\n if(type==='RETURN_SALE'){html=s.lines.map((l,i)=>label('qty'+i,`${l.family} ${l.grind} ${l.grams} g: quedan ${l.qty-l.returned} por devolver`,'number','0',`min=\"0\" max=\"${l.qty-l.returned}\"`)).join('')+label('reason','Motivo de recepción física','text','','required')+'<p>Solo bolsas recibidas y aptas para reintegrar a esta partida. Esta operación no prueba un reembolso de dinero.</p>';submit=f=>send({...common,reason:f.reason,lines:s.lines.map((l,i)=>({resourceId:l.resourceId,qty:numInput(f['qty'+i])})).filter(l=>l.qty>0)});}\n openDialog(type==='RECORD_PAYMENT'?'Registrar dinero recibido':type==='RECORD_REFUND'?'Registrar dinero reembolsado':type==='RETURN_SALE'?'Recibir devolución física':type==='EDIT_SALE'?'Editar información comercial':'Actualizar pedido',html,submit);\n}\n$('nav').innerHTML=Object.entries(menus).map(([k,v])=>`<button class=\"nav-btn ${k===view?'active':''}\" data-view=\"${k}\">${v}</button>`).join('');$('menu').onclick=()=>$('nav').classList.toggle('open');$('sync').onclick=sync;$('dialog-cancel').onclick=()=>$('dialog').close();\n$('dialog-form').onsubmit=async ev=>{ev.preventDefault();const button=ev.submitter;button.disabled=true;try{if(await modalSubmit(formdata(ev.target))){$('dialog').close();dirty=false;render();}else $('dialog-error').textContent='Revisa el estado de sincronización. Reintentar conserva la operación pendiente.';}catch(e){$('dialog-error').textContent=explain(e);}finally{button.disabled=false;}};\ndocument.addEventListener('click',async ev=>{const b=ev.target.closest('button');if(!b)return;try{if(b.dataset.view)await changeView(b.dataset.view);if(b.hasAttribute('data-add-line'))addLine();if(b.hasAttribute('data-remove-line')){b.closest('.cv-line').remove();preview();}if(b.hasAttribute('data-new-order')){draftSaleId='future:'+uuid();await store.transact(s=>s.commercialDraftSaleId=draftSaleId);dirty=false;render();}if(b.dataset.operation)operation(b.dataset.operation);if(b.dataset.offerEdit)operation('CONFIGURE_OFFER',b.dataset.offerEdit);if(b.dataset.action)orderAction(b.dataset.action,b.dataset.id);if(b.dataset.archive){await client.archiveRejected(b.dataset.archive);await sync();}if(b.hasAttribute('data-reveal')){reveal=!reveal;render();}if(b.dataset.expensePay){const source=b.dataset.expensePay,expense=snapshot.commerce.events.find(e=>e.kind==='OPERATING_EXPENSE'&&e.operationId===source),paid=snapshot.commerce.events.filter(e=>e.kind==='EXPENSE_PAYMENT'&&e.sourceOperationId===source).reduce((n,e)=>n+e.amountCents,0),intent='future:'+uuid();if(paid>=expense.amountCents)throw Error('Este gasto ya está pagado.');openDialog('Registrar pago de gasto',label('amount','Importe pagado S/','number',((expense.amountCents-paid)/100).toFixed(2),'min=\"0.01\" step=\"0.01\" required')+label('reference','Referencia única','text','DEMO-'+uuid().slice(0,8),'required'),f=>send({type:'RECORD_EXPENSE_PAYMENT',saleId:intent,sourceOperationId:source,amountCents:cents(f.amount),documentRef:f.reference}));}if(b.dataset.purchasePay){const paymentIntent='future:'+uuid(),source=b.dataset.purchasePay,cost=snapshot.commerce.events.filter(e=>e.kind==='CAPITALIZED_COST'&&e.operationId===source).reduce((n,e)=>n+e.amountCents,0),paid=snapshot.commerce.events.filter(e=>e.kind==='PURCHASE_PAYMENT'&&e.sourceOperationId===source).reduce((n,e)=>n+e.amountCents,0);openDialog('Pago de compra capitalizable',label('amount','Importe pagado S/','number',((cost-paid)/100).toFixed(2),'min=\"0.01\" step=\"0.01\" required')+label('reference','Referencia única','text','DEMO-'+uuid().slice(0,8),'required'),f=>send({type:'RECORD_PURCHASE_PAYMENT',saleId:paymentIntent,sourceOperationId:source,amountCents:cents(f.amount),documentRef:f.reference}));}if(b.dataset.period){const from=b.dataset.period==='month'?today().slice(0,7)+'-01':b.dataset.period==='week'?new Date(Date.now()-6*86400000-5*3600000).toISOString().slice(0,10):today();report=await rpc('reports',{from,to:today()});if(report.error)throw Error(report.error);dirty=false;render();}}catch(e){notice(explain(e));}});\ndocument.addEventListener('input',ev=>{if(ev.target.closest('#sale-form')){dirty=true;preview();}if(ev.target.id==='order-search')$('order-list').innerHTML=orderTable();if(ev.target.id==='customer-search')renderCustomers();});\ndocument.addEventListener('change',ev=>{if(ev.target.matches('[data-offer]'))updateLine(ev.target.closest('.cv-line'));if(ev.target.closest('#inventory-filter'))$('inventory-rows').innerHTML=inventoryRows();if(ev.target.id==='order-status')$('order-list').innerHTML=orderTable();});\ndocument.addEventListener('submit',async ev=>{const form=ev.target;if(!['sale-form','discount-form','report-filter','inventory-filter'].includes(form.id))return;ev.preventDefault();const b=ev.submitter;if(b)b.disabled=true;try{const f=formdata(form);if(form.id==='sale-form'){if(snapshot.sales[draftSaleId])throw Error('Este pedido ya está confirmado. Usa «Nuevo pedido» para registrar otro.');await send({type:'REGISTER_SALE',saleId:draftSaleId,items:items(),customer:{name:f.customer,phone:f.phone,zone:f.zone,note:f.note},channel:f.channel,discountCents:cents(f.discount),authorizationId:f.authorizationId,deliveryCostCents:cents(f.deliveryCost),deliveryChargedCents:cents(f.deliveryCharged)});}if(form.id==='discount-form'){const id='demo:discount-'+uuid();if(await send({type:'AUTHORIZE_DISCOUNT',saleId:draftSaleId,authorizationId:id,maxCents:cents(f.max),reason:f.reason,expiresAt:f.expires+'T23:59:59.999-05:00'})){$('discount-code').textContent='Autorización: '+id;$('sale-form').elements.authorizationId.value=id;}}if(form.id==='report-filter'){const r=await rpc('reports',{from:f.from,to:f.to});if(r.error)throw Error(r.error);report=r;dirty=false;render();}}catch(e){notice(explain(e));}finally{if(b)b.disabled=false;}});\n$('verify').onclick=async()=>{\n if(verifying)return;verifying=true;$('verify').disabled=true;const run='commercial-browser-'+uuid(),results=[];\n const record=(name,ok)=>{results.push({name,passed:!!ok});$('results').textContent=results.map(r=>(r.passed?'PASS ':'FAIL ')+r.name).join('\\n');if(!ok)throw Error(name);};\n try{\n  const response=await rpc('scenario');if(response.results)results.push(...response.results);if(response.error||!response.passed)throw Error(response.error||'Falló el recorrido comercial');\n  const fresh=n=>new CVClient.Client(new CVClient.IndexedStore(run+n),{...transport},'TEST_ONLY_V3',uuid);\n  const payload=()=>enriched({type:'REGISTER_SALE',saleId:'future:'+uuid(),items:[{offerId:response.offerId,offerVersion:response.offerVersion,resourceId:response.resourceId,quantity:1}],channel:'WhatsApp',customer:{name:'Cliente ficticio de cola'}});\n  const off=fresh('offline'),q=await off.enqueue(payload());off.transport={status:async()=>{throw Error('OFFLINE_SIMULATED');}};await off.flush();record('Venta comercial sin conexión conserva comando en IndexedDB',(await off.view()).queue.length===1);\n  const restart=fresh('offline');record('Reapertura de IndexedDB conserva el operationId',(await restart.view()).queue[0].command.operationId===q.command.operationId);restart.transport={...transport,execute:async c=>{await transport.execute(c);throw Error('RESPONSE_LOST_SIMULATED');}};await restart.flush();record('Respuesta comercial perdida no anuncia confirmación',(await restart.view()).queue.length===1);restart.transport=transport;await restart.flush();record('Consulta recupera confirmación comercial original',!!(await restart.view()).receipts[q.command.operationId]);\n  const cancel=async saleId=>{const data=await rpc('snapshot');if(data.error)throw Error(data.error);const sale=data.sales[saleId],c=fresh('cancel-'+saleId);const queued=await c.enqueue(enriched({type:'CANCEL_SALE',saleId,expectedSaleVersion:sale.version,reason:'Fin de ensayo ficticio'}));for(let i=0;i<3;i++){await c.flush();if((await c.view()).receipts[queued.command.operationId])return;}throw Error('Cancelación de ensayo pendiente');};await cancel(q.command.saleId);\n  const a=fresh('A'),b=fresh('B'),qa=await a.enqueue(payload()),qb=await b.enqueue(payload());await Promise.all([a.flush(),b.flush()]);const va=await a.view(),vb=await b.view();record('Dos clientes comerciales: uno reserva la última bolsa',[va,vb].filter(s=>Object.keys(s.receipts).length===1).length===1);const loser=va.queue.length?a:b,rejected=(await loser.view()).queue[0];record('Stock insuficiente se conserva como rechazo terminal',(await rpc('status',rejected.command.operationId)).state==='REJECTED');await loser.archiveRejected(rejected.command.operationId);await cancel(va.queue.length?qb.command.saleId:qa.command.saleId);\n  const end=await rpc('snapshot');record('Ensayo no deja reservas ni descuenta físicamente por cobro',end.resources[response.resourceId].physical===1&&end.resources[response.resourceId].reserved===0);\n }catch(e){results.push({name:explain(e),passed:false});}\n finally{const report={run,passed:results.length>0&&results.every(r=>r.passed),results};try{const saved=await rpc('report',report);if(!saved.saved)throw Error('Informe no confirmado');}catch(e){report.passed=false;results.push({name:explain(e),passed:false});}$('results').textContent=run+'\\n'+(report.passed?'APROBADO':'REVISAR')+'\\n'+results.map(r=>(r.passed?'PASS ':'FAIL ')+r.name).join('\\n');notice(report.passed?'Integración comercial de pruebas aprobada.':'Revisa las verificaciones.');verifying=false;$('verify').disabled=false;dirty=false;await sync();}\n};\nwindow.addEventListener('online',sync);setInterval(()=>{if(!verifying)sync();},30000);\n(async()=>{await store.transact(s=>{s.commercialDraftSaleId=s.commercialDraftSaleId||'future:'+uuid();draftSaleId=s.commercialDraftSaleId;});const cached=await client.view();snapshot=cached.snapshot;if(snapshot)render();await sync();const result=await rpc('initialize');if(result.error)throw Error(result.error);notice('Laboratorio de pruebas. Usa solo datos ficticios.');})().catch(e=>notice(explain(e)));\n","sha256":"75442fb6dbcda36f76faa43ac5151fb6ce821a65d498dba604866e98d2e21258"},{"path":"fase4/web/shell.html","content":"<!doctype html><html lang=\"es\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Casa Vieja · Laboratorio comercial</title><style>\n  :root{\n    --bg:#1C1410;\n    --surface:#241B15;\n    --surface-2:#2E241C;\n    --surface-3:#382B20;\n    --border:#3D2F24;\n    --text:#F2E9DC;\n    --text-muted:#A8998A;\n    --accent-red:#C1432E;\n    --accent-gold:#D4A34A;\n    --accent-green:#6B8F5C;\n    --accent-blue:#5C7F8F;\n    --radius:10px;\n    --font-display:'Iowan Old Style','Palatino Linotype',Georgia,serif;\n    --font-body:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;\n  }\n  *{box-sizing:border-box;}\n  html,body{margin:0;padding:0;}\n  body{\n    background:var(--bg);\n    color:var(--text);\n    font-family:var(--font-body);\n    min-height:100vh;\n    padding-bottom:env(safe-area-inset-bottom);\n  }\n  #app{display:flex;min-height:100vh;}\n  \n  /* Sidebar */\n  .sidebar{\n    width:220px;flex-shrink:0;background:var(--surface);\n    border-right:1px solid var(--border);\n    display:flex;flex-direction:column;padding:20px 0;\n  }\n  .brand{padding:0 20px 18px 20px;border-bottom:1px solid var(--border);margin-bottom:10px;}\n  .brand h1{font-family:var(--font-display);font-size:20px;margin:0 0 2px 0;font-weight:600;letter-spacing:.3px;}\n  .brand span{font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:1px;}\n  nav.navlist{\n    display:flex;flex-direction:column;gap:2px;padding:0 10px;\n    -webkit-overflow-scrolling:touch;\n  }\n  .nav-btn{\n    display:flex;align-items:center;gap:10px;\n    background:none;border:none;color:var(--text-muted);\n    padding:10px 12px;border-radius:8px;cursor:pointer;\n    font-size:14px;text-align:left;font-family:var(--font-body);\n    transition:background .15s, color .15s;\n  }\n  .nav-btn svg{flex-shrink:0;opacity:.8;}\n  .nav-btn:hover{background:var(--surface-2);color:var(--text);}\n  .nav-btn.active{background:var(--surface-3);color:var(--text);font-weight:600;}\n  .nav-btn.active svg{opacity:1;}\n  .sidebar-footer{margin-top:auto;padding:14px 20px 0 20px;border-top:1px solid var(--border);}\n  .sidebar-footer p{font-size:11px;color:var(--text-muted);line-height:1.5;margin:10px 0 0 0;}\n  #connStatus.online{color:var(--accent-green);}\n  #connStatus.offline{color:var(--text-muted);}\n  \n  /* Main */\n  .main{flex:1;min-width:0;padding:26px 34px 60px 34px;}\n  .topbar{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:22px;flex-wrap:wrap;gap:8px;}\n  .topbar h2{font-family:var(--font-display);font-size:26px;margin:0;font-weight:600;}\n  .topbar .today{font-size:13px;color:var(--text-muted);}\n  .view{display:none;}\n  .view.active{display:block;animation:fadein .2s ease;}\n  @keyframes fadein{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:translateY(0);}}\n  \n  /* Cards / grid */\n  .grid{display:grid;gap:14px;}\n  .grid-kpi{grid-template-columns:repeat(auto-fit,minmax(180px,1fr));margin-bottom:22px;}\n  .grid-charts{grid-template-columns:repeat(auto-fit,minmax(320px,1fr));}\n  .card{\n    background:var(--surface);border:1px solid var(--border);\n    border-radius:var(--radius);padding:16px 18px;\n  }\n  .kpi-label{font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:var(--text-muted);margin:0 0 8px 0;}\n  .kpi-value{font-family:var(--font-display);font-size:26px;font-weight:600;font-variant-numeric:tabular-nums;margin:0;}\n  .kpi-value.red{color:var(--accent-red);}\n  .kpi-value.gold{color:var(--accent-gold);}\n  .kpi-value.green{color:var(--accent-green);}\n  .kpi-sub{font-size:11px;color:var(--text-muted);margin-top:6px;}\n  .card h3{font-size:14px;margin:0 0 14px 0;font-weight:600;color:var(--text);}\n  .card h3 small{display:block;font-size:11px;color:var(--text-muted);font-weight:400;margin-top:2px;}\n  \n  /* Chart bits */\n  .chart-svg{width:100%;height:auto;display:block;}\n  .legend{display:flex;flex-direction:column;gap:6px;margin-top:12px;font-size:12px;}\n  .legend-row{display:flex;align-items:center;gap:8px;justify-content:space-between;}\n  .legend-left{display:flex;align-items:center;gap:8px;color:var(--text-muted);}\n  .dot{width:9px;height:9px;border-radius:50%;flex-shrink:0;}\n  .donut-wrap{display:flex;gap:20px;align-items:center;flex-wrap:wrap;}\n  .donut{width:120px;height:120px;border-radius:50%;position:relative;flex-shrink:0;}\n  .donut::after{content:'';position:absolute;inset:22px;background:var(--surface);border-radius:50%;}\n  .donut-center{position:absolute;inset:22px;display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--text-muted);text-align:center;z-index:2;}\n  \n  /* Ripeness stock scale */\n  .stock-row{margin-bottom:14px;}\n  .stock-row-head{display:flex;justify-content:space-between;font-size:12.5px;margin-bottom:5px;}\n  .stock-row-head b{font-weight:600;}\n  .stock-row-head span.low{color:var(--accent-red);font-weight:600;}\n  .ripeness-track{position:relative;height:10px;border-radius:6px;overflow:hidden;\n    background:linear-gradient(90deg,var(--accent-red) 0%,var(--accent-gold) 45%,var(--accent-green) 100%);}\n  .ripeness-mask{position:absolute;top:0;right:0;height:100%;background:var(--surface-2);}\n  .ripeness-min{position:absolute;top:-2px;width:2px;height:14px;background:var(--text);opacity:.8;}\n  \n  /* Forms */\n  .form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:14px;}\n  label{display:block;font-size:11px;color:var(--text-muted);margin-bottom:5px;text-transform:uppercase;letter-spacing:.4px;}\n  input,select{\n    width:100%;background:var(--surface-2);border:1px solid var(--border);color:var(--text);\n    padding:9px 10px;border-radius:7px;font-size:13.5px;font-family:var(--font-body);\n  }\n  input:focus,select:focus{outline:2px solid var(--accent-gold);outline-offset:1px;}\n  .btn{\n    background:var(--accent-gold);color:#231A12;border:none;padding:10px 16px;\n    border-radius:7px;font-size:13.5px;font-weight:600;cursor:pointer;font-family:var(--font-body);\n  }\n  .btn:hover{filter:brightness(1.08);}\n  .btn.secondary{background:var(--surface-3);color:var(--text);border:1px solid var(--border);}\n  .btn.danger{background:var(--accent-red);color:#fff;}\n  .btn.small{padding:5px 10px;font-size:12px;}\n  .btn:focus-visible, .nav-btn:focus-visible, select:focus-visible, input:focus-visible{outline:2px solid var(--accent-gold);outline-offset:2px;}\n  \n  /* Table */\n  .table-wrap{\n    overflow-x:auto;\n    -webkit-overflow-scrolling:touch;\n  }\n  table{width:100%;border-collapse:collapse;font-size:13px;}\n  th{text-align:left;color:var(--text-muted);font-size:11px;text-transform:uppercase;letter-spacing:.4px;padding:8px 10px;border-bottom:1px solid var(--border);white-space:nowrap;}\n  td{padding:9px 10px;border-bottom:1px solid var(--border);white-space:nowrap;}\n  tr:last-child td{border-bottom:none;}\n  .pill{display:inline-block;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:600;}\n  .pill.green{background:rgba(107,143,92,.18);color:var(--accent-green);}\n  .pill.gold{background:rgba(212,163,74,.18);color:var(--accent-gold);}\n  .pill.red{background:rgba(193,67,46,.18);color:var(--accent-red);}\n  .empty{color:var(--text-muted);font-size:13px;padding:24px 4px;text-align:center;border:1px dashed var(--border);border-radius:var(--radius);}\n  .section-title{font-family:var(--font-display);font-size:18px;font-weight:600;margin:26px 0 12px 0;}\n  .section-title:first-child{margin-top:0;}\n  .row-actions{display:flex;gap:6px;}\n  .hint{font-size:11.5px;color:var(--text-muted);margin-top:-4px;margin-bottom:14px;}\n  .toolbar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px;}\n  .flexend{display:flex;justify-content:flex-end;gap:10px;flex-wrap:wrap;}\n\n  /* Acordeón (tarjetas desplegables para historiales) */\n  .acc-list{display:flex;flex-direction:column;gap:8px;}\n  .acc-item{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;}\n  .acc-head{display:flex;align-items:center;gap:10px;padding:12px 14px;cursor:pointer;user-select:none;}\n  .acc-head:hover{background:var(--surface-2);}\n  .acc-num{flex:0 0 auto;min-width:26px;color:var(--text-muted);font-size:12px;font-weight:600;}\n  .acc-summary{flex:1 1 auto;min-width:0;display:flex;flex-wrap:wrap;align-items:center;gap:6px 12px;}\n  .acc-summary .acc-main{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}\n  .acc-summary .acc-sub{color:var(--text-muted);font-size:12px;white-space:nowrap;}\n  .acc-summary .acc-amt{margin-left:auto;font-weight:700;white-space:nowrap;}\n  .acc-caret{flex:0 0 auto;color:var(--text-muted);transition:transform .15s;font-size:12px;}\n  .acc-item.open .acc-caret{transform:rotate(180deg);}\n  .acc-body{display:none;padding:4px 14px 14px 14px;border-top:1px solid var(--border);}\n  .acc-item.open .acc-body{display:block;}\n  .acc-fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px 16px;margin:10px 0;}\n  .acc-field label{margin-bottom:2px;}\n  .acc-field div{font-size:13.5px;}\n  .acc-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;}\n  .wf-row{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:9px 0;border-bottom:1px solid var(--border);font-size:14px;}\n  .wf-row small{display:block;color:var(--text-muted);font-size:11px;font-weight:400;}\n  .wf-row b{white-space:nowrap;font-variant-numeric:tabular-nums;}\n  .wf-row.neg b{color:var(--accent-red);}\n  .wf-row.total{border-bottom:none;border-top:2px solid var(--border);margin-top:4px;padding-top:12px;font-size:16px;font-weight:600;}\n  .wf-row.total b{font-family:var(--font-display);font-size:24px;}\n  .split-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px;margin-top:14px;}\n  .split-box{background:var(--surface-2);border:1px solid var(--border);border-radius:8px;padding:12px 14px;}\n  .split-box .nm{font-weight:600;margin-bottom:6px;}\n  .split-box .ln{display:flex;justify-content:space-between;font-size:12.5px;color:var(--text-muted);padding:2px 0;}\n  .split-box .tt{display:flex;justify-content:space-between;font-weight:700;padding-top:6px;margin-top:4px;border-top:1px solid var(--border);}\n  .acc-item.static .acc-head{cursor:default;}\n  .acc-item.static .acc-head:hover{background:none;}\n  .acc-field input,.acc-field select{width:100%;}\n  .pill.blue{background:rgba(92,127,143,.18);color:var(--accent-blue);}\n  .acc-list + .acc-list{margin-top:8px;}\n  @media (max-width:880px){\n    .acc-summary .acc-main{max-width:140px;}\n  }\n\n  /* Botón hamburguesa (solo visible en móvil) */\n  .hamburger-btn{\n    display:none;background:var(--surface-2);border:1px solid var(--border);color:var(--text);\n    width:40px;height:40px;border-radius:8px;cursor:pointer;flex-shrink:0;\n    align-items:center;justify-content:center;\n  }\n\n  /* ADAPTACIÓN MÓVIL (IPHONE / SMARTPHONES) */\n  @media (max-width:880px){\n    #app{flex-direction:column;}\n    .sidebar{\n      width:100%;flex-direction:column;align-items:stretch;position:relative;z-index:500;\n      padding: max(12px, env(safe-area-inset-top)) 14px 12px 14px;\n    }\n    .brand{border:none;padding:0;margin:0;display:flex;align-items:center;justify-content:space-between;}\n    .hamburger-btn{display:flex;}\n    nav.navlist{\n      flex-direction:column;padding:0;margin-top:0;max-height:0;overflow:hidden;\n      transition:max-height .2s ease, margin-top .2s ease;\n    }\n    nav.navlist.open{max-height:480px;margin-top:12px;}\n    .sidebar-footer{display:none;}\n    .main{padding:16px 16px 50px 16px;}\n    \n    input, select, textarea {\n      font-size: 16px !important;\n    }\n    \n    .btn, .nav-btn {\n      min-height: 44px;\n      display: inline-flex;\n      align-items: center;\n    }\n    .btn{justify-content:center;}\n    .nav-btn{justify-content:flex-start;}\n  }\n</style><style>.cv-toolbar{display:flex;gap:10px;flex-wrap:wrap;margin:12px 0}.cv-section{display:none}.cv-section.active{display:block}.cv-card-gap{margin-bottom:14px}.cv-lines{display:grid;gap:10px}.cv-line{display:grid;grid-template-columns:2fr 2fr 90px 44px;gap:8px}.cv-badge{padding:4px 9px;border-radius:12px;background:var(--surface-3)}.cv-help{font-size:12px;color:var(--text-muted)}.cv-summary{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin:14px 0}.cv-summary article{padding:14px;background:var(--surface-2);border-radius:8px}.cv-summary strong{display:block;font-size:23px;margin-top:8px}dialog{background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:12px;width:min(740px,94vw);max-height:90vh;overflow:auto}dialog::backdrop{background:#0009}.cv-table{overflow-x:auto}textarea{width:100%;background:var(--surface-2);color:var(--text);border:1px solid var(--border);border-radius:7px;padding:10px}.cv-privacy{font-size:12px;padding:12px;border:1px solid var(--border)}@media(max-width:600px){.cv-line{grid-template-columns:1fr}.cv-summary{grid-template-columns:1fr 1fr}.main{padding:16px}.cv-toolbar .btn{flex:1}} </style></head><body><div id=\"app\"><aside class=\"sidebar\"><div class=\"brand\"><div><h1>Casa Vieja</h1><span>Control de operaciones</span></div><button class=\"hamburger-btn\" id=\"menu\" aria-label=\"Abrir menú\">☰</button></div><nav class=\"navlist\" id=\"nav\"></nav><div class=\"sidebar-footer\"><p>Laboratorio privado. Solo datos ficticios.</p><p>El historial comercial original permanece separado.</p></div></aside><main class=\"main\"><div class=\"topbar\"><h2 id=\"title\">Resumen comercial</h2><span class=\"cv-badge\" id=\"connection\">Conectando</span></div><p id=\"notice\" role=\"status\" aria-live=\"polite\">Preparando el laboratorio…</p><div class=\"cv-toolbar\"><button class=\"btn secondary\" id=\"sync\">Sincronizar</button><span id=\"pending\"></span></div><section id=\"dashboard\" class=\"cv-section active\"></section><section id=\"sales\" class=\"cv-section\"></section><section id=\"orders\" class=\"cv-section\"></section><section id=\"inventory\" class=\"cv-section\"></section><section id=\"lots\" class=\"cv-section\"></section><section id=\"purchases\" class=\"cv-section\"></section><section id=\"expenses\" class=\"cv-section\"></section><section id=\"customers\" class=\"cv-section\"></section><section id=\"reports\" class=\"cv-section\"></section><section id=\"config\" class=\"cv-section\"></section><section class=\"card\" style=\"margin-top:20px\"><h3>Operaciones pendientes</h3><div id=\"queue\"></div></section><details class=\"card\" style=\"margin-top:14px\"><summary>Verificaciones del laboratorio</summary><p>Ensayo con datos ficticios. No habilita operaciones comerciales.</p><button class=\"btn secondary\" id=\"verify\">Verificar integración comercial</button><pre id=\"results\" style=\"white-space:pre-wrap;overflow-wrap:anywhere\"></pre></details></main></div><dialog id=\"dialog\"><h3 id=\"dialog-title\"></h3><form id=\"dialog-form\"><div id=\"dialog-body\"></div><p id=\"dialog-error\" role=\"alert\"></p><div class=\"cv-toolbar\"><button class=\"btn\" type=\"submit\">Confirmar operación de pruebas</button><button class=\"btn secondary\" type=\"button\" id=\"dialog-cancel\">Cerrar</button></div></form></dialog>","sha256":"a15fa004f32e608096c1d7fedcefd91f4a02c4872dcc1ea8468e5821e69a92b5"},{"path":"fase5a/build.cjs","content":"// Compile an isolated review candidate. No upload or deployment.\nconst fs=require('node:fs'),path=require('node:path');const root=__dirname,read=p=>fs.readFileSync(path.join(root,p),'utf8');\nconst suffix='/* GENERATED_REFINEMENT_5A2 */';\nconst baseUX=read('web/ux.js').split(suffix)[0];fs.writeFileSync(path.join(root,'web/ux.js'),baseUX+suffix+'\\n'+read('refinamiento-5a2/components.js')+'\\n'+read('refinamiento-5a2/refinement.js'));\nconst cssMarker='/* GENERATED_STYLE_5A2 */',baseCSS=read('web/ux.css').split(cssMarker)[0];fs.writeFileSync(path.join(root,'web/ux.css'),baseCSS+cssMarker+'\\n'+read('refinamiento-5a2/refinement.css'));\nlet shell=read('web/shell.html');const marker=shell.indexOf('/* Evolución visual'),end=shell.indexOf('</style>',marker);if(marker<0||end<0)throw Error('CSS_MARKER');shell=shell.slice(0,marker)+read('web/ux.css')+shell.slice(end);fs.writeFileSync(path.join(root,'web/shell.html'),shell);\nconst html=shell+'<script>'+read('../fase2/client.js')+'\\n'+read('web/app.js')+'\\n'+read('web/ux.js')+'</script></body></html>';\nif(/https:\\/\\/script.google.com\\/macros\\/|TOKEN_SECRETO|cv_script_token|Windsor.*(?:token|key)/.test(html))throw Error('UNSAFE_FRONTEND');\nconst previous=read('../fase4/apps-script/Code.gs'),cut=previous.lastIndexOf('const COMMERCIAL_HTML_=');if(cut<0)throw Error('MISSING_BASE_HTML');const code=previous.slice(0,cut)+'const COMMERCIAL_HTML_='+JSON.stringify(html)+';';fs.mkdirSync(path.join(root,'apps-script'),{recursive:true});fs.writeFileSync(path.join(root,'apps-script/Index.html'),html);fs.writeFileSync(path.join(root,'apps-script/Code.gs'),code);console.log(JSON.stringify({previousBackendPreserved:true,newWriteDestinations:0,deployed:false,htmlChars:html.length,codeChars:code.length}));\n","sha256":"bf0bdbe1eb9793fcac802e6292ad18588fa156df66e8e98564fb22cb9d7a49dc"},{"path":"fase5a/refinamiento-5a2/components.js","content":"/* Pure presentation helpers. No stock, cost or profit rules. */\n(function(root,factory){if(typeof module==='object'&&module.exports)module.exports=factory();else root.CVVisual=factory();})(typeof globalThis!=='undefined'?globalThis:this,function(){\n'use strict';\nconst paths={dashboard:'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z',sales:'M3 4h2l2 12h11l3-9H6M9 20h.01M17 20h.01',orders:'M6 3h12v18H6zM9 8h6M9 12h6M9 16h4',inventory:'m3 7 9-4 9 4v10l-9 4-9-4zM3 7l9 4 9-4M12 11v10',lots:'M12 3c8 4 8 14 0 18-8-4-8-14 0-18zM12 5c-4 5 4 9 0 14',purchases:'M3 9h18v12H3zM7 9V5h10v4M9 13h6',expenses:'M4 5h16v14H4zM4 9h16M8 14h3',customers:'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M18 8a3 3 0 0 1 0 6M22 21v-2a4 4 0 0 0-3-4',reports:'M4 20V10M10 20V4M16 20v-7M22 20H2',config:'M4 7h16M4 17h16M8 4v6M16 14v6',ads:'m3 9 14-5v16L3 15zM6 16l2 5M21 8v8',cash:'M3 6h18v12H3zM12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6M6 12h.01M18 12h.01',clock:'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18M12 7v5l3 2',trend:'M3 17l6-6 4 4 8-10M15 5h6v6'};\nfunction icon(name){return '<svg class=\"nav-icon\" aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"'+(paths[name]||paths.dashboard)+'\"/></svg>';}\nfunction lastDays(from,to,max=7){if(!/^\\d{4}-\\d{2}-\\d{2}$/.test(from)||!/^\\d{4}-\\d{2}-\\d{2}$/.test(to)||from>to)throw Error('INVALID_RANGE');const out=[];let cursor=new Date(to+'T12:00:00Z');for(let i=0;i<max;i++){const d=cursor.toISOString().slice(0,10);if(d<from)break;out.unshift(d);cursor.setUTCDate(cursor.getUTCDate()-1);}return out;}\nfunction points(values,width=520,height=170){if(!values.length)return [];if(!values.every(Number.isFinite))throw Error('INVALID_SERIES');const min=Math.min(0,...values),max=Math.max(0,...values),span=max-min||1;return values.map((v,i)=>({x:38+(values.length===1?(width-58)/2:i*(width-58)/(values.length-1)),y:12+(max-v)*(height-30)/span,value:v}));}\nfunction reportKey(revision,from,to){return String(revision)+':'+from+':'+to;}\nfunction expenseRows(report){return [{name:'Gastos operativos',value:report.operatingExpenseCents,color:'#6b8f5c'},{name:'Distribución de pedidos',value:report.distributionCents,color:'#b98c3d'},{name:'Merma extraordinaria',value:report.stockLossCents,color:'#a63a2b'}];}\nfunction pendingOrders(sales){return Object.values(sales).filter(s=>s.commercial&&(s.status==='RESERVED'||s.status==='DISPATCHED'&&!s.delivered)).length;}\nfunction customerContact(customer,sales){const found=[...customer.orders].map(id=>sales[id]).filter(Boolean).sort((a,b)=>String(b.metadata.date).localeCompare(String(a.metadata.date)))[0];return {name:customer.name||'',phone:customer.phone||'',zone:found?.metadata.zone||'',note:''};}\nreturn {icon,lastDays,points,reportKey,expenseRows,pendingOrders,customerContact};});\n","sha256":"d812c427245572e1c0f47f1ec83f9b7eb2e6c90b2065f1ea6faf820ce8d10d9a"},{"path":"fase5a/refinamiento-5a2/refinement.css","content":"/* 5A.2: Cas