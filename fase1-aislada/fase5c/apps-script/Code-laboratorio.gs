ge.to);return `<article class=\"card\"><div class=\"panel-head\"><div><h3>Publicidad, con evidencia</h3><p>Registros manuales confirmados del laboratorio</p></div><span class=\"tag demo\">Sin Meta</span></div><div class=\"manual-ads\">${rows.map(e=>`<article><span>${esc(e.description||'Publicidad registrada')}<small style=\"display:block\">${esc(CVCommercialDay(e.date))}</small></span><b>${money(e.amountCents)}</b></article>`).join('')||'<p class=\"cv-help\">No hay gastos publicitarios manuales en este período.</p>'}</div><p class=\"cv-help\">Sin conexión a Windsor.ai. Conversaciones y ROAS de la demo publicitaria no se incorporan a este panel.</p><button class=\"btn secondary\" data-home-view=\"ads\">Ver propuesta de Publicidad</button></article>`;}\nfunction CVCommercialDay(value){return new Date(Date.parse(value)-5*3600000).toISOString().slice(0,10);}\nfunction shortLot(r){const lot=snapshot?.lots?.[r.lot];return lot?`${lot.family} · ${lot.origin}`:'Partida de laboratorio';}\nfunction drawHome(){if(view!=='dashboard'||!snapshot)return;const stale=homeData&&(homeData.revision!==snapshot.revision||homeData.from!==homeRange.from||homeData.to!==homeRange.to);let html=`<div class=\"home-hero\"><div><div class=\"eyebrow\">Casa Vieja Café · gestión diaria</div><h3>Tu negocio, a primera vista</h3><p>Pedidos, dinero e inventario con su propio contexto.</p></div><div class=\"home-actions\"><button class=\"btn\" data-sale-modal>+ Registrar venta rápida</button><button class=\"btn secondary\" data-home-view=\"orders\">Ver pedidos</button></div></div>${homeFilter()}`;\n if(homeError)html+=`<div class=\"home-state\" role=\"alert\"><strong>No se pudo actualizar el panel</strong>${esc(homeError)}. Se conservan los datos anteriores; no se interpreta como cero.</div>`;\n if(!homeData){$('dashboard').innerHTML=html+`<div class=\"home-state\" role=\"status\"><span class=\"home-loading\"></span>${homeBusy?'Consultando reportes confirmados del laboratorio…':'Panel aún no disponible. U