pt/Laboratory.gs').replace('function sandboxExecute(command){','function sandboxExecutePhase5B_(command){')+'\\n'+constants+read('access.js')+'\\n'+read('apps-script/Gateway.gs')+'\\nconst CV5C_CLIENT_EXPORTS_='+JSON.stringify(fs.existsSync(path.join(root,'tests/device-exports.synthetic.json'))?JSON.parse(read('tests/device-exports.synthetic.json')):{scope:'SERVER_ONLY_DEVICE_EXPORTS_PENDING',origins:[],states:[]})+';\\nconst CV5C_ARTIFACTS_='+JSON.stringify(artifacts)+';\\n'+read('apps-script/Laboratory.gs')+'\\n'+read('apps-script/Race.gs')+'\\nconst CV5C_CANDIDATE_HTML_='+JSON.stringify(html)+';\\nconst CV5C_PROBE_HTML_='+JSON.stringify(read('web/probe.html'))+';';\nfs.writeFileSync(path.join(root,'apps-script/Code-laboratorio.gs'),laboratory);fs.writeFileSync(path.join(root,'release-manifest.json'),JSON.stringify({environment:'TEST_ONLY',release,baseCommit:'c013be7c37b682bf7b1901f1d2835df5713e9cef',files:artifacts.map(({path,sha256})=>({path,sha256})),exposed,externalAuthenticationEnabled:false,productionEnabled:false},null,2)+'\\n');\nconsole.log(JSON.stringify({release,exposed,productionEnabled:false}));\n","sha256":"910bfc8f7581f526381b148811876b72695947b469c68556333c34b912f2fbe7"},{"path":"fase5c/continuity.js","content":"/* Inspección de solo lectura del origen actual. No crea, borra ni transforma bases antiguas. */\n(function(root,factory){const api=factory();if(typeof module==='object'&&module.exports)module.exports=api;else root.CVContinuity=api;})(typeof globalThis==='object'?globalThis:this,function(){\n'use strict';\nconst versions=Object.freeze([\n {name:'cv-sales-sandbox-v2-owner',engine:'V2',epoch:'TEST_ONLY_V2'},\n {name:'cv-inventory-sandbox-v3-owner',engine:'V3',epoch:'TEST_ONLY_V3'},\n {name:'cv-commercial-sandbox-v4-owner',engine:'V4',epoch:'TEST_ONLY_V3'},\n {name:'cv-commercial-sandbox-v5a-owner',engine:'V4',epoch:'TEST_ONLY_V3'}\n]);\nconst clone=x=>JSON.parse(JSON.stringify(x));\nfunction describe(version,data,origin){\n if(!data)return {...version,origin,status:'EMPTY',pending:[],receiptCount:0};\n if(!Array.isArray(data.queue)||!data.receipts||typeof data.receipts!=='object')return {...version,origin,status:'UNREADABLE',pending:[],receiptCount:0};\n const pending=data.queue.map(q=>({operationId:q.command?.operationId,saleId:q.command?.saleId,epoch:q.command?.epoch,schemaVersion:q.command?.schemaVersion,commercialVersion:q.command?.commercialVersion,state:q.state,deviceId:q.command?.deviceId,engine:version.engine}));\n const invalid=pending.some(p=>typeof p.operationId!=='string'||p.epoch!==version.epoch||p.schemaVersion!==2||(version.engine==='V4'&&p.commercialVersion!==4)||!['PENDING','REJECTED'].includes(p.state));\n return {...version,origin,status:invalid?'INCOMPATIBLE':pending.length?'UNRESOLVED':'CLEAR',pending,receiptCount:Object.keys(data.receipts).length};\n}\nasync function scan({list,read,origin,otherOriginsConfirmed=false}){\n let databases;try{databases=await list();}catch(e){return {origin,blocked:true,reason:'ENUMERATION_UNAVAILABLE',databases:[],otherOriginsConfirmed:false};}\n const names=new Set(databases.map(x=>typeof x==='string'?x:x.name)),results=[];\n for(const v of versions){if(!names.has(v.name)){results.push({...v,origin,status:'ABSENT',pending:[],receiptCount:0});continue;}try{results.push(describe(v,await read(v.name),origin));}catch(e){results.push({...v,origin,status:'UNREADABLE',pending:[],receiptCount:0});}}\n // Bases de ensayos y futuras versiones también pueden contener una cola: no ocultarlas.\n for(const name of names)if(name&&!versions.some(v=>v.name===name)&&/^cv-|^(inventory|commercial)-browser-/.test(name)){try{const data=await read(name);if(data?.queue?.length)results.push({name,origin,status:'UNKNOWN_QUEUE',pending:data.queue.map(q=>({operationId:q.command?.operationId,state:q.state})),receiptCount:Object.keys(data.receipts||{}).length});}catch(e){results.push({name,origin,status:'UNREADABLE',pending:[],receiptCount:0});}}\n const unresolved=results.some(d=>!['CLEAR','EMPTY','ABSENT'].includes(d.status));\n return {origin,blocked:unresolved||!otherOriginsConfirmed,reason:unresolved?'UNRESOLVED_QUEUES':otherOriginsConfirmed?'CLEAR_THIS_ORIGIN':'OTHER_ORIGINS_NOT_ATTESTED',otherOriginsConfirmed,databases:results};\n}\nfunction browserAdapter(indexedDB,origin){return {origin,list:()=>{if(typeof indexedDB.databases!=='function')throw Error('ENUMERATION_UNAVAILABLE');return indexedDB.databases();},read:name=>new Promise((resolve,reject)=>{const r=indexedDB.open(name);let absent=false;r.onupgradeneeded=()=>{absent=true;r.transaction.abort();};r.onerror=()=>absent?resolve(null):reject(Error('STORAGE_UNREADABLE'));r.onblocked=()=>reject(Error('STORAGE_BLOCKED'));r.onsuccess=()=>{const db=r.result;if(db.version!==1||!db.objectStoreNames.contains('state')){db.close();reject(Error('STORAGE_VERSION_UNSUPPORTED'));return;}const tx=db.transaction('state','readonly'),req=tx.objectStore('state').get('current');let value;req.onsuccess=()=>value=req.result;tx.oncomplete=()=>{db.close();resolve(value||null)};tx.onerror=tx.onabort=()=>{db.close();reject(Error('STORAGE_UNREADABLE'))};};})};}\nasync function recoverConfirmation({entry,version,transport,client}){\n if(entry.command.epoch!==version.epoch||entry.command.schemaVersion!==2||(version.engine==='V4'&&entry.command.commercialVersion!==4))throw Error('INCOMPATIBLE_ENGINE');\n const original=JSON.stringify(entry.command),r=await transport.status(entry.command.operationId);\n if(!r||r.epoch!==entry.command.epoch||r.operationId!==entry.command.operationId)throw Error('UNVERIFIED_STATUS');\n if(r.state==='COMMITTED'){if(r.saleId!==entry.command.saleId)throw Error('UNVERIFIED_STATUS');await client.ack(r,clone(entry.command));return {confirmed:true,receipt:r};}\n // UNKNOWN/PREPARED no prueba ausencia de venta. Reintentar solamente en su motor original.\n if(JSON.stringify(entry.command)!==original)throw Error('COMMAND_CHANGED');\n return {confirmed:false,state:r.state,retryOnlyOriginalEngine:true,canArchive:r.state==='REJECTED'};\n}\nasync function exportDevice(adapter){const names=(await adapter.list()).map(x=>typeof x==='string'?x:x.name).filter(name=>versions.some(v=>v.name===name)||/^cv-commercial-sandbox-v5c-/.test(name||'')),states=[],failures=[];for(const name of names){try{const data=await adapter.read(name);if(data)states.push({name,origin:adapter.origin,data:clone(data)})}catch(e){failures.push({name,error:'UNREADABLE'})}}return {format:'CV_DEVICE_EXPORT_5C',environment:'TEST_ONLY',capturedAt:new Date().toISOString(),origin:adapter.origin,scope:'CURRENT_ORIGIN_ONLY',states,failures,otherOriginsCovered:false};}\nreturn {versions,describe,scan,browserAdapter,recoverConfirmation,exportDevice};\n});\n","sha256":"59e101c556a88190f86d7648b14fbc6b17c773d4857e111eae871caad5cf0063"},{"path":"fase5c/web/admin-dashboard.js","content":"// Misma vista 5A.2, una sola revisión y una sola reconstrucción por consulta del panel.\nasync function loadHome(force=false){if(!snapshot)return;if(homeBusy){if(force)homeReloadRequested=true;return;}const revision=snapshot.revision,range={...homeRange};if(!force&&homeData?.revision===revision&&homeData.from===range.from&&homeData.to===range.to&&!homeError)return;homeBusy=true;homeError='';const request=++homeRequest;drawHome();try{const r=await cv5cRPC('dashboard',{from:range.from,to:range.to,today:today(),days:CVVisual.lastDays(range.from,range.to),revision});if(r.error)throw Error(r.error);if(request!==homeRequest||homeRange.from!==range.from||homeRange.to!==range.to)return;homeData={...r,from:range.from,to:range.to,loadedAt:new Date().toISOString()};homeSelected=Math.max(0,homeData.daily.length-1);await store.transact(s=>s.uxHome5a2=homeData);}catch(e){homeError=e.message==='REVISION_CHANGED'?'El diario cambió. Actualiza para consultar una revisión consistente.':explain(e);}finally{homeBusy=false;if(view==='dashboard'){drawHome();if(homeReloadRequested){homeReloadRequested=false;loadHome(true)}}}}\n","sha256":"7240b5181ee78ac17d71defa89d771e7ba920e52ed4fbe0002432801422f2e29"},{"path":"fase5c/web/guard.js","content":"/* Se instala antes del código 5A. Conserva sus bases y comandos; bloquea escrituras nuevas hasta revisar continuidad. */\nconst cv5cReview=()=>CVContinuity.scan(CVContinuity.browserAdapter(indexedDB,location.origin));\nconst cv5cContinuity=cv5cReview();\nconst CV5CBaseClient=CVClient.Client;\nCVClient.Client=class extends CV5CBaseClient{\n async continuityCheck(){const report=await cv5cReview();if(report.blocked)throw Error('CONTINUITY_REVIEW_REQUIRED');document.getElementById('continuity-review')?.remove();}\n async enqueue(payload){await this.continuityCheck();return super.enqueue(payload)}\n async flush(){const local=await this.view();const version=CVContinuity.versions.find(v=>v.name===this.store.name);if(!version||CVContinuity.describe(version,local,location.origin).status==='INCOMPATIBLE')throw Error('INCOMPATIBLE_ENGINE');return super.flush()}\n};\ndocument.addEventListener('DOMContentLoaded',async()=>{\n const report=await cv5cContinuity;if(!report.blocked)return;\n const box=document.createElement('section');box.className='card';box.setAttribute('role','alert');box.id='continuity-review';\n const title=document.createElement('h2');title.textContent='Revisión de operaciones pendientes';box.append(title);\n const text=document.createElement('p');text.textContent='La actualización está bloqueada hasta verificar las colas de este equipo y los demás dispositivos. No se borró ni transformó ninguna operación.';box.append(text);\n for(const db of report.databases){const row=document.createElement('p');row.textContent=db.name+': '+db.status+' · '+db.pending.length+' pendiente(s)';box.append(row)}\n const warning=document.createElement('p');warning.textContent='Las colas de otros dominios o perfiles del navegador deben revisarse desde su versión original. La ausencia de bases aquí no confirma que esos equipos estén cerrados.';box.append(warning);\n const exportButton=document.createElement('button');exportButton.className='btn secondary';exportButton.textContent='Guardar respaldo de este equipo';exportButton.onclick=async()=>{try{const exported=await CVContinuity.exportDevice(CVContinuity.browserAdapter(indexedDB,location.origin));const link=document.createElement('a');link.href=URL.createObjectURL(new Blob([JSON.stringify(exported,null,2)],{type:'application/json'}));link.download='CasaVieja-colas-laboratorio.json';link.click();URL.revokeObjectURL(link.href);}catch(e){warning.textContent='No se pudo respaldar. Conserva este navegador y sus datos.';}};box.append(exportButton);document.body.prepend(box);\n});\n","sha256":"a2c29bb39b1be05e0f4074020a309550fd085d3cfb959cb1fd2ff29efb6dfae2"},{"path":"fase5c/web/probe.html","content":"<!doctype html><html lang=\"es\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Ensayo privado 5C</title><style>body{font:16px system-ui;background:#1c1410;color:#f2e9dc;margin:24px}button{padding:14px;background:#d4a34a;color:#231a12;border:0;border-radius:8px}pre{white-space:pre-wrap;overflow-wrap:anywhere}</style><h1>Casa Vieja · Ensayo privado 5C</h1><p>Solo datos e identidades ficticias. Tres solicitudes simultáneas del propietario; no certifica inicio de sesión de tres cuentas reales.</p><button id=\"run\">Probar tres solicitudes simultáneas</button><p id=\"status\" role=\"status\">Pendiente</p><pre id=\"results\"></pre><script>\nconst rpc=(method,arg)=>new Promise((resolve,reject)=>{const r=google.script.run.withSuccessHandler(resolve).withFailureHandler(reject);if(method==='race')r.lab5cRace(arg);else r.lab5cRaceCleanup();});\ndocument.getElementById('run').onclick=async()=>{document.getElementById('run').disabled=true;document.getElementById('status').textContent='Ejecutando en Google…';try{const start=performance.now(),requests=await Promise.all([1,2,3].map(slot=>rpc('race',slot))),cleanup=await rpc('cleanup');const report={environment:'GOOGLE_PRIVATE_DEV_SYNTHETIC',requests,cleanup,browserTotalMs:performance.now()-start,passed:requests.every(r=>!r.error)&&cleanup.passed===true};document.getElementById('results').textContent=JSON.stringify(report,null,2);document.getElementById('status').textContent=report.passed?'Ensayo aprobado. No habilita producción.':'Revisar resultados.';}catch(e){document.getElementById('status').textContent='Sin confirmar: '+e.message;}finally{document.getElementById('run').disabled=false}};\n</script></html>\n","sha256":"48b81454babaf740a504bfd4aabab74d6bcff2068a40900fc30391039b545a51"},{"path":"fase5c/web/role-ui.js","content":"/* Vistas limitadas: el servidor ya entrega DTO sin costos ni clientes ajenos. */\n(function(root){\n const text=(tag,value)=>{const el=document.createElement(tag);el.textContent=value??'';return el};\n function mount(root,bootstrap,client,transport){\n  root.replaceChildren();root.append(text('h1','Casa Vieja'),text('p',bootstrap.profile==='sales'?'Ventas y pedidos':'Inventario y preparación'));\n  const status=text('p','Consultando datos confirmados');status.setAttribute('role','status');root.append(status);\n  async function reconcileDrafts(){const local=await client.view();let changed=false;for(const [name,d]of Object.entries(drafts))if(Object.values(local.receipts).some(r=>r.state==='COMMITTED'&&r.saleId===d.saleId)){delete drafts[name];changed=true}if(changed)await client.store.transact(s=>s.roleDraft5c=drafts);}\n  const sync=text('button','Sincronizar');sync.type='button';sync.onclick=async()=>{try{await client.flush();await reconcileDrafts();await refresh();await showDiagnostics();const local=await client.view();status.textContent=local.queue.length?'Operaciones pendientes de confirmación.':'Sin operaciones pendientes.'}catch(e){status.textContent='Pendiente: '+e.message}};root.append(sync);\n  const exportButton=text('button','Guardar respaldo de este equipo');exportButton.type='button';exportButton.onclick=async()=>{const data=await client.view(),payload={format:'CV_DEVICE_EXPORT_5C',environment:'TEST_ONLY',capturedAt:new Date().toISOString(),origin:location.origin,scope:'CURRENT_ACCOUNT_ONLY',states:[{name:client.store.name,origin:location.origin,data}],failures:[],otherOriginsCovered:false};const link=document.createElement('a');link.href=URL.createObjectURL(new Blob([JSON.stringify(payload,null,2)],{type:'application/json'}));link.download='CasaVieja-cola-'+bootstrap.profile+'-laboratorio.json';link.click();URL.revokeObjectURL(link.href);};root.append(exportButton);\n  const details=document.createElement('details');details.append(text('summary','Detalles de sincronización'));const diagnostics=document.createElement('pre');diagnostics.id='lab-diagnostics';details.append(diagnostics);root.append(details);async function showDiagnostics(){const local=await client.view();diagnostics.textContent=JSON.stringify({queue:local.queue.map(q=>({operationId:q.command.operationId,saleId:q.command.saleId,state:q.state})),receipts:local.receipts},null,2);}\n  const nav=document.createElement('nav');nav.setAttribute('aria-label','Navegación de tu perfil');root.append(nav);const main=document.createElement('main');root.append(main);\n  const pages=bootstrap.profile==='sales'?['Ventas','Pedidos','Stock disponible']:['Existencias','Preparar bolsas'];let page=pages[0],dto,drafts={};\n  const draft=()=>drafts[page]||(drafts[page]={saleId:'future:'+crypto.randomUUID(),outputResourceId:'demo:'+crypto.randomUUID(),values:{}});\n  const input=(form,label,name,type='text')=>{const row=document.createElement('label');row.append(text('span',label));const el=document.createElement('input');el.name=name;el.type=type;if(type==='number'){el.min='1';el.inputMode='numeric'}row.append(el);form.append(row);return el};\n  const select=(form,label,name,options)=>{const row=document.createElement('label');row.append(text('span',label));const el=document.createElement('select');el.name=name;for(const [value,label]of options){const option=text('option',label);option.value=value;el.append(option)}row.append(el);form.append(row);return el};\n  async function send(command){await client.store.transact(s=>s.roleDraft5c=drafts);const submittedPage=page,localBefore=await client.view(),existing=localBefore.queue.find(q=>q.command.saleId===command.saleId);let q;\n   if(existing){const payload=Object.fromEntries(Object.entries(existing.command).filter(([k])=>!['operationId','deviceId','epoch','schemaVersion','date','responsible','commercialVersion'].includes(k)));if(JSON.stringify(payload)!==JSON.stringify(command))throw Error('DRAFT_CHANGED_PENDING');q={command:existing.command};}\n   else q=await client.enqueue({...command,commercialVersion:4,date:new Date().toISOString(),responsible:'Declarado en navegador'});\n   status.textContent='Guardado en este equipo. Sin confirmar.';await client.flush();await showDiagnostics();const local=await client.view();status.textContent=local.receipts[q.command.operationId]?'Confirmado por el servidor.':'Pendiente de confirmación. Se conserva el mismo identificador.';if(local.receipts[q.command.operationId]){delete drafts[submittedPage];await client.store.transact(s=>s.roleDraft5c=drafts);await refresh();}}\n\n  function draw(){main.replaceChildren(text('h2',page));\n   if(['Existencias','Stock disponible'].includes(page)){for(const r of dto.resources)main.append(text('p',`${r.product} · ${r.lot} · ${r.qty} ${r.unit} disponibles`));}\n   if(page==='Pedidos'){for(const s of dto.sales){const card=document.createElement('section');card.className='card';card.append(text('p',`${s.metadata.customer} · ${{RESERVED:'Reservado',CANCELLED:'Cancelado',DISPATCHED:'Despachado',RETURNED:'Devuelto',PART_RETURNED:'Devuelto parcialmente'}[s.status]||s.status} · S/ ${(s.totalCents/100).toFixed(2)}`));const contact=document.createElement('form');const customer=input(contact,'Nombre del contacto','customer');customer.value=s.metadata.customer||'';const zone=input(contact,'Zona del pedido','zone');zone.value=s.metadata.zone||'';const save=text('button','Guardar contacto');save.type='submit';contact.append(save);contact.onsubmit=async event=>{event.preventDefault();try{await send({type:'EDIT_SALE',saleId:s.id,expectedSaleVersion:s.version,metadata:{customer:customer.value,zone:zone.value}})}catch(e){status.textContent='No confirmado: '+e.message}};card.append(contact);if(s.status==='RESERVED'){const cancelForm=document.createElement('form'),reason=input(cancelForm,'Motivo obligatorio','reason'),button=text('button','Cancelar pedido');button.type='submit';cancelForm.append(button);cancelForm.onsubmit=async event=>{event.preventDefault();try{await send({type:'CANCEL_SALE',saleId:s.id,expectedSaleVersion:s.version,reason:reason.value})}catch(e){status.textContent='No confirmado: '+e.message}};card.append(cancelForm)}main.append(card)}}\n   if(page==='Ventas'){const form=document.createElement('form');const offer=select(form,'Presentación','offer',dto.offers.map(o=>[o.id,`${o.name} · S/ ${(o.priceCents/100).toFixed(2)}`]));const stock=select(form,'Partida disponible','stock',dto.resources.map(r=>[r.id,`${r.product} · ${r.qty} disponibles`]));const quantity=input(form,'Cantidad','quantity','number');quantity.value='1';input(form,'Cliente ficticio','customer');input(form,'Zona de entrega','zone');const submit=text('button','Registrar pedido');submit.type='submit';form.append(submit);form.onsubmit=async e=>{e.preventDefault();submit.disabled=true;try{const values=new FormData(form),o=dto.offers.find(x=>x.id===offer.value);await send({type:'REGISTER_SALE',saleId:draft().saleId,channel:'Otro',customer:{name:String(values.get('customer')),zone:String(values.get('zone'))},items:[{offerId:o.id,offerVersion:o.version,resourceId:stock.value,quantity:Number(quantity.value)}]})}catch(e){status.textContent='No confirmado: '+e.message}finally{submit.disabled=false}};main.append(form)}\n   if(page==='Preparar bolsas'){const form=document.createElement('form');const bulk=select(form,'Café a granel','bulk',dto.resources.filter(r=>r.stage==='BULK').map(r=>[r.id,r.product+' · '+r.lot]));const grams=select(form,'Gramaje','grams',[[250,'250 g'],[500,'500 g']]);const grind=select(form,'Molienda','grind',[['molido','Molido'],['grano','Grano']]);const bags=input(form,'Bolsas a preparar','bags','number');bags.value='1';const waste=input(form,'Merma explícita en gramos','waste','number');waste.min='0';waste.value='0';const packing=select(form,'Bolsas de empaque','packing',dto.resources.filter(r=>/^BAG/.test(r.supplyKind||'')).map(r=>[r.id,r.product]));const label=select(form,'Etiquetas','label',dto.resources.filter(r=>r.supplyKind==='LABEL').map(r=>[r.id,r.product]));const submit=text('button','Registrar preparación');submit.type='submit';form.append(submit);form.onsubmit=async event=>{event.preventDefault();submit.disabled=true;try{await send({type:'PREPARE_BAGS',saleId:draft().saleId,resourceId:bulk.value,outputResourceId:draft().outputResourceId,bagGrams:Number(grams.value),grind:grind.value,bags:Number(bags.value),wasteGrams:Number(waste.value),materials:[{resourceId:packing.value},{resourceId:label.value}]})}catch(e){status.textContent='No confirmado: '+e.message}finally{submit.disabled=false}};main.append(form)}\n   if(['Ventas','Preparar bolsas'].includes(page))for(const form of main.querySelectorAll('form')){const d=draft();for(const el of form.elements)if(el.name&&d.values[el.name]!==undefined)el.value=d.values[el.name];const persist=()=>{d.values=Object.fromEntries(new FormData(form));client.store.transact(s=>s.roleDraft5c=drafts).catch(()=>status.textContent='No se pudo guardar el borrador.');};form.addEventListener('input',persist);form.addEventListener('change',persist);}\n   if(dto.next!==null){const more=text('button','Cargar más');more.onclick=async()=>{try{const next=await transport.snapshot({offset:dto.next,limit:50,revision:dto.revision});if(next.error)throw Error(next.error);dto={...next,resources:[...dto.resources,...next.resources],sales:[...dto.sales,...next.sales],offers:[...dto.offers,...next.offers]};draw()}catch(e){status.textContent='Actualiza la consulta: '+e.message}};main.append(more)}\n  }\n  for(const name of pages){const button=text('button',name);button.type='button';button.onclick=()=>{page=name;draw()};nav.append(button)}\n  async function refresh(){let updated=false,error;try{updated=await client.refresh()}catch(e){error=e}const local=await client.view();dto=local.snapshot;if(!dto){if(error)throw error;throw Error('SNAPSHOT_NOT_CONFIRMED')}draw();await showDiagnostics();if(error||!updated)status.textContent='Última copia local. Revisa las operaciones pendientes antes de continuar.';}\n  client.view().then(local=>{drafts=local.roleDraft5c||{};return reconcileDrafts().then(refresh)}).then(()=>{if(!status.textContent.startsWith('Última copia'))status.textContent='Datos confirmados del servidor.'}).catch(e=>{status.textContent='No se pudo consultar: '+e.message});\n }\n root.CVRoleUI={mount};\n})(typeof globalThis==='object'?globalThis:this);\n","sha256":"19973f405cf2f8d0647f87906239bfc8406ad4fc43c430c1e7f534620b4f98ae"},{"path":"fase5c/web/session.js","content":"/* La identidad inicial proviene del backend autenticado. Nunca se toma de un selector de perfil. */\n(function(root){\n async function start({root:container,transport,continuity}){\n  let identity,verified=true;try{identity=await transport.request('bootstrap');if(identity.error)throw Error(identity.error);sessionStorage.setItem('cv5c.presentationIdentity',JSON.stringify({subject:identity.subject,profile:identity.profile}));}catch(error){verified=false;try{identity=JSON.parse(sessionStorage.getItem('cv5c.presentationIdentity')||'null')}catch(e){}if(!identity)throw error;}if(identity.error||!['sales','inventory'].includes(identity.profile)||!/^google:[0-9]{5,64}$/.test(identity.subject))throw Error('IDENTITY_REQUIRED');\n  const subject=identity.subject,name='cv-commercial-sandbox-v5c-'+subject,baseStore=new CV