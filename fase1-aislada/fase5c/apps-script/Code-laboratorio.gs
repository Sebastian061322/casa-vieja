emo:lot-'+unique,resourceId:'demo:parchment-'+unique,lotName:f.name||'Lote ficticio',origin:f.origin,producer:f.producer,coffeeType:f.coffeeType,family:f.family,grams:numInput(f.grams,1),acquisitionCents:cents(f.acquisition),freightCents:cents(f.freight),processingCents:cents(f.processing),documentRef:f.documentRef});}\n if(type==='RECEIVE_SUPPLY'){html=select('kind','Material',option('BAG250','Empaque 250 g')+option('BAG500','Empaque 500 g')+option('LABEL','Etiqueta'))+label('qty','Unidades recibidas','number','30','min=\"1\" required')+label('amount','Costo total S/','number','30','min=\"0\" step=\"0.01\" required')+document;submit=f=>send({type,saleId,lotId:'demo:supply-lot-'+unique,resourceId:'demo:supply-'+unique,supplyKind:f.kind,qty:numInput(f.qty,1),totalCostCents:cents(f.amount),documentRef:f.documentRef});}\n if(type==='ROAST'){html=select('resourceId','Pergamino disponible',resourceOptions(r=>r.stage==='PARCHMENT'&&r.qty>0))+label('grams','Tostado obtenido (g)','number','8000','min=\"1\" required')+label('waste','Merma del proceso (g)','number','2000','min=\"0\" required')+label('processing','Costo del proceso S/','number','30','min=\"0\" step=\"0.01\" required')+document;submit=f=>send({type,saleId,resourceId:f.resourceId,outputResourceId:'demo:bulk-'+unique,outputGrams:numInput(f.grams,1),wasteGrams:numInput(f.waste),processingCents:cents(f.processing),documentRef:f.documentRef});}\n if(type==='PREPARE_BAGS'){html=select('resourceId','Café tostado del lote',resourceOptions(r=>r.stage==='BULK'&&r.qty>0))+select('grams','Gramaje',option(500,'500 g')+option(250,'250 g'))+select('grind','Molienda',option('molido','Molido')+option('grano','En grano'))+label('bags','Bolsas a preparar','number','6','min=\"1\" required')+label('waste','Merma explícita (g)','number','0','min=\"0\" required')+select('bagId','Partida de empaques',resourceOptions(r=>r.stage==='SUPPLY'&&r.supplyKind!=='LABEL'))+select('labelId','Partida de etiquetas',resourceOptions(r=>r.supplyKind=