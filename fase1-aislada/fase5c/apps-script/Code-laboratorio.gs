arning]{background:#f7ebcf;border-color:#b49a60;color:#80530d}.cv-badge[data-tone=error]{background:#f7e8e2;border-color:#c68f7b;color:#a33729}input,select,textarea{border-color:#8a7c66}\n@media(max-width:880px){.home-filters .btn,.chart-tabs button,#sales .sale-mode button,#sales .page-actions .btn,.customer-lookup-panel>summary,.optional-product-filters>summary{min-height:44px}.optional-product-filters>summary{line-height:44px}.home-filters .btn{padding:9px 10px}.chart-tabs button{font-size:11px}.customer-lookup-panel>summary{line-height:1.5;padding-top:12px;padding-bottom:12px}}\n","sha256":"706dd507a2febd0cc412459185322b9c0e5b558bdbb713ba9cf2a7496eddd679"},{"path":"fase5a/web/ux.js","content":"/* Fase 5A: presentation, navigation and durable form drafts only.\n   All stock, prices, costs, payments and confirmations remain in Phase 4. */\nmenus.dashboard='Inicio';menus.sales='Ventas';menus.orders='Pedidos';menus.expenses='Egresos';menus.config='Configuración';menus.ads='Publicidad · demo';\nconst navItems=Object.entries(menus);$('nav').setAttribute('aria-label','Navegación principal');$('nav').innerHTML=navItems.map(([k,v],i)=>`${i===4?'<p class=\"nav-group-label\">Gestión del negocio</p>':''}<button class=\"nav-btn ${k===view?'active':''}\" data-view=\"${k}\">${v}</button>`).join('');\n$('more-mobile').onclick=()=>{$('nav').classList.toggle('open');$('menu').setAttribute('aria-expanded',String($('nav').classList.contains('open')));};$('menu').setAttribute('aria-controls','nav');$('menu').setAttribute('aria-expanded','false');$('menu').onclick=()=>{$('nav').classList.toggle('open');$('menu').setAttribute('aria-expanded',String($('nav').classList.contains('open')));};\nconst phase4Render=render,phase4ChangeView=changeView,phase4AddLine=addLine,phase4UpdateLine=updateLine,phase4Preview=preview;\nlet extraModeLines=[],uiDraft=null,restoringDraft=false,draftWrite=Promise.resolve(),uiMode='simple',saleHome=null;\nfunction fieldGroup(title,html){return `<fieldset><legend>${title}</legend><div class=\"form-grid\">${html}</div></fieldset>`;}\nsalesForm=function(){return `<div class=\"page-actions\"><button class=\"btn secondary\" data-view=\"orders\">Ver pedidos</button><button class=\"btn secondary\" data-sale-modal>Venta en ventana</button></div><form id=\"sale-form\"><div class=\"sale-layout\"><div><fieldset><legend>1. Producto y presentación</legend><div class=\"sale-mode\" role=\"group\" aria-label=\"Tipo de venta\"><button class=\"btn secondary\" type=\"button\" data-sale-mode=\"simple\" aria-pressed=\"true\">Venta simple</button><button class=\"btn secondary\" type=\"button\" data-sale-mode=\"tripack\" aria-pressed=\"false\">Tripack</button><button class=\"btn secondary\" type=\"button\" data-sale-mode=\"combo\" aria-pressed=\"false\">Combinada</button></div><p class=\"cv-help\">Elige café, molienda y presentación. El precio proviene del catálogo vigente.</p><div id=\"sale-lines\" class=\"cv-lines\"></div><button class=\"btn secondary\" type=\"button\" data-add-line>+ Agregar producto</button><p id=\"catalog-hint\" class=\"cv-help\"></p></fieldset>${fieldGroup('2. Cliente y contacto',label('customer','Cliente ficticio')+label('phone','Teléfono ficticio','tel','','inputmode=\"tel\" autocomplete=\"off\"')+select('channel','Canal',['WhatsApp','Meta Ads (manual)','Instagram','Referido','Otro'].map(v=>option(v,v)).join(''))+label('note','Observaciones'))}${fieldGroup('3. Envío y pago',label('zone','Dirección / distrito ficticio')+label('deliveryCharged','Envío cobrado (S/)','number','0','min=\"0\" step=\"0.01\" inputmode=\"decimal\"')+label('deliveryCost','Costo real de envío (S/)','number','0','min=\"0\" step=\"0.01\" inputmode=\"decimal\"')+select('paymentMethodIntent','Medio previsto de pago',option('','Por definir')+option('Yape ficticio','Yape ficticio')+option('Transferencia ficticia','Transferencia ficticia')+option('Efectivo ficticio','Efectivo ficticio'))+'<p class=\"field-note\">Pago: pendiente de registrar cobro. Pedido: se reservará al confirmar el servidor. El medio previsto se guarda como borrador en este equipo; no acredita un pago. Tras confirmar, usa «Registrar cobro» y «Despachar» en Pedidos.</p>')}<details class=\"card\" id=\"discount-panel\"><summary>Descuento y autorización</summary><div class=\"form-grid\">${label('discount','Descuento autorizado (S/)','number','0','min=\"0\" step=\"0.01\" inputmode=\"decimal\"')}${label('authorizationId','Código de autorización')}</div><p class=\"cv-help\">Un descuento requiere autorización del propietario para este pedido.</p></details></div><aside class=\"sale-aside\" aria-label=\"Resumen de la venta\"><h3>Tu pedido</h3><div id=\"sale-preview\" aria-live=\"polite\"></div><ol class=\"sale-progress\" aria-label=\"Estado de guardado\"><li data-save-step=\"local\">1 · Borrador local</li><li data-save-step=\"pending\">2 · Pendiente</li><li data-save-step=\"confirmed\">3 · Confirmado</li></ol><p id=\"draft-state\" role=\"status\">Borrador sin enviar</p><div class=\"sale-actions\"><div><small>Total estimado</small><div id=\"sticky-total\" class=\"sale-total\">—</div></div><button class=\"btn\" id=\"submit-sale\">+ Registrar venta</button><button class=\"btn secondary\" type=\"button\" data-new-order>Nuevo pedido</button></div><p class=\"cv-help\">El servidor valida importe y disponibilidad. Guardar aquí no confirma la venta.</p><div id=\"sale-next\"></div></aside></div></form><details class=\"card\"><summary>Autorizar descuento · propietario</summary><form id=\"discount-form\"><div class=\"form-grid\">${label('max','Máximo autorizado (S/)','number','0','min=\"0.01\" step=\"0.01\" inputmode=\"decimal\"')}${label('reason','Motivo obligatorio')}${label('expires','Vence','date',today())}</div><button class=\"btn secondary\">Confirmar autorización ficticia</button></form><p id=\"discount-code\"></p></details>`;};\nfunction decorateLine(row){if(row.querySelector('.product-filters'))return;const filters=document.createElement('div');filters.className='product-filters';filters.innerHTML=select('ui-family','Café',option('','Todos')+option('Gourmet','Gourmet')+option('Especialidad','Especialidad'))+select('ui-grind','Molienda',option('','Todas')+option('molido','Molido')+option('grano','En grano'))+select('ui-grams','Presentación',option('','Todas')+option('250','250 g')+option('500','500 g'));row.prepend(filters);const price=document.createElement('div');price.className='unit-price';row.append(price);row.querySelector('[data-quantity]').inputMode='numeric';row.querySelector('[data-quantity]').required=true;row.querySelector('[data-offer]').required=true;row.querySelector('[data-resource]').required=true;row.querySelector('[data-offer]').setAttribute('aria-label','Producto / presentación');row.querySelector('[data-resource]').setAttribute('aria-label','Partida y lote');updatePrice(row);}\nfunction updatePrice(row){const o=snapshot?.commerce.offers[row.querySelector('[data-offer]').value];if(row.querySelector('.unit-price'))row.querySelector('.unit-price').textContent=o?`Precio de catálogo: ${money(o.priceCents)} · ${o.bags} bolsa(s) por unidad`:'Sin oferta vigente para esta combinación. Revisa Configuración.';}\naddLine=function(){phase4AddLine();const row=$('sale-lines').lastElementChild;decorateLine(row);filterLine(row,uiMode);return row;};\nupdateLine=function(row){phase4UpdateLine(row);updatePrice(row);};\nfunction filterLine(row,mode){const f=Object.fromEntries([...row.querySelectorAll('.product-filters select')].map(el=>[el.name,el.value]));const selected=row.querySelector('[data-offer]').value;const offers=Object.values(snapshot.commerce.offers).filter(o=>o.active&&(!f['ui-family']||o.family===f['ui-family'])&&(!f['ui-grind']||o.grind===f['ui-grind'])&&(!f['ui-grams']||o.grams===Number(f['ui-grams']))&&(!mode||mode==='combo'||(mode==='tripack'?o.bags===3:o.bags===1)));row.querySelector('[data-offer]').innerHTML=offers.map(o=>`<option value=\"${esc(o.id)}\" data-version=\"${o.version}\">${esc(o.name)} · 