s=\"main\" id=\"main-content\" tabindex=\"-1\"><div class=\"topbar\"><h2 id=\"title\">Resumen comercial</h2><span class=\"cv-badge\" id=\"connection\">Conectando</span></div><p id=\"notice\" role=\"status\" aria-live=\"polite\">Preparando el laboratorio…</p><div class=\"cv-toolbar\"><button class=\"btn secondary\" id=\"sync\">Sincronizar</button><span id=\"pending\"></span></div><section id=\"dashboard\" class=\"cv-section active\"></section><section id=\"sales\" class=\"cv-section\"></section><section id=\"orders\" class=\"cv-section\"></section><section id=\"inventory\" class=\"cv-section\"></section><section id=\"lots\" class=\"cv-section\"></section><section id=\"purchases\" class=\"cv-section\"></section><section id=\"expenses\" class=\"cv-section\"></section><section id=\"customers\" class=\"cv-section\"></section><section id=\"reports\" class=\"cv-section\"></section><section id=\"ads\" class=\"cv-section\"></section><section id=\"config\" class=\"cv-section\"></section><section class=\"card\" style=\"margin-top:20px\"><h3>Operaciones pendientes</h3><div id=\"queue\"></div></section><details class=\"card\" style=\"margin-top:14px\"><summary>Verificaciones del laboratorio</summary><p>Ensayo con datos ficticios. No habilita operaciones comerciales.</p><button class=\"btn secondary\" id=\"verify\">Verificar integración comercial</button><pre id=\"results\" style=\"white-space:pre-wrap;overflow-wrap:anywhere\"></pre></details></main></div><dialog id=\"dialog\" aria-labelledby=\"dialog-title\"><h3 id=\"dialog-title\"></h3><form id=\"dialog-form\"><div id=\"dialog-body\"></div><p id=\"dialog-error\" role=\"alert\"></p><div class=\"cv-toolbar\"><button class=\"btn\" type=\"submit\">Confirmar operación de pruebas</button><button class=\"btn secondary\" type=\"button\" id=\"dialog-cancel\">Cerrar</button></div></form></dialog><nav class=\"mobile-tabs\" aria-label=\"Accesos rápidos\"><button data-view=\"dashboard\"><span aria-hidden=\"true\">⌂</span>Inicio</button><button data-view=\"sales\"><span aria-hidden=\"true\">＋</span>Ventas</button><button data-view=\"orders\"><span aria-hidden=\"true\">▤</span>Pedidos</button><button data-view=\"inventory\"><span aria-hidden=\"true\">▦</span>Inventario</button><button id=\"more-mobile\"><span aria-hidden=\"true\">☰</span>Más</button></nav><dialog id=\"sale-dialog\" aria-labelledby=\"sale-dialog-title\"><div class=\"sale-modal-head\"><h3 id=\"sale-dialog-title\">Registrar venta</h3><button class=\"btn secondary\" id=\"close-sale-modal\" type=\"button\">Cerrar</button></div><div id=\"sale-modal-body\"></div></dialog><script>/* Cola transaccional. Un documento IndexedDB por dispositivo/cuenta/destino. */\n(function(root,factory){const api=factory();if(typeof module==='object'&&module.exports)module.exports=api;else root.CVClient=api;})(typeof globalThis==='object'?globalThis:this,function(){\n'use strict';\nconst copy=x=>JSON.parse(JSON.stringify(x));\nconst empty=()=>({generation:0,queue:[],archived:[],receipts:{},snapshot:null,deviceId:null});\nclass Client{\n constructor(store,transport,destination,uuid){this.store=store;this.transport=transport;this.destination=destination;this.uuid=uuid;this.running=null;}\n async enqueue(payload){let saved;await this.store.transact(s=>{s.deviceId=s.deviceId||this.uuid();const command=Object.assign({},copy(payload),{operationId:this.uuid(),deviceId:s.deviceId,epoch:this.destination,schemaVersion:2});saved=copy(command);s.queue.push({command,state:'PENDING',lastError:''});s.generation++;});return {queued:true,confirmed:false,command:saved};}\n async view(){return this.store.read();}\n async archiveRejected(operationId){\n  const entry=(await this.store.read()).queue.find(x=>x.command.operationId===operationId);if(!entry||entry.state!=='REJECTED')throw Error('REJECTED_REQUIRED');\n  const result=await this.transport.status(operationId);if(!result||result.epoch!==this.destination||result.operationId!==operationId||result.state!=='REJECTED')throw Error('UNRESOLVED_SERVER_STATE');\n  await this.store.transact(s=>{const item=s.queue.find(x=>x.command.operationId===operationId);if(!item||item.state!=='REJECTED')throw Error('QUEUE_CHANGED');s.archived=s.archived||[];s.archived.push({...item,serverRejection:copy(result),resolution:'SERVER_REJECTED_NO_SALE_EFFECT'});s.queue=s.queue.filter(x=>x!==item);s.generation++;});\n }\n validAck(r,c){return r&&r.epoch===this.destination&&r.operationId===c.operationId&&r.saleId===c.saleId&&r.state==='COMMITTED'&&Number.isSafeInteger(r.revision)&&r.revision>0&&Number.isSafeInteger(r.saleVersion);}\n async ack(r,c){if(!this.validAck(r,c))throw Error('INVALID_ACK');await this.store.transact(s=>{s.receipts[c.operationId]=copy(r);s.queue=s.queue.filter(x=>x.command.operationId!==c.operationId);s.generation++;});}\n flush(){if(!this.running)this.running=this.drain().finally(()=>this.running=null);return this.running;}\n async drain(){\n  while(true){const s=await this.store.read(),item=s.queue[0];if(!item||item.state==='REJECTED')return;\n   const c=item.command;\n   try{\n    let r=await this.transport.status(c.operationId);\n    if(!r||r.epoch!==this.destination||r.operationId!==c.operationId)throw Error('INVALID_STATUS');\n    if(r.state==='UNKNOWN'||r.state==='PREPARED')r=await this.transport.execute(c);\n    if(r&&r.error){const error=Error(r.error);error.permanent=r.retryable===false;throw error;}\n    await this.ack(r,c);\n   }catch(e){await this.store.transact(state=>{const entry=state.queue.find(x=>x.command.operationId===c.operationId);if(entry){entry.lastError=e.message;entry.state=e.permanent?'REJECTED':'PENDING';}state.generation++;});return;}\n  }\n }\n async refresh(){const start=await this.store.read();if(start.queue.length)return false;const snap=await this.transport.snapshot();if(!snap||snap.epoch!==this.destination||!Number.isSafeInteger(snap.revision))return false;let applied=false;await this.store.transact(s=>{const minRevision=Math.max(s.snapshot?s.snapshot.revision:0,...Object.values(s.receipts).map(x=>x.revision));if(!s.queue.length&&s.generation===start.generation&&snap.revision>=minRevision){s.snapshot=copy(snap);s.generation++;applied=true;}});return applied;}\n}\nclass IndexedStore{\n constructor(name){this.name=name;this.dbPromise=null;}\n db(){if(!this.dbPromise)this.dbPromise=new Promise((resolve,reject)=>{const r=indexedDB.open(this.name,1);r.onupgradeneeded=()=>r.result.createObjectStore('state');r.onsuccess=()=>resolve(r.result);r.onerror=()=>reject(r.error);r.onblocked=()=>reject(Error('STORAGE_BLOCKED'));});return this.dbPromise;}\n async read(){const db=await this.db();return new Promise((resolve,reject)=>{const tx=db.transaction('state','readonly');const req=tx.objectStore('state').get('current');let value;req.onsuccess=()=>value=copy(req.result||empty());tx.oncomplete=()=>resolve(value);tx.onerror=tx.onabort=()=>reject(tx.error||Error('STORAGE_FAILED'));});}\n async transact(fn){const db=await this.db();return new Promise((resolve,reject)=>{const tx=db.transaction('state','readwrite'),store=tx.objectStore('state');let failure;const req=store.get('current');req.onsuccess=()=>{try{const s=copy(req.result||empty());fn(s);store.put(s,'current');}catch(e){failure=e;tx.abort();}};tx.oncomplete=()=>resolve();tx.onerror=tx.onabort=()=>reject(failure||tx.error||Error('STORAGE_FAILED'));});}\n}\nreturn {Client,IndexedStore,empty};\n});\n\n'use strict';\nconst $=id=>document.getElementById(id),uuid=()=>crypto.randomUUID(),esc=v=>String(v??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c])),money=n=>'S/ '+(n/100).toFixed(2),today=()=>new Date(Date.now()-5*3600000).toISOString().slice(0,10);\nconst menus={dashboard:'Resumen',sales:'Registrar venta',orders:'Pedidos y cobros',inventory:'Inventario',lots:'Lotes y preparación',purchases:'Compras',expenses:'Gastos',customers:'Clientes',reports:'Reportes',config:'Catálogo y precios'};\nconst statusName={RESERVED:'Reservado',DISPATCHED:'Despachado',PART_RETURNED:'Devuelto parcialmente',RETURNED:'Devuelto',CANCELLED:'Cancelado'};\nconst rpc=(name,arg)=>new Promise((resolve,reject)=>{const timer=setTimeout(()=>reject(Error('CONNECTION_TIMEOUT')),name==='scenario'?330000:45000);const r=google.script.run.withSuccessHandler(v=>{clearTimeout(timer);resolve(v);}).withFailureHandler(()=>{clearTimeout(timer);reject(Error('CONNECTION_FAILED'));});if(name==='execute')r.commercialExecute(arg);else if(name==='status')r.commercialStatus(arg);else if(name==='snapshot')r.commercialSnapshot();else if(name==='reports')r.commercialReports(arg);else if(name==='initialize')r.commercialInitialize();else if(name==='report')r.commercialSaveReport(arg);else r.commercialScenario();});\nconst store=new CVClient.IndexedStore('cv-commercial-sandbox-v5a-owner'),transport={execute:c=>rpc('execute',c),status:id=>rpc('status',id),snapshot:()=>rpc('snapshot')},client=new CVClient.Client(store,transport,'TEST_ONLY_V3',uuid);\nlet snapshot=null,view='dashboard',dirty=false,busy=false,verifying=false,draftSaleId=null,modalSubmit=null,report=null,reveal=false;\nconst notice=t=>$('notice').textContent=t,formdata=form=>Object.fromEntries(new FormData(form)),numInput=(v,min=0)=>{const n=Number(v);if(!Number.isSafeInteger(n)||n<min)throw Error('Revisa las cantidades: usa números enteros.');return n;};\nfunction cents(v){if(!/^\\d+(\\.\\d{1,2})?$/.test(String(v)))throw Error('Revisa los importes: máximo dos decimales.');const [a,b='']=String(v).split('.');return numInput(Number(a)*100+Number(b.padEnd(2,'0')));}\nconst enriched=p=>({...p,commercialVersion:4,date:new Date().toISOString(),responsible:'Propietario del laboratorio'});\nconst label=(name,text,type='text',value='',extra='')=>`<div><label>${esc(text)}<input name=\"${name}\" type=\"${type}\" value=\"${esc(value)}\" ${extra}></label></div>`;\nconst select=(name,title,options)=>`<div><label>${esc(title)}<select name=\"${name}\">${options}</select></label></div>`;\nconst option=(value,title)=>`<option value=\"${esc(value)}\">${esc(title)}</option>`;\nconst allResources=()=>Object.values(snapshot?.resources||{}),commercialSales=()=>Object.values(snapshot?.sales||{}).filter(s=>s.commercial),resourceOptions=(pred)=>allResources().filter(pred).map(r=>option(r.id,`${r.product} · ${r.lot} · ${r.qty} ${r.unit==='g'?'g':'und.'} disponibles`)).join('');\nconst cards=items=>`<div class=\"cv-summary\">${items.map(([name,value])=>`<article><span>${esc(name)}</span><strong>${esc(value)}</strong></article>`).join('')}</div>`;\nfunction explain(error){const code=error.message||error;return ({INSUFFICIENT_STOCK:'No alcanza el inventario disponible. Revisa las reservas y cantidades.',OFFER_VERSION_CONFLICT:'El precio cambió. Revisa el catálogo y vuelve a preparar el pedido.',DISCOUNT_NOT_AUTHORIZED:'El descuento requiere una autorización vigente para este pedido.',DUPLICATE_DOCUMENT:'Ese comprobante ya está registrado. No se duplicó la operación.',SALE_VERSION_CONFLICT:'El pedido cambió en otro dispositivo. Actualiza antes de continuar.',PRICE_NOT_CURRENT:'La oferta no está activa o su precio no está vigente.',PAYMENT_EXCEEDS_DUE:'El importe supera el saldo pendiente de cobro.',REFUND_EXCEEDS_CREDIT:'El importe supera el reembolso disponible.',RETURN_EXCEEDS_DISPATCH:'No puedes recibir más bolsas de las que quedan por devolver.',RETURN_RECEIPT_REQUIRED:'Este pedido requiere una devolución física, no una cancelación.',CONNECTION_FAILED:'Conexión no disponible. Tus operaciones pendientes se conservan.',CONNECTION_TIMEOUT:'El servidor aún no confirma. Conservamos la operación para consultar su estado.',USE_RECORD_PAYMENT:'Registra el importe del cobro; no basta marcarlo como pagado.',SERVER_UNAVAILABLE:'El servidor no está disponible. La operación conserva su identificador para reintentar.'})[code]||String(code);}\nasync function sync(){if(busy)return;busy=true;try{await client.flush();const downloaded=await client.refresh();const local=await client.view();snapshot=