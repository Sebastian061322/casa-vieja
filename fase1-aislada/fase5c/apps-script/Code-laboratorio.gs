tra='')=>`<div><label>${esc(text)}<input name=\"${name}\" type=\"${type}\" value=\"${esc(value)}\" ${extra}></label></div>`;\nconst select=(name,title,options)=>`<div><label>${esc(title)}<select name=\"${name}\">${options}</select></label></div>`;\nconst option=(value,title)=>`<option value=\"${esc(value)}\">${esc(title)}</option>`;\nconst allResources=()=>Object.values(snapshot?.resources||{}),commercialSales=()=>Object.values(snapshot?.sales||{}).filter(s=>s.commercial),resourceOptions=(pred)=>allResources().filter(pred).map(r=>option(r.id,`${r.product} · ${r.lot} · ${r.qty} ${r.unit==='g'?'g':'und.'} disponibles`)).join('');\nconst cards=items=>`<div class=\"cv-summary\">${items.map(([name,value])=>`<article><span>${esc(name)}</span><strong>${esc(value)}</strong></article>`).join('')}</div>`;\nfunction explain(error){const code=error.message||error;return ({INSUFFICIENT_STOCK:'No alcanza el inventario disponible. Revisa las reservas y cantidades.',OFFER_VERSION_CONFLICT:'El precio cambió. Revisa el catálogo y vuelve a preparar el pedido.',DISCOUNT_NOT_AUTHORIZED:'El descuento requiere una autorización vigente para este pedido.',DUPLICATE_DOCUMENT:'Ese comprobante ya está registrado. No se duplicó la operación.',SALE_VERSION_CONFLICT:'El pedido cambió en otro dispositivo. Actualiza antes de continuar.',PRICE_NOT_CURRENT:'La oferta no está activa o su precio no está vigente.',PAYMENT_EXCEEDS_DUE:'El importe supera el saldo pendiente de cobro.',REFUND_EXCEEDS_CREDIT:'El importe supera el reembolso disponible.',RETURN_EXCEEDS_DISPATCH:'No puedes recibir más bolsas de las que quedan por devolver.',RETURN_RECEIPT_REQUIRED:'Este pedido requiere una devolución física, no una cancelación.',CONNECTION_FAILED:'Conexión no disponible. Tus operaciones pendientes se conservan.',CONNECTION_TIMEOUT:'El servidor aún no confirma. Conservamos la operación para consultar su estado.',USE_RECORD_PAYMENT:'Registra el importe del cobro; no basta marcarlo como pagado.',SERVER_UNAVAILABLE:'El servidor no está disponible. La operación conserva su identificador para reintentar.'})[code]||String(code);}\nasync function sync(){if(busy)return;busy=true;try{await client.flush();const downloaded=await client.refresh();const local=await client.view();snapshot=local.snapshot;$('pending').textContent=local.queue.length?`${local.queue.length} operación(es) pendiente(s)`:'Sin operaciones pendientes';$('connection').textContent=local.queue.length?'Pendiente de sincronización':downloaded?'Laboratorio conectado':'Última copia local';$('queue').innerHTML=local.queue.map(q=>`<p>${esc(q.command.type)} · ${esc(q.state)} · ${esc(explain(q.lastError))}${q.state==='REJECTED'?` <button class=\"btn small secondary\" data-archive=\"${esc(q.command.operationId)}\">Archivar rechazo con evidencia</button>`:''}</p>`).join('')||'<p class=\"cv-help\">Todo confirmado por el servidor.</p>';if(downloaded&&/CONNECTION_FAILED|CONNECTION_TIMEOUT|Conexión no disponible|El servidor aún no confirma/.test($('notice').textContent))notice('Conexión recuperada. Los pendientes se comprobaron sin duplicarse.');if(snapshot&&!dirty&&!$('dialog').open&&!document.activeElement?.matches('input,select,textarea'))render();}catch(e){notice(explain(e));$('connection').textContent='Sin confirmación';}finally{busy=false;}}\nasync function send(payload){let q=(await client.view()).queue.find(q=>JSON.stringify(Object.fromEntries(Object.entries(q.command).filter(([k])=>!['operationId','deviceId','epoch','schemaVersion','date','responsible','commercialVersion'].includes(k))))===JSON.stringify(payload));if(!q)q=(await client.enqueue(enriched(payload))).command;else q=q.command;notice('Guardada en este equipo. Esperando confirmación del servidor.');await sync();const local=await client.view();if(local.receipts[q.operationId]){notice('Operación confirmada por el servidor.');return true;}const queued=local.queue.find(x=>x.command.operationId===q.operationId);notice(queued?.state==='REJECTED'?explain(queued.lastError):'Operación pendiente. Se recuperará sin duplicarse al reconectar.');return false;}\nasync function changeView(name){view=name;dirty=false;document.querySelectorAll('.cv-section').forEach(el=>el.classList.toggle('active',el.id===name));document.querySelectorAll('[data-view]').forEach(el=>el.classList.toggle('active',el.dataset.view===name));$('title').textContent=menus[name];$('nav').classList.remove('open');render();}\nfunction summary(r){return cards([['Pedidos registrados',r.registeredOrders],['Importe de pedidos',money(r.registeredCents)],['Ingreso por despachos, neto de créditos',money(r.revenueCents)],['Cobros recibidos',money(r.collectionsCents)],['Reembolsos',money(r.refundsCents)],['Pendiente de cobrar · total',money(r.outstandingCents)],['Costo vendido neto',money(r.cogsCents)],['Margen bruto estimado',money(r.grossMarginCents)],['Gastos operativos',money(r.operatingExpenseCents)],['Distribución de pedidos',money(r.distributionCents)],['Merma extraordinaria',money(r.stockLossCents)],['Resultado estimado',money(r.estimatedProfitCents)]]);}\nfunction salesForm(){return `<div class=\"card\"><p class=\"cv-help\">Precios ficticios configurados en el catálogo. Cada línea puede ser una bolsa, un Tripack u otra presentación. Agrega líneas para un combo.</p><form id=\"sale-form\"><div id=\"sale-lines\" class=\"cv-lines\"></div><button class=\"btn secondary\" type=\"button\" data-add-line>+ Agregar producto al pedido</button><div class=\"form-grid\" style=\"margin-top:16px\">${select('channel','Canal',['WhatsApp','Meta Ads (manual)','Instagram','Referido','Otro'].map(v=>option(v,v)).join(''))}${label('customer','Cliente ficticio')}${label('phone','Teléfono ficticio','tel')}${label('zone','Zona / dirección ficticia')}${label('note','Observaciones')}${label('discount','Descuento autorizado (S/)','number','0','min=\"0\" step=\"0.01\"')}${label('authorizationId','Código de autorización de descuento')}${label('deliveryCharged','Envío cobrado (S/)','number','0','min=\"0\" step=\"0.01\"')}${label('deliveryCost','Costo de distribución (S/)','number','0','min=\"0\" step=\"0.01\"')}</div><div id=\"sale-preview\" class=\"cv-summary\"></div><p class=\"cv-help\">El costo y el total definitivos los valida el servidor. La venta comienza reservada; cobro, despacho y entrega son pasos independientes.</p><button class=\"btn\" id=\"submit-sale\">Registrar y reservar pedido</button><button class=\"btn secondary\" type=\"button\" data-new-order>Nuevo pedido</button></form><details style=\"margin-top:18px\"><summary>Autorizar descuento de este pedido · propietario</summary><form id=\"discount-form\"><div class=\"form-grid\">${label('max','Máximo autorizado (S/)','number','0','min=\"0.01\" step=\"0.01\"')}${label('reason','Motivo obligatorio')}${label('expires','Vence','date',today())}</div><button class=\"btn secondary\">Confirmar autorización ficticia</button></form><p id=\"discount-code\"></p></details></div>`;}\nfunction addLine(){const offers=Object.values(snapshot.commerce.offers).filter(o=>o.active);const row=document.createElement('div');row.className='cv-line';row.innerHTML=`<label>Producto / presentación<select data-offer>${offers.map(o=>`<option value=\"${esc(o.id)}\" data-version=\"${o.version}\">${esc(o.name)} · ${money(o.priceCents)} · ${o.bags} bolsa(s)</option>`).join('')}</select></label><label>Partida y lote<select data-resource></select></label><label>Cantidad<input data-quantity type=\"number\" min=\"1\" value=\"1\"></label><button class=\"btn secondary\" type=\"button\" data-remove-line aria-label=\"Quitar producto\">×</button>`;$('sale-lines').append(row);updateLine(row);}\nfunction updateLine(row){const offer=snapshot.commerce.offers[row.querySelector('[data-offer]').value];row.querySelector('[data-resource]').innerHTML=resourceOptions(r=>offer&&r.stage==='PACKAGED'&&r.family===offer.family&&r.grind===offer.grind&&r.grams===offer.grams);preview();}\nfunction items(){return [...$('sale-lines').querySelectorAll('.cv-line')].