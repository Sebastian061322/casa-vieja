iente del laboratorio')}${(snapshot.reports.customers||[]).map(c=>option(c.id,c.name+(c.phone?' · •••'+c.phone.slice(-3):''))).join('')}</select></label><button type=\"button\" class=\"btn secondary\" data-apply-customer>Usar datos</button>`;contact.querySelector('.form-grid').before(box);}const total=form.querySelector('.sale-actions');if(total){total.insertAdjacentHTML('beforeend','<span class=\"mobile-sale-status\" id=\"mobile-sale-status\">Borrador local · no enviado</span>');}form.querySelectorAll('.cv-line').forEach(refineLine);const discount=$('discount-panel');if(discount){const code=discount.querySelector('[name=authorizationId]');if(code){code.readOnly=true;code.placeholder='Se completa al autorizar';}const help=document.createElement('p');help.className='cv-help';help.textContent='El código se completa automáticamente al autorizar el descuento; no necesitas escribir un identificador.';discount.append(help);}updateMobileStatus();}\nfunction refineLine(row){if(row.dataset.refined)return;row.dataset.refined='true';const filters=row.querySelector('.product-filters');if(filters){const detail=document.createElement('details');detail.className='optional-product-filters';detail.innerHTML='<summary>Filtrar café, molienda y gramaje</summary>';filters.before(detail);detail.append(filters);}const choices=document.createElement('div');choices.className='quick-products';choices.setAttribute('role','group');choices.setAttribute('aria-label','Presentaciones rápidas');row.prepend(choices);refreshChoices(row);const lot=document.createElement('div');lot.className='lot-help';lot.textContent='Se conserva la partida exacta y la validación de disponibilidad del servidor.';row.append(lot);readableLots(row);}\nfunction refreshChoices(row){const target=row.querySelector('.quick-products');if(!target)return;const select=row.querySelector('[data-offer]');target.innerHTML=[...select.options].filter(o=>o.value).slice(0,6).map(o=>{const offer=snapshot.commerce.offers[o.value];return `<