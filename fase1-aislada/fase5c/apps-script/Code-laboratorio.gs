ervar → cobrar / despachar → entregar. Las devoluciones físicas y los reembolsos se registran por separado.</p><p>Los ensayos antiguos V2/V3 permanecen en sus vistas propias; no se suman como ventas comerciales nuevas.</p></div>`;\n if(view==='sales'){$('sales').innerHTML=salesForm();addLine();}\n if(view==='orders'){$('orders').innerHTML=`<div class=\"cv-toolbar\"><label>Buscar pedido, cliente o zona<input id=\"order-search\"></label><label>Estado<select id=\"order-status\">${option('','Todos')}${Object.entries(statusName).map(([k,v])=>option(k,v)).join('')}</select></label></div><div id=\"order-list\"></div>`;$('order-list').innerHTML=orderTable();}\n if(view==='inventory'){$('inventory').innerHTML=cards([['Bolsas físicas',allResources().filter(r=>r.stage==='PACKAGED').reduce((n,r)=>n+r.physical,0)],['Bolsas reservadas',allResources().filter(r=>r.stage==='PACKAGED').reduce((n,r)=>n+r.reserved,0)],['Granel disponible (g)',allResources().filter(r=>r.stage==='BULK').reduce((n,r)=>n+r.qty,0)]])+`<form class=\"form-grid\" id=\"inventory-filter\">${select('stage','Etapa',option('','Todas')+[['PARCHMENT','Pergamino'],['BULK','Tostado a granel'],['PACKAGED','Envasado'],['SUPPLY','Insumos']].map(([k,v])=>option(k,v)).join(''))}${select('family','Familia',option('','Todas')+option('Gourmet','Gourmet')+option('Especialidad','Especialidad'))}${select('grind','Molienda',option('','Todas')+option('grano','En grano')+option('molido','Molido'))}${select('grams','Presentación',option('','Todas')+option('250','250 g')+option('500','500 g'))}${select('lot','Lote',option('','Todos')+[...new Set(allResources().map(r=>r.lot))].map(l=>option(l,l)).join(''))}</form><div class=\"card cv-table\"><table><thead><tr><th>Producto / lote</th><th>Físico</th><th>Reservado</th><th>Disponible</th><th>Unidad</th><th>Valor</th><th>Alerta</th></tr></thead><tbody id=\"inventory-rows\"></tbody></table></div><p class=\"cv-help\">Los saldos son de solo lectura. Cada cambio se registra mediante una operación.</p><div class=\"cv-toolbar\"><button class=\"btn secondary\" data-operation=\"WASTE\">Registrar merma</button></div><details><summary>Movimientos confirmados recientes</summary>${snapshot.effects.slice(-30).reverse().map(e=>`<p>${esc(e.kind)} · ${esc(e.lot)} · ${e.qtyDelta} ${esc(e.unit)} · reserva ${e.reservedDelta} · merma ${e.wasteGrams||0} g<br><small>${esc(e.date)} · ${esc(e.operationId)}</small></p>`).join('')}</details>`;$('inventory-rows').innerHTML=inventoryRows();}\n if(view==='lots')$('lots').innerHTML=`<div class=\"cv-toolbar\"><button class=\"btn\" data-operation=\"RECEIVE_LOT\">Recibir compra de café</button><button class=\"btn secondary\" data-operation=\"ROAST\">Registrar tostado</button><button class=\"btn secondary\" data-operation=\"PREPARE_BAGS\">Preparar bolsas</button></div>${Object.values(snapshot.lots).map(l=>{const balances=allResources().filter(r=>r.lot===l.id),costs=snapshot.commerce.events.filter(e=>e.kind==='CAPITALIZED_COST'&&e.lotId===l.id).reduce((n,e)=>n+e.amountCents,0);return `<div class=\"card cv-card-gap\"><h3>${esc(l.name||l.id)} · ${esc(l.family)}</h3><p>${esc(l.origin)} · ${esc(l.coffeeType)} · ${esc(l.producer||'')}</p><p>Recibido: ${l.receivedGrams} g · Adquisición inicial: ${money(l.acquisitionCents)} · Procesamiento inicial: ${money(l.processingCents)}</p><p>Costos comerciales nuevos registrados: ${money(costs)} · Valor remanente: ${money(balances.reduce((n,r)=>n+r.valueCents,0))}</p></div>`;}).join('')}`;\n if(view==='purchases')$('purchases').innerHTML=`<div class=\"cv-toolbar\"><button class=\"btn\" data-operation=\"RECEIVE_LOT\">Comprar café</button><button class=\"btn secondary\" data-operation=\"RECEIVE_SUPPLY\">Comprar empaques / etiquetas</button></div><p class=\"cv-help\">Recibir una compra incorpora costo al inventario. Registrar su pago controla la salida de dinero; no vuelve a sumar ese costo como gasto operativo.</p>${snapshot.commerce.events.filter(e=>e.kind==='CAPITALIZED_COST').map(e=>{const paid=snapshot.commerce.events.filter(p=>p.kind==='PURCHASE_PAYMENT'&&p.sourceOperationId===e.operationId).reduce((n,p)=>n+p.amountCents,0);return `<div class=\"card cv-card-gap\"><h3>${esc(e.category)} · ${money(e.amountCents)}</h3><p>${esc(e.description)} · ${esc(e.documentRef)} · ${esc(e.lotId||'')}</p><p>Pagado: ${money(paid)} · Pendiente: ${money(e.amountCents-paid)}</p><button class=\"btn secondary\" data-purchase-pay=\"${esc(e.operationId)}\" ${paid>=e.amountCents?'disabled':''}>Registrar pago de compra</button></div>`;}).join('')}`;\n if(view==='expenses')$('expenses').innerHTML=`<button class=\"btn\" data-operation=\"RECORD_EXPENSE\">Registrar gasto operativo</button><p class=\"cv-help\">Publicidad manual, administración, transporte general y otros. Los materiales y el procesamiento se registran desde compras o preparación. No vuelvas a registrar aquí el envío ya incluido en un pedido.</p>${snapshot.commerce.events.filter(e=>e.kind==='OPERATING_EXPENSE').map(e=>{const paid=(e.paid?e.amountCents:0)+snapshot.commerce.events.filter(p=>p.kind==='EXPENSE_PAYMENT'&&p.sourceOperationId===e.operationId).reduce((n,p)=>n+p.amountCents,0);return `<div class=\"card cv-card-gap\"><h3>${esc(e.category)} · ${money(e.amountCents)}</h3><p>${esc(e.description)} · ${esc(e.documentRef)} · ${paid>=e.amountCents?'Pagado':'Pendiente de pago'}</p><button class=\"btn small secondary\" data-expense-pay=\"${esc(e.operationId)}\" ${paid>=e.amountCents?'disabled':''}>Registrar pago pendiente</button>${e.category==='PUBLICIDAD'?`<p>${esc(e.campaign)} · ${e.messages} mensajes declarados; no equivalen a ventas.</p>`:''}</div>`;}).join('')}`;\n if(view==='customers'){$('customers').innerHTML=`<p class=\"cv-privacy\">Solo clientes ficticios del laboratorio. Teléfonos ocultos por defecto. La información no se envía a servicios de publicidad.</p><div class=\"cv-toolbar\"><label>Buscar cliente<input id=\"customer-search\"></label><button class=\"btn secondary\" data-reveal>${reveal?'Ocultar teléfonos':'Mostrar teléfonos ficticios'}</button></div><div id=\"customer-list\"></div>`;renderCustomers();}\n if(view==='reports')$('reports').innerHTML=`<form class=\"cv-toolbar\" id=\"report-filter\">${label('from','Desde','date',report?.from||today().slice(0,7)+'-01')}${label('to','Hasta','date',report?.to||today())}<button class=\"btn\">Consultar período</button><button class=\"btn secondary\" type=\"button\" data-period=\"day\">Hoy</button><button class=\"btn secondary\" type=\"button\" data-period=\"week\">Últimos 7 días</button><button class=\"btn secondary\" type=\"button\" data-period=\"month\">Este mes</button></form><div id=\"report-body\">${summary(report||r)}</div><p class=\"cv-help\">Resultados estimados por fecha de operación en Lima. Las cuentas por cobrar son el saldo actual, aunque filtres un período. Las compras de inventario no se restan otra vez del margen. No incluye impuestos, depreciación, Fondo ni integración automática de publicidad.</p><div class=\"card\"><h3>Productos despachados</h3>${Object.entries((report||r).topProducts).map(([p,n])=>`<p>${esc(p)} · ${n} bolsa(s) despachadas</p>`).join('')}</div>`;\n if(view==='config')$('config').innerHTML=`<button class=\"btn\" data-operation=\"CONFIGURE_OFFER\">Configurar oferta ficticia</button><p class=\"cv-help\">Los precios son exclusivamente de pruebas. Cambiar una oferta no recalcula pedidos confirmados. Las vigencias se validan con la fecha del servidor.</p>${Object.values(snapshot.commerce.offers).map(o=>`<div class=\"card cv-card-gap\"><h3>${esc(o.name)} · ${money(o.priceCents)}</h3><p>${esc(o.family)} · ${esc(o.grind)} · ${o.grams} g · ${o.bags} bolsa(s) por presentación</p><p>${esc(o.validFrom)} a ${esc(o.validUntil)} · versión ${o.version} · ${o.active?'Activa':'Inactiva'}</p><button class=\"btn secondary\" data-offer-edit=\"${esc(o.id)}\">Nueva versión de precio / vigencia</button></div>`).join('')}<div class=\"card\"><h3>Funciones originales conservadas como pendientes</h3><p>Fondo, conteos físicos autorizados, insumos adicionales y restauración de respaldos siguen fuera de esta integración. No se eliminó ni sustituyó la aplicación original.</p></div>`;\n for(const [id,value]of Object.entries(filterValues))if($(id))$(id).value=value;if(view==='orders'&&$('order-list'))$('order-list').innerHTML=orderTable();if(view==='customers'&&$('customer-list'))renderCustomers();if(view==='inventory'&&inventoryValues){for(const [key,value]of Object.entries(inventoryValues))$('inventory-filter').elements[key].value=value;$('inventory-rows').innerHTML=inventoryRows();}\n document.querySelectorAll('[data-preserve-key]').forEach(el=>el.open=openKeys.has(el.dataset.preserveKey));\n}\nfunction renderCustomers(){const q=($('customer-search')?.value||'').toLowerCase();$('customer-list').innerHTML=snapshot.reports.customers.filter(c=>`${c.name} ${c.phone}`.toLowerCase().includes(q)).map(c=>`<details class=\"card cv-card-gap\" data-preserve-key=\"customer-${esc(c.id)}\"><summary>${esc(c.name)} · ${c.purchaseCount>1?'Recurrente':'Sin repetición de compra despachada'} · ${c.orders.length} pedido(s)</summary><p>${reveal?esc(c.phone||'Sin teléfono'):c.phone?'•••••'+esc(c.phone.slice(-3)):'Sin teléfono'}</p><p>Importe neto de pedidos: ${money(c.totalCents)}. No equivale a dinero cobrado.</p>${c.orders.map(id=>{const s=snapshot.sales[id];return `<p>${esc(s.metadata.date)} · ${esc(statusName[s.status])} · ${money(s.totalCents+s.deliveryChargedCents)} · ${esc(s.metadata.note)}</p>`;}).join('')}</details>`).join('');}\nfunction openDialog(title,html,submit){$('dialog-title').textContent=title;$('dialog-body').innerHTML='<div class=\"form-grid\">'+html+'</div>';$('dialog-error').textContent='';modalSubmit=submit;$('dialog').showModal();}\nfunction operation(type,offerId){const unique=uuid(),saleId='future:'+unique,document=label('documentRef','Comprobante único de prueba','text','DEMO-'+unique.slice(0,8),'required');let html='';let submit;\n if(type==='CONFIGURE_OFFER'){const old=snapshot.c