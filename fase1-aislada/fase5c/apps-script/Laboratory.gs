/* Ensayos privados del editor. No hay identidades reales ni se habilita el proxy. */
function cv5cLabRun_(){
 cvOwner_();return cvLocked_(()=>{
 const base=invEngine_(),beforeJ=base.store.readJournal(),beforeE=base.store.readEffects(),props=PropertiesService.getScriptProperties();if(props.getProperty('PHASE5C_RACE_FIXTURE'))return {done:true,alreadyComplete:true};let checkpoint=JSON.parse(props.getProperty('PHASE5C_ACTIVE_RUN')||'null');if(!checkpoint){const started=beforeJ.filter(r=>r.kind==='PREPARED'&&r.command.operationId.startsWith('risk5c-')&&r.command.operationId.endsWith('-inventory-0')).slice(-1)[0];checkpoint=started?{run:started.command.operationId.slice(0,-12),now:started.command.date}:{run:'risk5c-'+Utilities.getUuid(),now:new Date().toISOString()};props.setProperty('PHASE5C_ACTIVE_RUN',JSON.stringify(checkpoint));}const now=checkpoint.now,run=checkpoint.run,invocationStarted=Date.now();let newCommands=0;const apply=(engine,c)=>{const old=engine.status(c.operationId),result=engine.execute(c);if(old.state!=='COMMITTED'){newCommands++;console.log(JSON.stringify({kind:'COMMAND_PROGRESS_5C',operationId:c.operationId,state:result.state,elapsedMs:Date.now()-invocationStarted}));if(newCommands>=2||Date.now()-invocationStarted>20000)throw Error('LAB_CONTINUE');}return result;};
 const bindings={'google:111111':{role:'administrator',active:true},'google:222222':{role:'sales',active:true},'google:333333':{role:'sales',active:true},'google:444444':{role:'inventory',active:true}};
 const policy={shippingByZone:{'Zona ficticia':{costCents:0,chargedCents:0}},preparationByGrams:{500:{processingPerBagCents:100}}};
 const engine=(subject,hook)=>new CVAccess.Engine(base.store,base.opening,hook,{actor:CVAccess.principal(subject,bindings),policy,now:()=>now});
 const admin=engine('google:111111'),sales=engine('google:222222'),other=engine('google:333333'),inventory=engine('google:444444'),checks=[];
 const check=(name,passed)=>{checks.push({name,passed:!!passed});if(!passed)throw Error('PHASE5C_FAILED')};
 const seed=CVCommercialScenario.commands(run,now).slice(0,11);for(const c of seed)apply(admin,c);
 const key=n=>'demo:'+run+'-'+n,command=(id,type,data={})=>({epoch:'TEST_ONLY_V3',schemaVersion:2,commercialVersion:4,operationId:run+'-'+id,deviceId:'lab-editor',saleId:'future:'+run+'-'+id,date:now,responsible:'Identidad declarada no confiable',type,...data});
 const prep=command('preparation','PREPARE_BAGS',{resourceId:key('bulk'),outputResourceId:key('one'),bagGrams:500,grind:'molido',bags:1,wasteGrams:0,materials:[{resourceId:key('bag500')},{resourceId:key('label')}]});apply(inventory,prep);check('Inventario prepara con receta sintética de servidor',inventory.state().resources[key('one')].physical===1);
 const sale=command('sale','REGISTER_SALE',{channel:'Otro',customer:{name:'DEMO 5C',zone:'Zona ficticia'},items:[{offerId:key('single'),offerVersion:1,resourceId:key('one'),quantity:1}]});const ack=apply(sales,sale);check('Vendedor registra con precio y costo de servidor',ack.state==='COMMITTED');check('Reintento devuelve confirmación original',CVInventory.canonical(sales.execute(sale))===CVInventory.canonical(ack));
 try{other.execute({...sale,operationId:run+'-other',saleId:'future:'+run+'-other'});check('Última bolsa rechaza segunda reserva',false)}catch(e){check('Última bolsa rechaza segunda reserva',e.message==='INSUFFICIENT_STOCK')}
 try{other.status(sale.operationId);check('No consultar operación ajena',false)}catch(e){check('No consultar operación ajena',e.message==='ACCESS_DENIED')}
 const dto=CVAccess.snapshot(sales);check('Respuesta de vendedor no incluye costos/diario/utilidades',!/("costCents"|"valueCents"|"profitCents"|"commerce"|"totalCostCents")/.test(JSON.stringify(dto)));check('Inventario no recibe contactos',CVAccess.snapshot(inventory).sales.length===0);
 try{sales.execute(command('forbidden','CONFIGURE_OFFER'));check('Vendedor no configura precios',false)}catch(e){check('Vendedor no configura precios',e.message==='PERMISSION_DENIED')}
 try{sales.execute({...sale,operationId:run+'-spoof',role:'administrator'});check('No elevar perfil desde navegador',false)}catch(e){check('No elevar perfil desde navegador',e.message==='IDENTITY_SPOOFING')}
 apply(sales,command('cancel','CANCEL_SALE',{saleId:sale.saleId,expectedSaleVersion:1,reason:'Fin de ensayo ficticio'}));
 const retry=command('partial','REGISTER_SALE',{...sale,operationId:run+'-partial',saleId:'future:'+run+'-partial'});let injected=false;if(sales.status(retry.operationId).state==='UNKNOWN'){try{engine('google:222222',point=>{if(point==='afterEffect'&&!injected){injected=true;throw Error('INJECTED')}}).execute(retry)}catch(e){if(e.message!=='INJECTED')throw e}}
 check('Fallo parcial conserva plan recuperable', ['PREPARED','COMMITTED'].includes(sales.status(retry.operationId).state));apply(sales,retry);sales.execute(retry);check('Recuperación no duplica reserva',sales.state().resources[key('one')].reserved===(sales.status(run+'-cancel-partial').state==='COMMITTED'?0:1));
 const p=base.store.readJournal().find(r=>r.id===retry.operationId&&r.kind==='PREPARED');check('Actor y hora de servidor persistidos',p.plan.audit.subject==='google:222222'&&p.plan.audit.serverAt===now&&p.plan.effects.every(e=>e.responsible==='google:222222'));
 sales.execute(command('cancel-partial','CANCEL_SALE',{saleId:retry.saleId,expectedSaleVersion:1,reason:'Cierre de ensayo ficticio'}));
 const prefix=(a,b)=>CVInventory.canonical(a)===CVInventory.canonical(b.slice(0,a.length));check('Diarios anteriores intactos',prefix(beforeJ,base.store.readJournal())&&prefix(beforeE,base.store.readEffects()));
 PropertiesService.getScriptProperties().setProperty('PHASE5C_RACE_FIXTURE',JSON.stringify({run,resourceId:key('one'),offerId:key('single'),date:now}));
 const report={id:run,kind:'ACCESS_5C',passed:true,checks,revision:admin.state().revision,identityProvider:'SYNTHETIC_ONLY',realGoogleSignInTested:false};invAppend_(cvBook_(),'VerificacionesInventarioV3',report);console.log(JSON.stringify(report));return report;
 });
}
function cv5cPerformance_(){cvOwner_();return cvLocked_(()=>{
 const samples=[];for(let i=0;i<20;i++){const start=Date.now(),e=cv5cEngine_({subject:'native:sandbox-owner',role:'administrator'}),loaded=Date.now(),s=e.state(),replayed=Date.now();e.reports(s);const reported=Date.now();samples.push({loadMs:loaded-start,replayMs:replayed-loaded,reportsMs:reported-replayed,totalMs:reported-start,revision:s.revision});}
 const total=samples.map(x=>x.totalMs).sort((a,b)=>a-b);const r={id:'perf5c-'+Utilities.getUuid(),kind:'PERFORMANCE_5C',environment:'TEST_ONLY',passed:true,n:samples.length,meanMs:samples.reduce((n,x)=>n+x.totalMs,0)/samples.length,p50Ms:total[9],p95Ms:total[18],maxMs:total[19],samples,includesNetwork:false,includesLockWait:false};invAppend_(cvBook_(),'VerificacionesInventarioV3',r);console.log(JSON.stringify(r));return r;
 });}
function cv5cCompleteBackup_(){cvOwner_();return cvLocked_(()=>{
 const started=Date.now(),source=cvBook_(),targetId=PropertiesService.getScriptProperties().getProperty('PHASE5B_RESTORE_SHEET_ID');if(targetId!=='1zB8s5MZN-LGMpnHL3RkOvA802WVfPOPEkRgXmygNk0o')throw Error('RESTORE_DESTINATION');
 const target=SpreadsheetApp.openById(targetId);if(target.getName()!=='CasaVieja_RECUPERACION_TEST_ONLY_5B'||target.getSheetByName('Control').getRange('B3').getValue()!=='TEST_ONLY'||targetId===source.getId())throw Error('RESTORE_DESTINATION');
 const names=['Control','RecursosDemo','AperturaV2','DiarioV2','EfectosV2','VerificacionesV2','DiarioInventarioV3','MovimientosInventarioV3','VerificacionesInventarioV3','Operaciones'],tables={};for(const name of names){const sh=source.getSheetByName(name);if(!sh)throw Error('MISSING_BACKUP_TAB');const n=sh.getLastRow(),cols=sh.getLastColumn();if(n>20000||cols>64)throw Error('BACKUP_LIMIT_REQUIRES_PAGING');tables[name]=n?sh.getRange(1,1,n,cols).getValues():[];}
 const hash=s=>Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,s,Utilities.Charset.UTF_8).map(b=>(b<0?b+256:b).toString(16).padStart(2,'0')).join('');
 const files=CV5C_ARTIFACTS_,payload={format:'CV_COMPLETE_5C',environment:'TEST_ONLY',createdAt:new Date().toISOString(),tables,config:{environment:'TEST_ONLY',sheetId:source.getId(),scriptId:ScriptApp.getScriptId(),authMode:PropertiesService.getScriptProperties().getProperty('PHASE5C_AUTH_MODE')||'DISABLED',roleBindings:JSON.parse(PropertiesService.getScriptProperties().getProperty('PHASE5C_ROLE_BINDINGS')||'{}'),approvedPolicy:cv5cPolicy_(),rolePolicy:CVAccess.roles,secretsExcluded:true},clients:CV5C_CLIENT_EXPORTS_,release:{files,sha256:hash(CVInventory.canonical(files.map(({path,sha256})=>({path,sha256}))))}};
 const archive={payload,sha256:hash(CVInventory.canonical(payload))},raw=JSON.stringify(archive),encoded=Utilities.base64Encode(Utilities.gzip(Utilities.newBlob(raw,'application/json','backup5c.json')).getBytes()),chunks=[];for(let start=0;start<encoded.length;start+=30000)chunks.push(encoded.slice(start,start+30000));
 const restorationStarted=Date.now();
 const id='complete5c-'+Utilities.getUuid(),sh=target.getSheetByName('Control'),row=sh.getLastRow()+1,records=chunks.map((data,index)=>[id+':'+index,'COMPLETE_BACKUP_5C',JSON.stringify({archiveId:id,index,total:chunks.length,data})]);sh.getRange(row,4,records.length,3).setValues(records);SpreadsheetApp.flush();
 const read=sh.getRange(row,4,records.length,3).getValues().map(r=>JSON.parse(r[2])).sort((a,b)=>a.index-b.index).map(r=>r.data).join('');const restored=JSON.parse(Utilities.ungzip(Utilities.newBlob(Utilities.base64Decode(read),'application/gzip','backup5c.json.gz')).getDataAsString('UTF-8'));if(hash(CVInventory.canonical(restored.payload))!==archive.sha256)throw Error('RESTORE_READBACK');
 const state=(j,e)=>new CVCommercial.Engine({readJournal:()=>j,readEffects:()=>e}).state(),parse=name=>tables[name].slice(1).map(r=>JSON.parse(r[2])),current=state(parse('DiarioInventarioV3'),parse('MovimientosInventarioV3')),restoredParse=name=>restored.payload.tables[name].slice(1).map(r=>JSON.parse(r[2])),recovered=state(restoredParse('DiarioInventarioV3'),restoredParse('MovimientosInventarioV3'));
 if(CVInventory.canonical(current)!==CVInventory.canonical(recovered))throw Error('RESTORE_STATE_MISMATCH');
 for(const name of ['DiarioInventarioV3','MovimientosInventarioV3']){const from=parse(name),dest=target.getSheetByName(name),old=invRead_(target,name);if(old.length>from.length||old.some((r,i)=>CVInventory.canonical(r)!==CVInventory.canonical(from[i])))throw Error('RESTORE_NONEMPTY_CONFLICT');if(old.length<from.length)dest.getRange(old.length+2,1,from.length-old.length,3).setValues(from.slice(old.length).map(r=>[r.id,r.kind,JSON.stringify(r)]));}
 SpreadsheetApp.flush();if(CVInventory.canonical(current)!==CVInventory.canonical(state(invRead_(target,'DiarioInventarioV3'),invRead_(target,'MovimientosInventarioV3'))))throw Error('RESTORE_STATE_MISMATCH');
 for(const name of ['AperturaV2','DiarioV2','EfectosV2','DiarioInventarioV3','MovimientosInventarioV3']){const sheet=source.getSheetByName(name),fresh=sheet.getLastRow()?sheet.getRange(1,1,sheet.getLastRow(),sheet.getLastColumn()).getValues():[];if(CVInventory.canonical(fresh)!==CVInventory.canonical(tables[name]))throw Error('SOURCE_CHANGED');}
 const report={id,kind:'COMPLETE_RESTORE_5C',passed:true,targetId,range:'Control!D'+row+':F'+(row+records.length-1),sha256:archive.sha256,release:payload.release.sha256,revision:recovered.revision,tableNames:names,compressedBytes:encoded.length,uncompressedChars:raw.length,elapsedMs:Date.now()-started,backupMs:restorationStarted-started,restoreVerificationMs:Date.now()-restorationStarted,sourceUnchanged:true,deviceQueuesIncluded:payload.clients.states.length>0,deviceScope:payload.clients.scope,secretsIncluded:false,commercialActivation:false};invAppend_(source,'VerificacionesInventarioV3',report);console.log(JSON.stringify(report));return report;
 });}
function sandboxExecute(command){if(command!==undefined)return sandboxExecutePhase5B_(command);try{if(!PropertiesService.getScriptProperties().getProperty('PHASE5C_RACE_FIXTURE'))cv5cLabRun_();}catch(e){if(e.message==='LAB_CONTINUE'){const progress={kind:'LAB_PROGRESS_5C',done:false,checkpointSaved:true};console.log(JSON.stringify(progress));return progress;}throw e;}cv5cPerformance_();return cv5cCompleteBackup_();}
