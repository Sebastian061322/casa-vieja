// Exclusivamente el /dev privado de laboratorio. Identidades fijas ficticias, no cuentas activadas.
function cv5cRaceEngine_(subject){const base=invEngine_();return new CVAccess.Engine(base.store,base.opening,undefined,{actor:{subject,role:'sales'},policy:{shippingByZone:{'Zona ficticia':{costCents:0,chargedCents:0}}},now:()=>new Date().toISOString()});}
function lab5cRace(slot){const started=Date.now();try{cvOwner_();if(![1,2,3].includes(slot))throw Error('INVALID_SLOT');return cvLocked_(()=>{const entered=Date.now(),fixture=JSON.parse(PropertiesService.getScriptProperties().getProperty('PHASE5C_RACE_FIXTURE')||'null');if(!fixture)throw Error('SETUP_REQUIRED');const subject=['google:222222','google:333333','google:555555'][slot-1],engine=cv5cRaceEngine_(subject),c={epoch:'TEST_ONLY_V3',schemaVersion:2,commercialVersion:4,operationId:fixture.run+'-race-'+slot,deviceId:'synthetic-browser-'+slot,saleId:'future:'+fixture.run+'-race-'+slot,date:fixture.date,responsible:'Ficticio',type:'REGISTER_SALE',channel:'Otro',customer:{name:'DEMO race '+slot,zone:'Zona ficticia'},items:[{offerId:fixture.offerId,offerVersion:1,resourceId:fixture.resourceId,quantity:1}]};let result;try{result=engine.execute(c)}catch(e){result=engine.status(c.operationId);if(result.state!=='REJECTED')throw e}return {slot,subject,result,lockWaitMs:entered-started,processingMs:Date.now()-entered,totalMs:Date.now()-started,identityProvider:'SYNTHETIC_ONLY'};});}catch(e){return cv5cError_(e);}}
function lab5cRaceCleanup(){cvOwner_();return cvLocked_(()=>{const fixture=JSON.parse(PropertiesService.getScriptProperties().getProperty('PHASE5C_RACE_FIXTURE')||'null');if(!fixture)throw Error('SETUP_REQUIRED');const base=invEngine_(),admin=new CVAccess.Engine(base.store,base.opening,undefined,{actor:{subject:'google:111111',role:'administrator'},now:()=>new Date().toISOString()}),states=[1,2,3].map(slot=>admin.status(fixture.run+'-race-'+slot));if(states.filter(s=>s.state==='COMMITTED').length!==1||states.filter(s=>s.state==='REJECTED').length!==2)throw Error('RACE_FAILED');const winner=states.find(s=>s.state==='COMMITTED'),sale=admin.state().sales[winner.saleId];if(sale.status==='RESERVED')admin.execute({epoch:'TEST_ONLY_V3',schemaVersion:2,commercialVersion:4,operationId:fixture.run+'-race-cleanup',deviceId:'synthetic-browser-cleanup',saleId:sale.id,date:fixture.date,responsible:'Ficticio',type:'CANCEL_SALE',expectedSaleVersion:sale.version,reason:'Cierre de prueba simultánea ficticia'});const state=admin.state(),resource=state.resources[fixture.resourceId];if(resource.physical!==1||resource.reserved!==0||resource.qty!==1)throw Error('RACE_STOCK_FAILED');const report={id:fixture.run+'-race-report',kind:'RACE_5C',passed:true,confirmed:1,rejected:2,physical:1,reserved:0,available:1,revision:state.revision,realGoogleAccountsTested:false};invAppend_(cvBook_(),'VerificacionesInventarioV3',report);return report;});}
function doGet(event){cvOwner_();if(event?.parameter?.phase5c==='review'){let html=CV5C_CANDIDATE_HTML_;if(event.parameter.fixture==='1')html=html.replaceAll('CVContinuity.browserAdapter(indexedDB,location.origin)',"Object.assign(CVContinuity.browserAdapter(indexedDB,location.origin),{otherOriginsConfirmed:true})").replace('<body>','<body><p role="note">LABORATORIO SINTÉTICO · acta ficticia para pruebas del propietario · no habilita transición</p>');return HtmlService.createHtmlOutput(html).setTitle('Casa Vieja · Revisión privada 5C');}if(event?.parameter?.phase5c==='race')return HtmlService.createHtmlOutput(CV5C_PROBE_HTML_).setTitle('Casa Vieja · Ensayo privado 5C');return HtmlService.createHtmlOutput(COMMERCIAL_HTML_).setTitle('Casa Vieja · Laboratorio comercial');}
