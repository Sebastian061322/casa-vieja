// PRIVADO, TEST_ONLY. No se incorpora al candidato comercial.
function cvOpHash_(x){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,x,Utilities.Charset.UTF_8).map(b=>(b<0?b+256:b).toString(16).padStart(2,'0')).join('');}
function cvOpProps_(){cvOwner_();cvBook_();return PropertiesService.getScriptProperties();}
function cvOpStore_(props){const read=kind=>{const rows=[];for(let i=0;i<100;i++){const raw=props.getProperty('OP5C_R1_'+kind+i);if(!raw)return rows;rows.push(JSON.parse(raw));}throw Error('LAB_LEDGER_LIMIT');};const append=(kind,row)=>{const rows=read(kind),key='OP5C_R1_'+kind+rows.length,raw=JSON.stringify(row);if(raw.length>7500)throw Error('LAB_RECORD_LIMIT');props.setProperty(key,raw);if(props.getProperty(key)!==raw)throw Error('LAB_RECORD_NOT_DURABLE');};return {readJournal:()=>read('J'),readEffects:()=>read('E'),appendJournal:r=>append('J',r),appendEffect:r=>append('E',r)};}
function cvOpBackup_(archive){
 const book=cvBook_(),props=PropertiesService.getScriptProperties(),targetId=props.getProperty('PHASE5B_RESTORE_SHEET_ID');if(targetId!=='1zB8s5MZN-LGMpnHL3RkOvA802WVfPOPEkRgXmygNk0o')throw Error('RESTORE_DESTINATION');const target=SpreadsheetApp.openById(targetId),control=target.getSheetByName('Control');if(target.getName()!=='CasaVieja_RECUPERACION_TEST_ONLY_5B'||control.getRange('B3').getValue()!=='TEST_ONLY')throw Error('RESTORE_DESTINATION');
 const id=archive.payload.run+'-'+archive.payload.label+'-'+CV5C_RELEASE_.slice(0,12),existing=invRead_(book,'VerificacionesInventarioV3').find(r=>r.id===id&&r.kind==='OPERATIONAL_BACKUP_5C');if(existing)return {id,range:existing.range,sha256:existing.sha256,restored:true};
 const started=Date.now(),canonical=CVInventoryBase.canonical;if(CV5C_ARTIFACTS_.some(f=>cvOpHash_(f.content)!==f.sha256)||cvOpHash_(canonical(CV5C_ARTIFACTS_.map(({path,sha256})=>({path,sha256}))))!==CV5C_RELEASE_)throw Error('SOURCE_HASH');archive.payload.backendFiles=CV5C_ARTIFACTS_;archive.payload.configuration={environment:'TEST_ONLY',release:CV5C_RELEASE_,authenticationEnabled:false,roles:CVAccess.roles,productionEnabled:false};archive.sha256=cvOpHash_(canonical(archive.payload));const text=JSON.stringify(archive),encoded=Utilities.base64Encode(Utilities.gzip(Utilities.newBlob(text,'application/json','operational.json')).getBytes()),chunks=[];for(let i=0;i<encoded.length;i+=30000)chunks.push(encoded.slice(i,i+30000));const first=control.getLastRow()+1;control.getRange(first,4,chunks.length,3).setValues(chunks.map((data,i)=>[id+':'+i,'OPERATIONAL_ARCHIVE',JSON.stringify({id,index:i,total:chunks.length,data})]));SpreadsheetApp.flush();const parts=control.getRange(first,4,chunks.length,3).getValues().map(r=>JSON.parse(r[2])).sort((a,b)=>a.index-b.index);const read=JSON.parse(Utilities.ungzip(Utilities.newBlob(Utilities.base64Decode(parts.map(x=>x.data).join('')),'application/gzip','operational.json.gz')).getDataAsString('UTF-8'));if(cvOpHash_(canonical(read.payload))!==archive.sha256)throw Error('ARCHIVE_CHECKSUM');
 const restore=data=>new CVCommercial.Engine({readJournal:()=>data.journal,readEffects:()=>data.effects}).state();for(const name of ['old','next']){const original=restore(archive.payload[name]),restored=restore(read.payload[name]);if(canonical(original)!==canonical(restored))throw Error('RESTORE_MISMATCH');if(canonical(restored)!==canonical(restore(read.payload[name])))throw Error('RESTORE_NOT_IDEMPOTENT');}
 // Materializar solo el sufijo verificado del diario NUEVO en el destino sintético existente.
 for(const [name,from]of [['DiarioInventarioV3',read.payload.next.journal],['MovimientosInventarioV3',read.payload.next.effects]]){const old=invRead_(target,name);if(old.slice(0,Math.min(old.length,from.length)).some((r,i)=>canonical(r)!==canonical(from[i])))throw Error('RESTORE_PREFIX_CONFLICT');if(old.length<from.length)target.getSheetByName(name).getRange(old.length+2,1,from.length-old.length,3).setValues(from.slice(old.length).map(r=>[r.id,r.kind,JSON.stringify(r)]));}
 SpreadsheetApp.flush();const materialized=restore({journal:invRead_(target,'DiarioInventarioV3'),effects:invRead_(target,'MovimientosInventarioV3')});const archivedState=restore(read.payload.next),materializedPrefix=restore({journal:invRead_(target,'DiarioInventarioV3').slice(0,read.payload.next.journal.length),effects:invRead_(target,'MovimientosInventarioV3').slice(0,read.payload.next.effects.length)});if(canonical(materializedPrefix)!==canonical(archivedState))throw Error('RESTORE_MISMATCH');
 const current=invEngine_();if(canonical(current.store.readJournal().slice(0,archive.payload.next.journal.length))!==canonical(archive.payload.next.journal)||canonical(current.store.readEffects().slice(0,archive.payload.next.effects.length))!==canonical(archive.payload.next.effects))throw Error('SOURCE_CHANGED');
 const report={id,kind:'OPERATIONAL_BACKUP_5C',environment:'TEST_ONLY',passed:true,range:'Control!D'+first+':F'+(first+chunks.length-1),sha256:archive.sha256,release:CV5C_RELEASE_,elapsedMs:Date.now()-started,oldJournalRows:read.payload.old.journal.length,newJournalRows:read.payload.next.journal.length,newEffects:read.payload.next.effects.length,oldAndNewReconstructed:true,repeatedRestoreUnchanged:true,newJournalMaterialized:true,sourceUnchanged:true,pendingIncluded:read.payload.old.journal.some(p=>p.kind==='PREPARED'&&!read.payload.old.journal.some(c=>c.id===p.id&&c.kind==='COMMITTED'))};invAppend_(book,'VerificacionesInventarioV3',report);return {id,range:report.range,sha256:report.sha256,restored:true};
}
function cvOpRunner_(props){const base=invEngine_();return new CVRehearsal.Runner({environment:'TEST_ONLY',release:CV5C_RELEASE_,hash:cvOpHash_,old:cvOpStore_(props),next:base.store,meta:{read:()=>JSON.parse(props.getProperty('OP5C_R1_META')||'null'),write:m=>{const raw=JSON.stringify(m);if(raw.length>7500)throw Error('LAB_METADATA_LIMIT');props.setProperty('OP5C_R1_META',raw);if(props.getProperty('OP5C_R1_META')!==raw)throw Error('CHECKPOINT_NOT_DURABLE');}},backup:cvOpBackup_});}
function operationalNext(){cvOwner_();return cvLocked_(()=>{const props=cvOpProps_(),runner=cvOpRunner_(props);if(!runner.metadata())runner.initialize('drill5c-'+Utilities.getUuid(),new Date().toISOString());let m;const started=Date.now();for(let i=0;i<2;i++){m=runner.step();if(m.done||Date.now()-started>20000)break;}if(m.done&&!invRead_(cvBook_(),'VerificacionesInventarioV3').some(r=>r.id===m.run&&r.kind==='OPERATIONAL_DRILL_5C')){invAppend_(cvBook_(),'VerificacionesInventarioV3',{id:m.run,kind:'OPERATIONAL_DRILL_5C',...m,realDevicesTested:false,realUsersTested:false,productionTouched:false});}console.log(JSON.stringify({kind:'OPERATIONAL_PROGRESS',step:m.step,done:!!m.done,run:m.run,passed:!!m.passed,checks:m.checks,balances:m.balances}));return m;});}
function operationalState(){cvOwner_();return cvLocked_(()=>cvOpRunner_(cvOpProps_()).metadata());}
function sandboxExecute(command){if(command!==undefined)return sandboxExecute5c_(command);const state=operationalState();return state?.done?operationalRebackup():operationalNext();}
function doGet(event){cvOwner_();if(event?.parameter?.phase5c==='operational')return HtmlService.createHtmlOutput(CVOP_HTML_).setTitle('Casa Vieja · Simulacro privado');return doGet5c_(event);}

// Reparar únicamente los respaldos del ensayo ya terminado; nunca repetir operaciones comerciales.
function operationalRebackup(){cvOwner_();return cvLocked_(()=>{const props=cvOpProps_(),runner=cvOpRunner_(props),m=runner.metadata();if(!m?.done||!m.oldClosed||!m.newHalted)throw Error('DRILL_NOT_COMPLETE');const range=m.beforeBackup.range.match(/^Control!D(\d+):F(\d+)$/);if(!range)throw Error('ARCHIVE_RANGE');const target=SpreadsheetApp.openById('1zB8s5MZN-LGMpnHL3RkOvA802WVfPOPEkRgXmygNk0o'),chunks=target.getSheetByName('Control').getRange(Number(range[1]),4,Number(range[2])-Number(range[1])+1,3).getValues().map(r=>JSON.parse(r[2])).sort((a,b)=>a.index-b.index);const original=JSON.parse(Utilities.ungzip(Utilities.newBlob(Utilities.base64Decode(chunks.map(x=>x.data).join('')),'application/gzip','before.json.gz')).getDataAsString('UTF-8'));if(original.sha256!==m.beforeBackup.sha256||cvOpHash_(CVInventoryBase.canonical(original.payload))!==original.sha256)throw Error('ORIGINAL_ARCHIVE_HASH');original.payload.originalCapture={sha256:original.sha256,release:original.payload.release,note:'Datos originales; empaquetado de fuentes corregido sin repetir ventas'};original.payload.label='BEFORE_PENDING_RECOVERY_VERIFIED';original.payload.release=CV5C_RELEASE_;const before=cvOpBackup_(original);const base=invEngine_(),after=cvOpBackup_({payload:{environment:'TEST_ONLY',run:m.run,label:'AFTER_HALT_VERIFIED',meta:m,policy:CVRehearsal.policy,old:{journal:cvOpStore_(props).readJournal(),effects:cvOpStore_(props).readEffects()},next:{journal:base.store.readJournal(),effects:base.store.readEffects()},release:CV5C_RELEASE_}});m.correctedBackups={before,after,release:CV5C_RELEASE_};runner.io.meta.write(m);const id=m.run+'-archive-repair-'+CV5C_RELEASE_.slice(0,12);if(!invRead_(cvBook_(),'VerificacionesInventarioV3').some(r=>r.id===id))invAppend_(cvBook_(),'VerificacionesInventarioV3',{id,kind:'OPERATIONAL_ARCHIVE_REPAIR_5C',passed:true,run:m.run,backups:m.correctedBackups,businessOperationsRepeated:false,failedSourceBundlesRetained:true});return m.correctedBackups;});}
