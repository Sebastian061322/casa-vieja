/* Candidato S/0, apagado. Nunca pegar en Apps Script productivo. */
function zeroProof_(envelope,config){const cfg=config||{enabled:PropertiesService.getScriptProperties().getProperty('ZERO_LAB_ENABLED')==='YES',secret:PropertiesService.getScriptProperties().getProperty('ZERO_GATEWAY_SECRET'),now:Date.now()};if(!cfg.enabled||typeof cfg.secret!=='string'||cfg.secret.length<43||JSON.stringify(envelope||{}).length>32000)throw Error('IDENTITY_REQUIRED');const r=envelope?.request;if(!r||typeof envelope.mac!=='string')throw Error('IDENTITY_REQUIRED');const expected=Utilities.base64Encode(Utilities.computeHmacSha256Signature(CVInventoryBase.canonical(r),cfg.secret,Utilities.Charset.UTF_8));let different=expected.length^envelope.mac.length;for(let i=0;i<expected.length;i++)different|=expected.charCodeAt(i)^(envelope.mac.charCodeAt(i)||0);if(different)throw Error('IDENTITY_REQUIRED');if(r.version!==2||r.destination!=='TEST_ONLY_ZERO_1'||!Number.isSafeInteger(r.issuedAt)||!Number.isSafeInteger(r.expiresAt)||r.issuedAt>cfg.now+30000||r.expiresAt<=cfg.now||r.expiresAt-r.issuedAt>30000||!/^google:[0-9]{5,64}$/.test(r.subject)||typeof r.requestId!=='string'||r.requestId.length>120)throw Error('IDENTITY_REQUIRED');return r;}
function zeroPropertyLog_(prefix){const p=PropertiesService.getScriptProperties();const read=()=>{const rows=[];for(let i=0;i<200;i++){const raw=p.getProperty(prefix+i);if(!raw)return rows;rows.push(JSON.parse(raw));}throw Error('LAB_ADMIN_LOG_FULL');};return {read,append:r=>{const rows=read(),raw=JSON.stringify(r);if(raw.length>7500||rows.length>=199)throw Error('LAB_ADMIN_LOG_FULL');const key=prefix+rows.length;p.setProperty(key,raw);if(p.getProperty(key)!==raw)throw Error('ADMIN_EVENT_NOT_DURABLE');}};}
function zeroRequest(envelope){try{const verified=zeroProof_(envelope);return cvLocked_(()=>{const p=PropertiesService.getScriptProperties(),approved=p.getProperty('ZERO_APPROVED_SCRIPT_ID');if(!approved||ScriptApp.getScriptId()!==approved)throw Error('APPROVED_LAB_REQUIRED');const service=new CVZeroAccess.Service({environment:'TEST_ONLY',verify:()=>verified,lock:fn=>fn(),users:zeroPropertyLog_('ZERO_USER_'),policies:zeroPropertyLog_('ZERO_POLICY_'),now:()=>new Date().toISOString(),store:()=>invEngine_().store});return service.handle(envelope);});}catch(e){return {error:/^[A-Z_]+$/.test(e.message)?e.message:'SERVER_UNAVAILABLE',retryable:!['INSUFFICIENT_STOCK','PERMISSION_DENIED','FINANCIAL_FIELDS_FORBIDDEN','IDENTITY_SPOOFING','IDEMPOTENCY_CONFLICT','INVALID_ITEMS'].includes(e.message)};}}
function doPost(event){try{return ContentService.createTextOutput(JSON.stringify(zeroRequest(JSON.parse(event.postData.contents)))).setMimeType(ContentService.MimeType.JSON)}catch(e){return ContentService.createTextOutput(JSON.stringify({error:'IDENTITY_REQUIRED',retryable:true})).setMimeType(ContentService.MimeType.JSON)}}
function doGet(){return ContentService.createTextOutput(JSON.stringify({environment:'TEST_ONLY',status:'AUTHENTICATED_POST_REQUIRED'})).setMimeType(ContentService.MimeType.JSON);}
